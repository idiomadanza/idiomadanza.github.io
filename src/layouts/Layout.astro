---
import { ClientRouter } from 'astro:transitions';
import { Image } from 'astro:assets';
import '../styles/global.css';
import CookieBanner from '../components/CookieBanner.astro';
import SafeMail from '../components/ui/SafeMail.astro';
import logoImg from '../assets/images/logo.png';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
}

const { 
  title, 
  description = "Idiomadanza e.V. – High-End Dance-Education meets Community Spirit. Bachata und Salsa Tanzkurse in Regensburg.",
  canonical,
  ogImage = "/images/og-default.png"
} = Astro.props;

const siteUrl = "https://idiomadanza.de";
const canonicalUrl = canonical ? `${siteUrl}${canonical}` : `${siteUrl}${Astro.url.pathname}`;

// Breadcrumb-Logik
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbLabels: Record<string, string> = {
  'kurse': 'Tanzkurse',
  'workshops': 'Workshops',
  'ueber-uns': 'Über Uns',
  'mitglied-werden': 'Mitgliedschaft',
  'kontakt': 'Kontakt',
  'blog': 'Journal'
};

const autoBreadcrumb = pathSegments.map((seg, index) => ({
  name: breadcrumbLabels[seg] || seg,
  url: '/' + pathSegments.slice(0, index + 1).join('/')
}));

const breadcrumbSchema = autoBreadcrumb.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Startseite", "item": siteUrl },
    ...autoBreadcrumb.map((item, idx) => ({
      "@type": "ListItem",
      "position": idx + 2,
      "name": item.name,
      "item": `${siteUrl}${item.url}`
    }))
  ]
} : null;

const danceSchoolSchema = {
  "@context": "https://schema.org",
  "@type": "DanceSchool",
  "name": "Idiomadanza e.V.",
  "description": "Bachata & Salsa Tanzverein in Regensburg. High-End Dance-Education meets Community Spirit.",
  "url": "https://idiomadanza.de",
  "logo": "https://idiomadanza.de/favicon.png",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Isarstr. 85",
    "addressLocality": "Regensburg",
    "postalCode": "93057",
    "addressCountry": "DE"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 49.0245,
    "longitude": 12.1158
  },
  "telephone": "+4915678659226",
  "openingHours": "Tu 18:00-21:00, We 18:00-21:00",
  "sameAs": [
    "https://instagram.com/idiomadanza",
    "https://facebook.com/idiomadanza"
  ]
};
---

<!DOCTYPE html>
<html lang="de" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#020617" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    
    <!-- Speculation Rules: Prefetch wahrscheinlich nächste Seiten für schnellere Navigation -->
    <script type="speculationrules">
      {
        "prefetch": [
          {
            "where": { "and": [
              { "href_matches": "/kurse" },
              { "not": { "selector_matches": "[rel~=nofollow]" } }
            ] },
            "eagerness": "moderate"
          },
          {
            "where": { "href_matches": "/kontakt" },
            "eagerness": "moderate"
          }
        ]
      }
    </script>

    <!-- Critical Font Preloading -->
    <link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/golos-text-v7-latin_latin-ext-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/playfair-400.woff2" as="font" type="font/woff2" crossorigin />

    <ClientRouter />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, siteUrl)} />
    <meta property="og:site_name" content="Idiomadanza e.V." />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(ogImage, siteUrl)} />

    <script type="application/ld+json" set:html={JSON.stringify(danceSchoolSchema)} />
    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
    <slot name="head" />
  </head>
  <body class="font-sans min-h-screen flex flex-col bg-brand-light dark:bg-brand-dark text-brand-dark dark:text-white">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-brand-rose focus:text-white focus:rounded-lg focus:shadow-glow-rose focus:outline-none focus:ring-2 focus:ring-brand-glow">
      Zum Hauptinhalt springen
    </a>
    <header class="sticky top-0 z-50 w-full backdrop-blur-md bg-white/70 dark:bg-brand-dark/80 border-b border-white/10">
      <nav class="container mx-auto px-4 py-4 flex justify-between items-center">
        <a href="/" class="flex items-center gap-4 group">
          <div class="relative w-12 h-12 rounded-full overflow-hidden border-2 border-brand-glow/60 shadow-glow-amber animate-pulse-glow transition-transform duration-300 group-hover:scale-105">
            <Image src={logoImg} alt="Logo" width={48} height={48} class="p-1" decoding="async" loading="eager" fetchpriority="high" />
          </div>
          <span class="text-2xl font-display font-bold text-brand-rose drop-shadow-[0_0_10px_rgba(139,92,246,0.3)]">Idiomadanza</span>
        </a>
        <div class="hidden md:flex gap-8 items-center font-medium">
          <a href="/kurse" class="hover:text-brand-rose transition-colors">Kurse</a>
          <a href="/workshops" class="hover:text-brand-rose transition-colors">Workshops</a>
          <a href="/ueber-uns" class="hover:text-brand-rose transition-colors">Über Uns</a>
          <a href="/mitglied-werden" class="hover:text-brand-rose transition-colors">Mitgliedschaft</a>
          <a href="/blog" class="hover:text-brand-rose transition-colors">Journal</a>
          <a href="/kontakt" class="bg-brand-rose px-6 py-2 rounded-full text-white shadow-glow-rose hover:-translate-y-0.5 transition-all">Probestunde</a>
        </div>

        <!-- Mobile Menu Button -->
        <button id="menu-toggle" class="md:hidden p-3 min-w-[44px] min-h-[44px] text-brand-rose focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-rose rounded group/menu" aria-label="Menü öffnen" aria-expanded="false" aria-controls="mobile-menu">
          <div class="relative w-8 h-6 flex flex-col justify-between">
            <span class="w-8 h-1 bg-brand-rose rounded-full transition-all duration-300 group-hover/menu:bg-brand-glow shadow-[0_0_8px_rgba(139,92,246,0.5)] animate-pulse-glow"></span>
            <span class="w-6 h-1 bg-brand-rose rounded-full ml-auto transition-all duration-300 group-hover/menu:bg-brand-glow shadow-[0_0_8px_rgba(139,92,246,0.5)] animate-pulse-glow"></span>
            <span class="w-8 h-1 bg-brand-rose rounded-full transition-all duration-300 group-hover/menu:bg-brand-glow shadow-[0_0_8px_rgba(139,92,246,0.5)] animate-pulse-glow"></span>
          </div>
        </button>
      </nav>
    </header>

    <!-- Mobile Menu Overlay -->
    <div id="mobile-menu" class="fixed inset-0 z-[60] bg-brand-dark/95 backdrop-blur-xl translate-x-full transition-transform duration-500 md:hidden flex flex-col items-center justify-center gap-10 text-3xl font-display">
      <button id="menu-close" class="absolute top-6 right-6 p-4 text-brand-rose hover:text-brand-glow transition-colors" aria-label="Menü schließen">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 drop-shadow-[0_0_10px_rgba(139,92,246,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      <a href="/kurse" class="hover:text-brand-rose transition-all hover:scale-110 min-h-[44px] flex items-center">Kurse</a>
      <a href="/workshops" class="hover:text-brand-rose transition-all hover:scale-110 min-h-[44px] flex items-center">Workshops</a>
      <a href="/ueber-uns" class="hover:text-brand-rose transition-all hover:scale-110 min-h-[44px] flex items-center">Über Uns</a>
      <a href="/mitglied-werden" class="hover:text-brand-rose transition-all hover:scale-110 min-h-[44px] flex items-center">Mitgliedschaft</a>
      <a href="/blog" class="hover:text-brand-rose transition-all hover:scale-110 min-h-[44px] flex items-center">Journal</a>
      <a href="/kontakt" class="bg-brand-rose px-10 py-4 rounded-full text-white shadow-glow-rose hover:scale-105 transition-all mt-4 text-xl min-h-[44px]">Probestunde</a>
    </div>

    <script>
      function setupMenu() {
            const menuToggle = document.getElementById('menu-toggle');
            const menuClose = document.getElementById('menu-close');
            const mobileMenu = document.getElementById('mobile-menu');
            const menuLinks = mobileMenu?.querySelectorAll('a');

            function toggleMenu() {
              const isOpen = !mobileMenu?.classList.contains('translate-x-full');
              mobileMenu?.classList.toggle('translate-x-full');
              document.body.classList.toggle('overflow-hidden');
              if (menuToggle) {
                menuToggle.setAttribute('aria-expanded', String(!isOpen));
                menuToggle.setAttribute('aria-label', isOpen ? 'Menü öffnen' : 'Menü schließen');
              }
            }

            menuToggle?.addEventListener('click', toggleMenu);
            menuClose?.addEventListener('click', toggleMenu);
            menuLinks?.forEach(link => {
              link.addEventListener('click', () => {
                mobileMenu?.classList.add('translate-x-full');
                document.body.classList.remove('overflow-hidden');
                menuToggle?.setAttribute('aria-expanded', 'false');
                menuToggle?.setAttribute('aria-label', 'Menü öffnen');
              });
            });
      }

      // Initial setup
      setupMenu();

      // Re-setup on view transitions
      document.addEventListener('astro:after-swap', setupMenu);
    </script>

    <main id="main-content" class="flex-grow">
      <slot />
    </main>

    <footer class="bg-brand-dark border-t border-white/5 pt-20 pb-10 overflow-hidden">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
          <!-- Brand & About -->
          <div class="space-y-6">
            <div class="flex items-center gap-4">
              <div class="relative w-12 h-12 rounded-full overflow-hidden border border-brand-glow/60 shadow-glow-amber">
                <Image src={logoImg} alt="Idiomadanza Logo" width={48} height={48} class="p-1" decoding="async" />
              </div>
              <span class="text-2xl font-display font-bold text-brand-rose">Idiomadanza e.V.</span>
            </div>
            <p class="text-sm text-white/50 leading-relaxed max-w-xs">
              Tanzen verbindet: Dein Verein für Bachata & Salsa in Regensburg. Erlebe Leidenschaft und Community.
            </p>
          </div>

          <!-- Legal -->
          <div class="space-y-6">
            <h3 class="text-xs font-bold uppercase tracking-[0.2em] text-brand-glow">Rechtliches</h3>
            <ul class="space-y-6 text-sm text-white/60">
              <li><a href="/impressum" class="hover:text-brand-rose transition-colors">Impressum</a></li>
              <li><a href="/datenschutz" class="hover:text-brand-rose transition-colors">Datenschutz</a></li>
              <li><a href="/cookie-richtlinie" class="hover:text-brand-rose transition-colors">Cookies</a></li>
              <li><a href="/satzung" class="hover:text-brand-rose transition-colors">Satzung</a></li>
              <li><a href="/vereinsordnung" class="hover:text-brand-rose transition-colors">Vereinsordnung</a></li>
              <li><a href="/kurse#faq" class="hover:text-brand-rose transition-colors">Häufige Fragen</a></li>
            </ul>
          </div>

          <!-- Explore -->
          <div class="space-y-6">
            <h3 class="text-xs font-bold uppercase tracking-[0.2em] text-brand-glow">Entdecken</h3>
            <ul class="space-y-6 text-sm text-white/60">
              <li><a href="/kurse" class="hover:text-brand-rose transition-colors">Wöchentliche Kurse</a></li>
              <li><a href="/kurse#preise" class="hover:text-brand-rose transition-colors">Preise & Mitgliedschaft</a></li>
              <li><a href="/ueber-uns" class="hover:text-brand-rose transition-colors">Über den Verein</a></li>
              <li><a href="/mitglied-werden" class="hover:text-brand-rose transition-colors font-bold text-brand-rose/80">Mitglied werden</a></li>
            </ul>
          </div>

          <!-- Contact -->
          <div class="space-y-6">
            <h3 class="text-xs font-bold uppercase tracking-[0.2em] text-brand-glow">Kontakt</h3>
            <ul class="space-y-6 text-sm text-white/60">
              <li class="flex items-start gap-3">
                <span class="text-brand-rose">📍</span>
                <span>Isarstr. 85, 93057 Regensburg</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-brand-rose">💬</span>
                <a href="https://wa.me/+4915678659226?text=Hallo%20Idiomadanza,%20ich%20habe%20weitere%20Fragen%20zu%20..." target="_blank" class="hover:text-brand-rose transition-colors font-bold">Chat on WhatsApp</a>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-brand-rose">📧</span>
                <SafeMail email="mail@idiomadanza.de" class="hover:text-brand-rose transition-colors" />
              </li>
            </ul>
          </div>
        </div>

        <div class="pt-8 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-white/30">
          <p>&copy; {new Date().getFullYear()} Idiomadanza e.V. Alle Rechte vorbehalten.</p>
          <div class="flex gap-8">
            <a href="https://instagram.com/idiomadanza" target="_blank" rel="noopener" aria-label="Idiomadanza auf Instagram" class="hover:text-brand-rose transition-colors">Instagram</a>
            <a href="https://facebook.com/idiomadanza" target="_blank" rel="noopener" aria-label="Idiomadanza auf Facebook" class="hover:text-brand-rose transition-colors">Facebook</a>
          </div>
        </div>
      </div>
    </footer>
    <CookieBanner />
  </body>
</html>