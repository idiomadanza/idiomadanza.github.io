---
import Layout from '../layouts/Layout.astro';
import SafeMail from '../components/ui/SafeMail.astro';
---

<Layout 
  title="Beitrittsformular | Idiomadanza e.V."
  description="Werde Mitglied bei Idiomadanza e.V. – Deine Bachata & Salsa Community in Regensburg."
>
  {/* HERO */}
  <section class="bg-brand-ink px-[clamp(20px,5vw,80px)] pb-[clamp(32px,4vw,56px)] pt-[clamp(40px,6vw,88px)]">
    <div class="mx-auto flex max-w-[1280px] flex-col gap-7">
      <p class="text-sm font-semibold uppercase tracking-[0.14em] text-brand-gold">Mitgliedschaft</p>
      <h1 class="font-display text-[clamp(38px,5.6vw,80px)] font-extrabold leading-[0.95] tracking-[-0.03em] text-brand-paper">Beitrittsformular</h1>
      <p class="max-w-[44ch] text-[clamp(18px,1.6vw,22px)] text-brand-paper/85 italic">Mitgliederanträge online einreichen</p>
    </div>
  </section>

  {/* FORMULAR */}
  <section class="bg-brand-paper px-[clamp(20px,5vw,80px)] py-[clamp(40px,6vw,80px)] text-brand-ink">
    <div class="mx-auto max-w-[900px]">
      <div class="rounded-[36px] bg-white p-[clamp(24px,4vw,48px)]">

        <div id="form-feedback" class="mb-8 hidden rounded-2xl p-6 text-center font-bold"></div>

        <form id="membership-form" class="flex flex-col gap-14">
          <input type="hidden" name="sparte" value="Bachata">

          {/* ABSCHNITT 1 */}
          <div class="flex flex-col gap-7">
            <div class="flex items-center gap-4">
              <span class="flex size-10 items-center justify-center rounded-full bg-brand-ink font-display text-lg font-bold text-brand-gold">{1}</span>
              <h2 class="font-display text-[clamp(22px,2.4vw,30px)] font-extrabold tracking-[-0.02em]">Basis-Informationen</h2>
            </div>

            <div class="flex flex-col gap-2">
              <label for="email" class="text-xs font-bold uppercase tracking-[0.14em] text-brand-line">E-Mail*</label>
              <input type="email" id="email" name="email" required class="min-h-[52px] w-full rounded-2xl border border-brand-line/40 bg-brand-paper px-5 py-4 text-brand-ink outline-none transition-colors focus:border-brand-rose focus:ring-2 focus:ring-brand-rose/40">
              <p class="text-xs italic text-brand-line">Die E-Mail-Adresse wird auch verwendet, um dich über den Aufnahmeprozess zu informieren.</p>
            </div>
          </div>

          {/* ABSCHNITT 2 */}
          <div class="flex flex-col gap-7">
            <div class="flex items-center gap-4">
              <span class="flex size-10 items-center justify-center rounded-full bg-brand-ink font-display text-lg font-bold text-brand-gold">{2}</span>
              <h2 class="font-display text-[clamp(22px,2.4vw,30px)] font-extrabold tracking-[-0.02em]">Name &amp; Persönliches</h2>
            </div>

            <div class="grid gap-6 md:grid-cols-2">
              <div class="flex flex-col gap-2">
                <label for="vorname" class="text-xs font-bold uppercase tracking-[0.14em] text-brand-line">Vorname*</label>
                <input type="text" id="vorname" name="vorname" required minlength="2" placeholder="Max" class="min-h-[52px] w-full rounded-2xl border border-brand-line/40 bg-brand-paper px-5 py-4 text-brand-ink outline-none transition-colors focus:border-brand-rose focus:ring-2 focus:ring-brand-rose/40">
              </div>
              <div class="flex flex-col gap-2">
                <label for="nachname" class="text-xs font-bold uppercase tracking-[0.14em] text-brand-line">Nachname*</label>
                <input type="text" id="nachname" name="nachname" required minlength="2" placeholder="Mustermann" class="min-h-[52px] w-full rounded-2xl border border-brand-line/40 bg-brand-paper px-5 py-4 text-brand-ink outline-none transition-colors focus:border-brand-rose focus:ring-2 focus:ring-brand-rose/40">
              </div>
            </div>

            <div class="grid gap-6 md:grid-cols-2">
              <div class="flex flex-col gap-2">
                <label for="geburtstag" class="text-xs font-bold uppercase tracking-[0.14em] text-brand-line">Geburtstag*</label>
                <input type="date" id="geburtstag" name="geburtstag" required class="min-h-[52px] w-full rounded-2xl border border-brand-line/40 bg-brand-paper px-5 py-4 text-brand-ink outline-none transition-colors focus:border-brand-rose focus:ring-2 focus:ring-brand-rose/40">
              </div>
              <div class="flex flex-col gap-2">
                <label for="geschlecht" class="text-xs font-bold uppercase tracking-[0.14em] text-brand-line">Geschlecht*</label>
                <select id="geschlecht" name="geschlecht" required class="min-h-[52px] w-full appearance-none rounded-2xl border border-brand-line/40 bg-brand-paper px-5 py-4 text-brand-ink outline-none transition-colors focus:border-brand-rose focus:ring-2 focus:ring-brand-rose/40">
                  <option value="" disabled selected>Bitte wählen...</option>
                  <option value="weiblich">Weiblich</option>
                  <option value="männlich">Männlich</option>
                  <option value="divers">Divers / Keine Angabe</option>
                </select>
              </div>
            </div>
          </div>

          {/* ABSCHNITT 3 */}
          <div class="flex flex-col gap-7">
            <div class="flex items-center gap-4">
              <span class="flex size-10 items-center justify-center rounded-full bg-brand-ink font-display text-lg font-bold text-brand-gold">{3}</span>
              <h2 class="font-display text-[clamp(22px,2.4vw,30px)] font-extrabold tracking-[-0.02em]">Adresse &amp; Kontakt</h2>
            </div>

            <div class="flex flex-col gap-2">
              <label for="land" class="text-xs font-bold uppercase tracking-[0.14em] text-brand-line">Land*</label>
              <input type="text" id="land" name="land" required value="Deutschland" class="min-h-[52px] w-full rounded-2xl border border-brand-line/40 bg-brand-paper px-5 py-4 text-brand-ink outline-none transition-colors focus:border-brand-rose focus:ring-2 focus:ring-brand-rose/40">
            </div>

            <div class="grid gap-6 md:grid-cols-4">
              <div class="flex flex-col gap-2 md:col-span-3">
                <label for="strasse" class="text-xs font-bold uppercase tracking-[0.14em] text-brand-line">Straße*</label>
                <input type="text" id="strasse" name="strasse" required class="min-h-[52px] w-full rounded-2xl border border-brand-line/40 bg-brand-paper px-5 py-4 text-brand-ink outline-none transition-colors focus:border-brand-rose focus:ring-2 focus:ring-brand-rose/40">
              </div>
              <div class="flex flex-col gap-2">
                <label for="hausnummer" class="text-xs font-bold uppercase tracking-[0.14em] text-brand-line">Haus-Nr.*</label>
                <input type="text" id="hausnummer" name="hausnummer" required class="min-h-[52px] w-full rounded-2xl border border-brand-line/40 bg-brand-paper px-5 py-4 text-brand-ink outline-none transition-colors focus:border-brand-rose focus:ring-2 focus:ring-brand-rose/40">
              </div>
            </div>

            <div class="grid gap-6 md:grid-cols-3">
              <div class="flex flex-col gap-2">
                <label for="plz" class="text-xs font-bold uppercase tracking-[0.14em] text-brand-line">PLZ*</label>
                <input type="text" id="plz" name="plz" required class="min-h-[52px] w-full rounded-2xl border border-brand-line/40 bg-brand-paper px-5 py-4 text-brand-ink outline-none transition-colors focus:border-brand-rose focus:ring-2 focus:ring-brand-rose/40">
              </div>
              <div class="flex flex-col gap-2 md:col-span-2">
                <label for="ort" class="text-xs font-bold uppercase tracking-[0.14em] text-brand-line">Stadt/Ort*</label>
                <input type="text" id="ort" name="ort" required class="min-h-[52px] w-full rounded-2xl border border-brand-line/40 bg-brand-paper px-5 py-4 text-brand-ink outline-none transition-colors focus:border-brand-rose focus:ring-2 focus:ring-brand-rose/40">
              </div>
            </div>

            <div class="flex flex-col gap-2">
              <label for="telefon" class="text-xs font-bold uppercase tracking-[0.14em] text-brand-line">Telefonnummer</label>
              <input type="tel" id="telefon" name="telefon" pattern="^[+]?[\d\s\-().]{4,}$" placeholder="+49 ..." class="min-h-[52px] w-full rounded-2xl border border-brand-line/40 bg-brand-paper px-5 py-4 text-brand-ink outline-none transition-colors focus:border-brand-rose focus:ring-2 focus:ring-brand-rose/40">
            </div>
          </div>

          {/* ABSCHNITT 4 */}
          <div class="flex flex-col gap-7 rounded-3xl bg-brand-paper p-[clamp(20px,3vw,32px)]">
            <div class="flex items-center gap-4">
              <span class="flex size-10 items-center justify-center rounded-full bg-brand-ink font-display text-lg font-bold text-brand-gold">{4}</span>
              <h2 class="font-display text-[clamp(22px,2.4vw,30px)] font-extrabold tracking-[-0.02em]">Informationen zur Mitgliedschaft</h2>
            </div>

            <dl class="grid gap-x-12 gap-y-6 md:grid-cols-2">
              <div class="flex flex-col gap-1">
                <dt class="text-xs font-bold uppercase tracking-[0.14em] text-brand-line">Sparte</dt>
                <dd class="text-lg font-bold">Bachata</dd>
              </div>
              <div class="flex flex-col gap-1">
                <dt class="text-xs font-bold uppercase tracking-[0.14em] text-brand-line">Beitrag</dt>
                <dd class="text-lg font-bold">39 EUR / Monat (bzw. 19 EUR gemäß Auswahl)</dd>
              </div>
              <div class="flex flex-col gap-1">
                <dt class="text-xs font-bold uppercase tracking-[0.14em] text-brand-line">Aufnahmegebühr</dt>
                <dd class="text-lg font-bold">Einmalig 11 EUR</dd>
              </div>
              <div class="flex flex-col gap-1">
                <dt class="text-xs font-bold uppercase tracking-[0.14em] text-brand-line">Kündigung</dt>
                <dd class="text-lg font-bold">1 Monat zum Monatsende (Mindestlaufzeit 3 Monate).</dd>
              </div>
            </dl>
          </div>

          {/* ABSCHNITT 5 */}
          <div class="flex flex-col gap-7">
            <div class="flex items-center gap-4">
              <span class="flex size-10 items-center justify-center rounded-full bg-brand-ink font-display text-lg font-bold text-brand-gold">{5}</span>
              <h2 class="font-display text-[clamp(22px,2.4vw,30px)] font-extrabold tracking-[-0.02em]">Bankdaten (SEPA-Lastschrift)</h2>
            </div>

            <div class="grid gap-6 md:grid-cols-2">
              <div class="flex flex-col gap-2">
                <label for="kontoinhaber" class="text-xs font-bold uppercase tracking-[0.14em] text-brand-line">Kontoinhaber*</label>
                <input type="text" id="kontoinhaber" name="kontoinhaber" required minlength="2" placeholder="Max Mustermann" class="min-h-[52px] w-full rounded-2xl border border-brand-line/40 bg-brand-paper px-5 py-4 text-brand-ink outline-none transition-colors focus:border-brand-rose focus:ring-2 focus:ring-brand-rose/40">
              </div>
              <div class="flex flex-col gap-2">
                <label for="bank" class="text-xs font-bold uppercase tracking-[0.14em] text-brand-line">Bank</label>
                <input type="text" id="bank" name="bank" class="min-h-[52px] w-full rounded-2xl border border-brand-line/40 bg-brand-paper px-5 py-4 text-brand-ink outline-none transition-colors focus:border-brand-rose focus:ring-2 focus:ring-brand-rose/40">
              </div>
            </div>

            <div class="grid gap-6 md:grid-cols-3">
              <div class="flex flex-col gap-2 md:col-span-2">
                <label for="iban" class="text-xs font-bold uppercase tracking-[0.14em] text-brand-line">IBAN*</label>
                <input type="text" id="iban" name="iban" required placeholder="DE..." class="min-h-[52px] w-full rounded-2xl border border-brand-line/40 bg-brand-paper px-5 py-4 tracking-widest text-brand-ink outline-none transition-colors focus:border-brand-rose focus:ring-2 focus:ring-brand-rose/40">
              </div>
              <div class="flex flex-col gap-2">
                <label for="bic" class="text-xs font-bold uppercase tracking-[0.14em] text-brand-line">BIC</label>
                <input type="text" id="bic" name="bic" class="min-h-[52px] w-full rounded-2xl border border-brand-line/40 bg-brand-paper px-5 py-4 text-brand-ink outline-none transition-colors focus:border-brand-rose focus:ring-2 focus:ring-brand-rose/40">
              </div>
            </div>

            <label class="flex cursor-pointer items-start gap-4 rounded-2xl border-[1.5px] border-brand-line/30 p-5 transition-colors hover:border-brand-rose/60">
              <input type="checkbox" name="sepa_accepted" required class="mt-1 size-6 cursor-pointer rounded border-brand-line/60 text-brand-rose focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-rose">
              <span class="flex flex-col gap-1">
                <span class="text-sm font-bold">Lastschriftvereinbarung akzeptieren*</span>
                <span class="text-xs italic leading-relaxed text-brand-line">
                  Ich ermächtige den Verein, den Mitgliedsbeitrag monatlich im Voraus per Lastschrift einzuziehen.
                </span>
              </span>
            </label>
          </div>

          {/* ABSCHNITT 6 */}
          <div class="flex flex-col gap-7">
            <div class="flex items-center gap-4">
              <span class="flex size-10 items-center justify-center rounded-full bg-brand-ink font-display text-lg font-bold text-brand-gold">{6}</span>
              <h2 class="font-display text-[clamp(22px,2.4vw,30px)] font-extrabold tracking-[-0.02em]">Status &amp; Bestätigung</h2>
            </div>

            <div class="flex flex-col gap-3">
              <span class="text-xs font-bold uppercase tracking-[0.14em] text-brand-line">Studierende oder in Ausbildung</span>
              <label class="flex cursor-pointer items-center gap-4 rounded-2xl border-[1.5px] border-brand-line/30 p-5 transition-colors hover:border-brand-rose/60">
                <input type="checkbox" name="status" value="Studierend" class="size-6 cursor-pointer rounded border-brand-line/60 text-brand-rose focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-rose">
                <span class="font-bold">Ja, ich bin Studierende(r) oder in Ausbildung</span>
              </label>
              <p class="text-xs italic text-brand-line">Bitte einen aktuellen Nachweis an <SafeMail email="mail@idiomadanza.de" class="underline underline-offset-4 hover:text-brand-rose" /> schicken.</p>
            </div>

            {/* Bot Field (Honeypot) */}
            <p class="hidden">
              <label>Don’t fill this out if you’re human: <input name="bot-field" id="bot-field" /></label>
            </p>

            <div class="flex flex-col gap-4 pt-2">
              <label class="flex cursor-pointer items-start gap-4">
                <input type="checkbox" id="satzung_accepted" name="satzung_accepted" required class="mt-1 size-5 cursor-pointer rounded border-brand-line/60 text-brand-rose focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-rose">
                <span class="text-[15px] italic leading-relaxed text-brand-line">
                  Ich akzeptiere die <a href="/satzung/" target="_blank" class="font-bold text-brand-rose underline underline-offset-4 hover:text-brand-rose-bright">Vereinssatzung</a>*
                </span>
              </label>
              <label class="flex cursor-pointer items-start gap-4">
                <input type="checkbox" id="datenschutz_accepted" name="datenschutz_accepted" required class="mt-1 size-5 cursor-pointer rounded border-brand-line/60 text-brand-rose focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-rose">
                <span class="text-[15px] italic leading-relaxed text-brand-line">
                  Ich akzeptiere die <a href="/datenschutz/" target="_blank" class="font-bold text-brand-rose underline underline-offset-4 hover:text-brand-rose-bright">Datenschutzerklärung</a>*
                </span>
              </label>
            </div>

            <button type="submit" id="submit-btn" class="inline-flex min-h-[64px] w-full items-center justify-center gap-4 rounded-full bg-brand-rose px-8 text-sm font-bold uppercase tracking-[0.14em] text-white transition-colors hover:bg-brand-rose-bright">
              <span id="btn-text">Mitgliedschaft verbindlich beantragen</span>
              <span id="btn-spinner" class="hidden size-5 animate-spin rounded-full border-2 border-white/20 border-t-white"></span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </section>
  <script>
    const form = document.querySelector('#membership-form') as HTMLFormElement;
    const feedback = document.getElementById('form-feedback');
    const btnText = document.getElementById('btn-text');
    const btnSpinner = document.getElementById('btn-spinner');
    const submitBtn = document.getElementById('submit-btn');

    // Google Apps Script Web App URL
    const WEB_APP_URL = 'https://script.google.com/macros/s/AKfycbzTlgkYGZfD_i1hNZTIHOaW7An2SVWiKDDqWY2UF4S7XNo9lMwAYhaBeuMTtRW9Gk1E/exec';

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Honeypot Check
      const botField = (document.getElementById('bot-field') as HTMLInputElement)?.value;
      if (botField) {
        // Silent bot detection - return without submitting
        return;
      }
      
      feedback?.classList.add('hidden');
      if (submitBtn) (submitBtn as HTMLButtonElement).disabled = true;
      btnSpinner?.classList.remove('hidden');
      if (btnText) btnText.textContent = 'Antrag wird übermittelt...';

      const formData = new FormData(form);
      const data = Object.fromEntries(formData);
      
      // Timestamp hinzufügen
      data.timestamp = new Date().toLocaleString('de-DE');

      try {
        // Wir senden die Daten als JSON an das Google Apps Script
        // Da wir kein CORS Problem in der Cloud haben wollen, nutzen wir den Redirect-Handler von Apps Script
        const response = await fetch(WEB_APP_URL, {
          method: 'POST',
          mode: 'no-cors', // Apps Script antwortet mit 302 auf script.googleusercontent.com
          cache: 'no-cache',
          // Kein Content-Type-Header: in no-cors darf der Browser ihn nicht setzen
          body: JSON.stringify(data)
        });

        // Bei no-cors erhalten wir keine richtige Response, daher gehen wir bei Erfolg davon aus
        feedback?.classList.remove('hidden', 'bg-red-500/10', 'text-red-500');
        feedback?.classList.add('bg-green-500/10', 'text-green-500', 'block');
        if (feedback) feedback.textContent = 'Vielen Dank! Dein Mitgliedsantrag wurde erfolgreich übermittelt. Wir melden uns in Kürze bei dir.';
        
        form.reset();
        if (btnText) btnText.textContent = 'Antrag erfolgreich!';
        btnSpinner?.classList.add('hidden');

      } catch (_err) {
        feedback?.classList.remove('hidden', 'bg-green-500/10', 'text-green-500');
        feedback?.classList.add('bg-red-500/10', 'text-red-500', 'block');
        if (feedback) feedback.textContent = 'Es gab ein Problem. Bitte versuche es später erneut oder kontaktiere uns direkt.';
        
        if (btnText) btnText.textContent = 'Erneut versuchen';
        btnSpinner?.classList.add('hidden');
        if (submitBtn) (submitBtn as HTMLButtonElement).disabled = false;
      }
    });
  </script>
</Layout>
