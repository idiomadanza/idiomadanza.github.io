---
import Layout from '../layouts/Layout.astro';

// Terminliste der Bachata-Sensual-Elemente. Vergangene Termine werden beim Build
// herausgefiltert (Build-Zeit = Merge-Zeit, Netlify baut bei jedem Merge neu).
const termine = [
  { titel: 'Bolero', datum: '2026-09-08' },
  { titel: 'Paseala', datum: '2026-09-15' },
  { titel: 'Completo', datum: '2026-09-22' },
  { titel: 'Media, Manton, Salida', datum: '2026-09-29' },
  { titel: 'Special', datum: '2026-10-06' },
  { titel: 'Slide', datum: '2026-10-13' },
  { titel: 'Impulso', datum: '2026-10-20' },
  { titel: 'Waves', datum: '2026-10-27' },
  { titel: 'Special', datum: '2026-11-03' },
  { titel: 'Pinza', datum: '2026-11-10' },
  { titel: 'Culito', datum: '2026-11-17' },
  { titel: 'Cadera', datum: '2026-11-24' },
  { titel: 'Special', datum: '2026-12-01' },
  { titel: 'Headroll', datum: '2026-12-08' },
  { titel: 'Caida', datum: '2026-12-15' },
];

// Build-Tag in Europe/Berlin (deutsche Ortszeit), Format YYYY-MM-DD
const heute = new Intl.DateTimeFormat('sv-SE', { timeZone: 'Europe/Berlin' }).format(new Date());

const kommende = termine
  .filter((t) => t.datum >= heute)
  .map((t) => {
    const d = new Date(`${t.datum}T12:00:00Z`);
    const wochentag = new Intl.DateTimeFormat('de-DE', { weekday: 'long', timeZone: 'Europe/Berlin' })
      .format(d)
      .toUpperCase();
    const [jahr, monat, tag] = t.datum.split('-');
    return `${t.titel} - ${wochentag} ${tag}.${monat}.${jahr.slice(2)} um 20 Uhr`;
  });
---

<Layout
  title="Bachata Sensual Elemente Terminübersicht | Idiomadanza e.V."
  description="Bachata Sensual Elemente Terminübersicht: alle Termine für Bolero, Paseala, Completo, Media und mehr."
>
  <section class="container mx-auto px-4 py-24">
    <div class="max-w-3xl mx-auto bg-white/90 dark:bg-brand-dark/90 backdrop-blur-xl p-10 rounded-3xl shadow-glass border border-black/5 dark:border-white/10">
      <h1 class="text-4xl md:text-5xl font-display font-bold text-brand-dark dark:text-white mb-8">Bachata Sensual Elemente Terminübersicht</h1>
      <div class="space-y-4 text-lg leading-relaxed text-brand-dark/90 dark:text-white/90">
        {kommende.length > 0 ? (
          kommende.map((zeile) => <p>{zeile}</p>)
        ) : (
          <p>Die Termine für den nächsten Zyklus werden hier rechtzeitig veröffentlicht.</p>
        )}
      </div>
    </div>
  </section>
</Layout>
