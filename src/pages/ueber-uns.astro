---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import Icon from '../components/Icon.astro';

// Static Assets
import teamGroupImg from '../assets/images/team/team-group.jpg';

import { getCollection } from 'astro:content';

const allTeam = await getCollection('team');

const founders = allTeam.filter(t => t.data.isFounder).sort((a, b) => {
  const order = ['patricia', 'stephan'];
  return order.indexOf(a.id) - order.indexOf(b.id);
});
const trainers = allTeam.filter(t => !t.data.isFounder);

const trainerAnzahl = allTeam.length + allTeam.filter(t => t.id.includes('_und_')).length;

// Die Bio-Icons kommen als Emoji aus der Team-Collection (🎓 🥇 🥈 🥉) —
// sie werden hier auf das eigene Icon-Set abgebildet.
const bioIcon = (emoji: string) =>
  ({ '🎓': 'zertifikat', '🥇': 'zertifikat', '🥈': 'zertifikat', '🥉': 'zertifikat' } as Record<string, string>)[emoji];
---

<Layout
  title="Über Uns - Idiomadanza e.V. | Bachata & Salsa Verein Regensburg"
  description="Lerne das Team hinter Idiomadanza e.V. kennen: 9 leidenschaftliche Bachata & Salsa Trainer in Regensburg. Unsere Mission, Werte und Community."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Idiomadanza e.V.",
    "alternateName": "Idiomadanza Bachata & Salsa Regensburg",
    "url": "https://idiomadanza.de",
    "logo": "https://idiomadanza.de/favicon.png",
    "description": "Gemeinnütziger Bachata & Salsa Tanzverein in Regensburg. High-End Dance-Education meets Community Spirit.",
    "foundingDate": "2020",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Isarstr. 85",
      "addressLocality": "Regensburg",
      "postalCode": "93057",
      "addressCountry": "DE"
    },
    "sameAs": [
      "https://instagram.com/idiomadanza",
      "https://facebook.com/idiomadanza"
    ],
    "knowsAbout": ["Bachata", "Salsa", "Brazilian Zouk", "BachaZouk", "Dance Education"]
  })} />

  {/* HERO */}
  <section class="bg-brand-ink px-[clamp(20px,5vw,80px)] pb-[clamp(32px,4vw,56px)] pt-[clamp(40px,6vw,88px)]">
    <div class="mx-auto max-w-[1280px]">
      <div class="grid items-center gap-[clamp(32px,5vw,72px)] lg:grid-cols-[1.05fr_0.95fr]">
        <div class="flex flex-col gap-7">
          <p class="text-sm font-semibold uppercase tracking-[0.14em] text-brand-gold">Unsere Geschichte</p>
          <h1 class="font-display text-[clamp(42px,6.4vw,92px)] font-extrabold leading-[0.95] tracking-[-0.03em] text-brand-paper">
            Tanzen verbindet<br /><span class="text-brand-gold">Menschen</span>
          </h1>
          <p class="max-w-[42ch] text-[clamp(18px,1.6vw,22px)] text-brand-paper/85">
            Idiomadanza e.V. ist mehr als nur ein Tanzverein. Wir sind eine Community, die sich der Leidenschaft für Bachata und Salsa verschrieben hat.
          </p>
        </div>
        <div class="relative pb-7 pl-7">
          <div aria-hidden="true" class="absolute bottom-0 left-0 aspect-square w-[62%] rounded-full border-2 border-brand-gold"></div>
          <Image
            src={teamGroupImg}
            alt="Das Trainerteam von Idiomadanza e.V. als Gruppe"
            width={1200}
            height={900}
            widths={[480, 768, 1080]}
            sizes="(min-width: 1024px) 46vw, 92vw"
            format="webp"
            quality={58}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="relative block aspect-[4/3] w-full rounded-[28px] object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  {/* NAME / GRÜNDUNG */}
  <section class="bg-brand-surface px-[clamp(20px,5vw,80px)] py-[clamp(48px,7vw,96px)]">
    <div class="mx-auto flex max-w-[900px] flex-col gap-8">
      <p class="flex flex-wrap items-center gap-x-6 gap-y-2 font-display text-[clamp(20px,2.4vw,30px)] font-bold italic text-brand-gold">
        <span>Idioma – Sprache</span>
        <span aria-hidden="true" class="h-px w-12 bg-brand-paper/25"></span>
        <span>Danza – Tanz</span>
      </p>
      <blockquote class="flex flex-col gap-6">
        <p class="font-display text-[clamp(20px,2.6vw,32px)] font-medium leading-[1.3] tracking-[-0.01em] text-brand-paper">
          Jeder Mensch kann sich im Tanzen oder durch seine Bewegungen ausdrücken. Tanz/Bewegung ist wie eine Sprache nur eben mit dem ganzen Körper. Tanzen ist etwas sehr individuelles und jeder drückt sich anders aus und hat somit seine eigene persönliche Note beim Tanz oder in seinen Bewegungen.
        </p>
        <footer class="text-sm font-bold uppercase tracking-[0.14em] text-brand-gold">— Aus dem Gründungsprotokoll</footer>
      </blockquote>
    </div>
  </section>

  {/* MISSION */}
  <section class="bg-brand-paper px-[clamp(20px,5vw,80px)] py-[clamp(56px,8vw,112px)] text-brand-ink">
    <div class="mx-auto grid max-w-[1280px] items-center gap-[clamp(32px,5vw,72px)] lg:grid-cols-2">
      <div class="relative">
        <Image
          src={teamGroupImg}
          alt="Das Team von Idiomadanza e.V. zusammen auf einem Foto"
          width={1200}
          height={900}
          widths={[480, 768, 1200]}
          sizes="(min-width: 1024px) 46vw, 92vw"
          format="webp"
          loading="lazy"
          decoding="async"
          class="block aspect-[4/3] w-full rounded-[28px] object-cover"
        />
        <div class="absolute -bottom-6 -right-4 hidden rounded-3xl bg-brand-ink px-7 py-5 text-brand-paper md:block">
          <div class="font-display text-4xl font-extrabold tracking-[-0.02em] text-brand-gold">{trainerAnzahl}</div>
          <div class="text-sm font-semibold uppercase tracking-[0.14em] text-brand-muted">Trainer</div>
        </div>
      </div>

      <div class="flex flex-col gap-[22px]">
        <p class="text-sm font-bold uppercase tracking-[0.14em] text-brand-rose">Unsere Mission</p>
        <h2 class="font-display text-[clamp(34px,4.4vw,60px)] font-extrabold leading-none tracking-[-0.025em]">Warum es uns gibt</h2>
        <p class="max-w-[46ch] text-[19px] text-brand-line">
          Wir haben Idiomadanza ins Leben gerufen, um einen Raum in Regensburg zu schaffen, in dem jeder – unabhängig vom Tanzlevel – die Magie von Bachata und Salsa erleben kann. Bei uns geht es nicht nur um perfekte Schritte, sondern um das Gefühl, die Verbindung zum Partner und die Freude an der Musik.
        </p>
        <div class="grid gap-5 pt-4 sm:grid-cols-2">
          <div class="flex flex-col gap-3 rounded-3xl bg-white p-6">
            <div class="flex size-14 items-center justify-center rounded-full bg-brand-ink">
              <Icon name="gemeinnuetzig" size={28} class="text-brand-gold" />
            </div>
            <h3 class="font-display text-xl font-bold tracking-[-0.01em]">Community First</h3>
            <p class="text-brand-line">Bei uns bist du keine Nummer, sondern Teil einer wachsenden Tanz-Familie.</p>
          </div>
          <div class="flex flex-col gap-3 rounded-3xl bg-white p-6">
            <div class="flex size-14 items-center justify-center rounded-full bg-brand-ink">
              <Icon name="zertifikat" size={28} class="text-brand-gold" />
            </div>
            <h3 class="font-display text-xl font-bold tracking-[-0.01em]">Qualität &amp; Herz</h3>
            <p class="text-brand-line">Unsere Trainer brennen für das, was sie tun und vermitteln Technik mit viel Empathie.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* WERTE */}
  <section class="bg-brand-ink px-[clamp(20px,5vw,80px)] py-[clamp(56px,8vw,112px)]">
    <div class="mx-auto flex max-w-[1280px] flex-col gap-[clamp(32px,4vw,56px)]">
      <div class="flex max-w-[760px] flex-col gap-3.5">
        <p class="text-sm font-semibold uppercase tracking-[0.14em] text-brand-gold">Unsere Werte</p>
        <h2 class="font-display text-[clamp(34px,4.4vw,60px)] font-extrabold leading-none tracking-[-0.025em] text-brand-paper">Wofür wir brennen</h2>
      </div>
      <div class="grid gap-5 md:grid-cols-3">
        <div class="flex flex-col gap-3.5 rounded-3xl bg-brand-surface p-7">
          <div class="flex size-14 items-center justify-center rounded-full bg-brand-ink">
            <Icon name="drehung" size={28} class="text-brand-gold" />
          </div>
          <h3 class="font-display text-2xl font-bold tracking-[-0.01em] text-brand-paper">Eleganz</h3>
          <p class="text-brand-muted">Wir lieben die Ästhetik und den Ausdruck, den Bachata Sensual und Salsa verkörpern.</p>
        </div>
        <div class="flex flex-col gap-3.5 rounded-3xl bg-brand-surface p-7">
          <div class="flex size-14 items-center justify-center rounded-full bg-brand-ink">
            <Icon name="sicher-tanzen" size={28} class="text-brand-gold" />
          </div>
          <h3 class="font-display text-2xl font-bold tracking-[-0.01em] text-brand-paper">Respekt</h3>
          <p class="text-brand-muted">Ein sicherer Raum für alle Tänzer, in dem gegenseitige Wertschätzung an erster Stelle steht.</p>
        </div>
        <div class="flex flex-col gap-3.5 rounded-3xl bg-brand-surface p-7">
          <div class="flex size-14 items-center justify-center rounded-full bg-brand-ink">
            <Icon name="musik" size={28} class="text-brand-gold" />
          </div>
          <h3 class="font-display text-2xl font-bold tracking-[-0.01em] text-brand-paper">Leidenschaft</h3>
          <p class="text-brand-muted">Jeder Kurstag ist ein Event. Wir leben und lieben die lateinamerikanischen Rhythmen.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ZERTIFIZIERUNGEN */}
  <section class="bg-brand-paper px-[clamp(20px,5vw,80px)] py-[clamp(56px,8vw,112px)] text-brand-ink">
    <div class="mx-auto flex max-w-[1280px] flex-col gap-[clamp(32px,4vw,56px)]">
      <div class="flex max-w-[820px] flex-col gap-3.5">
        <p class="text-sm font-bold uppercase tracking-[0.14em] text-brand-rose">Exzellenz &amp; Ausbildung</p>
        <h2 class="font-display text-[clamp(34px,4.4vw,60px)] font-extrabold leading-none tracking-[-0.025em]">Zertifizierte Qualität</h2>
        <p class="text-[19px] text-brand-line">
          Bei uns lernst du direkt nach fundierten internationalen Ausbildungsstandards – anatomisch gesund, präzise und mit Fokus auf echten Social Dance.
        </p>
      </div>

      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        <article class="flex flex-col justify-between gap-6 rounded-3xl bg-white p-7">
          <div class="flex flex-col gap-3.5">
            <div class="flex size-14 items-center justify-center rounded-full bg-brand-ink">
              <Icon name="zertifikat" size={28} class="text-brand-gold" />
            </div>
            <h3 class="font-display text-xl font-bold tracking-[-0.01em]">Korke &amp; Judith Zertifiziert</h3>
            <p class="text-brand-line">Level 1 &amp; Level 2 zertifiziert direkt bei Korke &amp; Judith (Creators of Bachata Sensual). Präzise Führungsimpulse, geschmeidige Körperisolationen und gesunde Führungstechnik.</p>
          </div>
          <span class="text-xs font-bold uppercase tracking-[0.14em] text-brand-gold-ink">Bachata Sensual Level 1 &amp; 2</span>
        </article>

        <article class="flex flex-col justify-between gap-6 rounded-3xl bg-white p-7">
          <div class="flex flex-col gap-3.5">
            <div class="flex size-14 items-center justify-center rounded-full bg-brand-ink">
              <Icon name="schritt" size={28} class="text-brand-gold" />
            </div>
            <h3 class="font-display text-xl font-bold tracking-[-0.01em]">Evelin La Negra Zertifiziert</h3>
            <p class="text-brand-line">Zertifiziert in ursprünglicher Bachata. Wir respektieren die karibischen Wurzeln und Kultur des Tanzes (im Dominikanischen schlicht als „Bachata“ gewürdigt) mit Fokus auf Footwork und Musicality.</p>
          </div>
          <span class="text-xs font-bold uppercase tracking-[0.14em] text-brand-gold-ink">Original Bachata Heritage</span>
        </article>

        <article class="flex flex-col justify-between gap-6 rounded-3xl bg-white p-7">
          <div class="flex flex-col gap-3.5">
            <div class="flex size-14 items-center justify-center rounded-full bg-brand-ink">
              <Icon name="paar" size={28} class="text-brand-gold" />
            </div>
            <h3 class="font-display text-xl font-bold tracking-[-0.01em]">Dutch International Zouk Congress</h3>
            <p class="text-brand-line">Level 2 zertifiziert auf dem renommierten Dutch International Zouk Congress. Fundierte Ausbildung in Brazilian Zouk: fließende Head Movements, organische Wellen, Achsenstabilität und tiefe Tanzpaar-Connection.</p>
          </div>
          <span class="text-xs font-bold uppercase tracking-[0.14em] text-brand-gold-ink">Brazilian Zouk Level 2</span>
        </article>

        <article class="flex flex-col justify-between gap-6 rounded-3xl bg-white p-7">
          <div class="flex flex-col gap-3.5">
            <div class="flex size-14 items-center justify-center rounded-full bg-brand-ink">
              <Icon name="drehung" size={28} class="text-brand-gold" />
            </div>
            <h3 class="font-display text-xl font-bold tracking-[-0.01em]">BachaZouk nach Masa &amp; Polina</h3>
            <p class="text-brand-line">Offiziell zertifiziert nach Masa &amp; Polina. Die faszinierende Fusion aus Bachata und Zouk: Dynamische Head Movements, Circular Motion, Musikalität und fließende Übergänge – sicher geführt und social-dance-erprobt.</p>
          </div>
          <span class="text-xs font-bold uppercase tracking-[0.14em] text-brand-gold-ink">BachaZouk Certified</span>
        </article>

        <article class="flex flex-col justify-between gap-6 rounded-3xl bg-white p-7">
          <div class="flex flex-col gap-3.5">
            <div class="flex size-14 items-center justify-center rounded-full bg-brand-ink">
              <Icon name="zertifikat" size={28} class="text-brand-gold" />
            </div>
            <h3 class="font-display text-xl font-bold tracking-[-0.01em]">BLSV Übungsleiter</h3>
            <p class="text-brand-line">Offiziell ausgebildeter Übungsleiter C im Breitensport nach den Richtlinien des Bayerischen Landes-Sportverbandes (BLSV). Pädagogisch strukturierter und sportwissenschaftlich fundierter Unterricht.</p>
          </div>
          <span class="text-xs font-bold uppercase tracking-[0.14em] text-brand-gold-ink">Sportverband Qualitätssiegel</span>
        </article>

        <article class="flex flex-col justify-between gap-6 rounded-3xl bg-white p-7">
          <div class="flex flex-col gap-3.5">
            <div class="flex size-14 items-center justify-center rounded-full bg-brand-ink">
              <Icon name="role-rotation" size={28} class="text-brand-gold" />
            </div>
            <h3 class="font-display text-xl font-bold tracking-[-0.01em]">Leaders &amp; Followers Pionier</h3>
            <p class="text-brand-line">Als erste Tanzschule in Regensburg haben wir uns von überholten Begriffen wie „Damen/Herren“ verabschiedet. Wir fördern RoleRotation: Wer beide Rollen versteht, tanzt auf einem völlig neuen Niveau.</p>
          </div>
          <span class="text-xs font-bold uppercase tracking-[0.14em] text-brand-gold-ink">Moderne Tanzkultur</span>
        </article>

        <article class="flex flex-col justify-between gap-6 rounded-3xl bg-white p-7">
          <div class="flex flex-col gap-3.5">
            <div class="flex size-14 items-center justify-center rounded-full bg-brand-ink">
              <Icon name="paar" size={28} class="text-brand-gold" />
            </div>
            <h3 class="font-display text-xl font-bold tracking-[-0.01em]">Dancefloor Approved</h3>
            <p class="text-brand-line">Unsere Trainer nehmen regelmäßig an Social Dance Competitions teil. Keine starren Show-Choreos, sondern echtes, improvisiertes Führen &amp; Folgen auf Social Partys weltweit.</p>
          </div>
          <span class="text-xs font-bold uppercase tracking-[0.14em] text-brand-gold-ink">Social Dance Competitors</span>
        </article>
      </div>
    </div>
  </section>

  {/* TEAM */}
  <section id="team" class="bg-brand-ink px-[clamp(20px,5vw,80px)] py-[clamp(56px,8vw,112px)]">
    <div class="mx-auto flex max-w-[1280px] flex-col gap-[clamp(32px,4vw,56px)]">
      <div class="flex max-w-[760px] flex-col gap-3.5">
        <p class="text-sm font-semibold uppercase tracking-[0.14em] text-brand-gold">Das Team</p>
        <h2 class="font-display text-[clamp(34px,4.4vw,60px)] font-extrabold leading-none tracking-[-0.025em] text-brand-paper">Die Gesichter hinter Idioma</h2>
        <p class="text-[19px] text-brand-muted">Ein Team aus {trainerAnzahl} leidenschaftlichen Trainern, die darauf brennen, ihr Wissen mit dir zu teilen.</p>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
        {[...founders, ...trainers].map((member) => (
          <div class="flex flex-col overflow-hidden rounded-3xl bg-brand-surface">
            <div class="relative aspect-[4/5] overflow-hidden">
              <Image
                src={member.data.image}
                alt={member.data.name}
                width={600}
                height={750}
                loading="lazy"
                decoding="async"
                class={`block h-full w-full object-cover ${member.data.imagePosition || 'object-center'}`}
              />
              <div class="absolute bottom-4 left-5 right-5">
                <h3 class="font-display text-2xl font-bold tracking-[-0.01em] text-brand-paper">{member.data.name}</h3>
                <p class="text-xs font-bold uppercase tracking-[0.14em] text-brand-gold">{member.data.role}</p>
              </div>
            </div>

            <div class="flex flex-grow flex-col justify-between gap-4 p-6">
              <div class="flex flex-col gap-3">
                {member.data.bio && member.data.bio.map((item) => (
                  <div class="flex items-start gap-3 text-[15px] text-brand-muted">
                    {bioIcon(item.icon) && (
                      <Icon name={bioIcon(item.icon)} size={18} strokeWidth={1.75} class="mt-0.5 shrink-0 text-brand-gold" />
                    )}
                    <span>{item.text}</span>
                  </div>
                ))}
              </div>

              {member.data.instagram && (
                <a href={member.data.instagram} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-[44px] items-center gap-2 text-xs font-bold uppercase tracking-[0.14em] text-brand-paper/70 transition-colors hover:text-brand-gold">
                  Instagram <span aria-hidden="true">&nearr;</span>
                </a>
              )}
            </div>
          </div>
        ))}
      </div>

      <figure class="flex flex-col gap-5 border-t-2 border-brand-gold pt-7">
        <blockquote class="font-display text-[clamp(24px,2.8vw,38px)] font-medium leading-[1.2] tracking-[-0.01em] text-brand-paper">
          „Wir unterrichten nicht nur Tanzschritte – wir vermitteln Lebensfreude.“
        </blockquote>
        <figcaption class="text-brand-muted">— Stephan &amp; Patricia, Gründer von Idiomadanza e.V.</figcaption>
      </figure>
    </div>
  </section>

  {/* CTA */}
  <section class="bg-brand-ink px-[clamp(20px,5vw,80px)] pb-[clamp(56px,8vw,112px)]">
    <div class="mx-auto flex max-w-[1280px] flex-col gap-[18px] rounded-[36px] bg-brand-gold px-[clamp(28px,5vw,72px)] py-[clamp(28px,5vw,72px)] text-brand-ink">
      <h2 class="font-display text-[clamp(32px,4.4vw,60px)] font-extrabold leading-[0.96] tracking-[-0.03em]">Komm vorbei und mach dir selbst ein Bild.</h2>
      <p class="max-w-[44ch] text-[19px]">Die erste Stunde ist gratis – allein, zu zweit oder mit Freunden.</p>
      <div class="flex flex-wrap items-center gap-5">
        <a href="/kontakt/" class="inline-flex min-h-[56px] items-center gap-2.5 rounded-full bg-brand-ink px-8 text-lg font-bold text-brand-paper transition-colors hover:bg-brand-surface">
          Probestunde anfragen
        </a>
        <a href="/kurse/" class="inline-flex min-h-[44px] items-center font-semibold underline underline-offset-4">Zum Kursplan</a>
      </div>
    </div>
  </section>
</Layout>
