---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';

// Static Assets
import heroBg from '../assets/images/testimonials/bg.png';

import { getCollection } from 'astro:content';

const allTeam = await getCollection('team');

const founders = allTeam.filter(t => t.data.isFounder).sort((a, b) => {
  const order = ['patricia', 'stephan', 'chris_und_nalini'];
  return order.indexOf(a.id) - order.indexOf(b.id);
});
const trainers = allTeam.filter(t => !t.data.isFounder);

// Curated list for the 8-tile collage: Patricia & Stephan first, then trainers.
// Chris & Nalini are intentionally moved to the full list below the collage to focus on the founders.
const overviewTeam = [
  ...founders.filter(f => f.id !== 'chris_und_nalini').slice(0, 2),
  ...trainers
].slice(0, 8);
---

<Layout 
  title="Über Uns - Idiomadanza e.V. | Bachata & Salsa Verein Regensburg"
  description="Lerne das Team hinter Idiomadanza e.V. kennen: 13 leidenschaftliche Bachata & Salsa Trainer in Regensburg. Unsere Mission, Werte und Community."
>
  <!-- HERO SECTION -->
  <section class="relative py-24 md:py-32 lg:py-48 overflow-hidden bg-brand-dark">
    <div class="absolute inset-0 z-0">
      <Image src={heroBg} alt="Hero Background" class="w-full h-full object-cover opacity-50 blur-[2px]" />
      <div class="absolute inset-0 bg-gradient-to-b from-brand-dark/80 via-brand-dark/60 to-brand-dark"></div>
    </div>
    
    <div class="container mx-auto px-4 relative z-10 text-center">
      <span class="inline-block py-1 px-4 rounded-full bg-brand-rose/20 text-brand-rose text-sm font-bold tracking-widest uppercase mb-4 animate-fade-in backdrop-blur-sm border border-brand-rose/30">Unsere Geschichte</span>
      <h1 class="font-display text-5xl md:text-7xl lg:text-8xl font-bold text-white mb-6 drop-shadow-2xl">
        Tanzen verbindet <span class="text-brand-rose drop-shadow-[0_0_15px_rgba(190,18,60,0.5)]">Menschen</span>
      </h1>
      <p class="max-w-3xl mx-auto text-xl md:text-2xl text-white/90 leading-relaxed font-light drop-shadow-md">
        Idiomadanza e.V. ist mehr als nur ein Tanzverein. Wir sind eine Community, die sich der Leidenschaft für Bachata und Salsa verschrieben hat.
      </p>
    </div>
  </section>

  <!-- FOUNDING IDENTITY SECTION -->
  <section class="py-20 bg-brand-dark relative overflow-hidden">
    <div class="container mx-auto px-4 text-center">
      <div class="max-w-4xl mx-auto space-y-8">
        <div class="inline-flex items-center gap-6 text-brand-rose font-display text-2xl md:text-3xl font-bold italic">
          <span>Idioma – Sprache</span>
          <span class="w-12 h-px bg-white/20"></span>
          <span>Danza – Tanz</span>
        </div>
        <div class="relative">
          <div class="absolute -top-10 -left-10 text-9xl font-display text-white/5 italic">"</div>
          <p class="text-xl md:text-3xl text-white/90 leading-relaxed font-display italic relative z-10">
            Jeder Mensch kann sich im Tanzen oder durch seine Bewegungen ausdrücken. Tanz/Bewegung ist wie eine Sprache nur eben mit dem ganzen Körper. Tanzen ist etwas sehr individuelles und jeder drückt sich anders aus und hat somit seine eigene persönliche Note beim Tanz oder in seinen Bewegungen.
          </p>
          <p class="text-sm uppercase tracking-[0.3em] text-brand-glow font-bold pt-8">— Aus dem Gründungsprotokoll</p>
        </div>
      </div>
    </div>
    <!-- Decor -->
    <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-brand-rose/10 rounded-full blur-[120px]"></div>
  </section>

  <!-- PHILOSOPHY / STORY SECTION -->
  <section class="py-24 bg-brand-light dark:bg-brand-dark relative overflow-hidden">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="relative">
          <div class="absolute -top-10 -left-10 w-64 h-64 bg-brand-rose/10 rounded-full blur-[80px] -z-10"></div>
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-2 lg:gap-3 rounded-idioma overflow-hidden shadow-glow-rose transform hover:rotate-1 hover:scale-[1.02] transition-transform duration-700 bg-white/5 border border-white/20 p-2 md:p-3 relative z-10 before:absolute before:inset-0 before:bg-brand-rose/5 before:pointer-events-none">
            
            {overviewTeam.map((member) => (
              <div class="aspect-square overflow-hidden rounded-lg group relative">
                <div class="absolute inset-x-0 bottom-0 py-2 px-3 bg-gradient-to-t from-black/80 to-transparent z-10 opacity-0 group-hover:opacity-100 transition-opacity">
                  <span class="text-white font-bold text-xs">{member.data.name}</span>
                </div>
                <Image 
                  src={member.data.image} 
                  alt={member.data.name} 
                  class={`w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500 scale-110 group-hover:scale-100 ${member.data.imagePosition}`}
                />
              </div>
            ))}
            
          </div>
          <div class="absolute -bottom-8 -right-8 bg-white/70 dark:bg-brand-dark/80 backdrop-blur-md p-8 rounded-idioma border border-white/20 hidden md:block shadow-glow-rose z-20">
            <div class="text-4xl font-bold text-brand-rose mb-1">13</div>
            <div class="text-sm uppercase tracking-widest font-bold dark:text-white/60">Experten Trainer</div>
          </div>
        </div>
        
        <div class="space-y-8">
          <h2 class="font-display text-4xl md:text-5xl font-bold text-brand-dark dark:text-brand-light">Unsere <span class="text-brand-rose">Mission</span></h2>
          <p class="text-lg opacity-80 leading-relaxed dark:text-brand-light">
            Wir haben Idiomadanza ins Leben gerufen, um einen Raum in Regensburg zu schaffen, in dem jeder – unabhängig vom Tanzlevel – die Magie von Bachata und Salsa erleben kann. Bei uns geht es nicht nur um perfekte Schritte, sondern um das Gefühl, die Verbindung zum Partner und die Freude an der Musik.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-4">
            <div class="p-6 bg-white/50 dark:bg-white/5 rounded-idioma border border-brand-dark/10 dark:border-white/10 shadow-sm">
              <div class="text-brand-rose text-2xl mb-4">♥</div>
              <h4 class="font-bold mb-2 dark:text-brand-light">Community First</h4>
              <p class="text-sm opacity-70 dark:text-brand-light/70">Bei uns bist du keine Nummer, sondern Teil einer wachsenden Tanz-Familie.</p>
            </div>
            <div class="p-6 bg-white/50 dark:bg-white/5 rounded-idioma border border-brand-dark/10 dark:border-white/10 shadow-sm">
              <div class="text-brand-glow text-2xl mb-4">★</div>
              <h4 class="font-bold mb-2 dark:text-brand-light">Qualität & Herz</h4>
              <p class="text-sm opacity-70 dark:text-brand-light/70">Unsere Trainer brennen für das, was sie tun und vermitteln Technik mit viel Empathie.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- VALUES SECTION -->
  <section class="py-24 bg-brand-dark text-white relative overflow-hidden">
    <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-brand-rose to-transparent opacity-30"></div>
    <div class="container mx-auto px-4 relative z-10 text-center">
      <h2 class="font-display text-4xl md:text-5xl font-bold mb-16">Wofür wir <span class="text-brand-glow">brennen</span></h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
        <div class="group">
          <div class="w-20 h-20 bg-brand-rose/20 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform shadow-glow-rose">
             <span class="text-3xl">🕺</span>
          </div>
          <h3 class="text-2xl font-bold mb-4">Eleganz</h3>
          <p class="opacity-70 leading-relaxed">Wir lieben die Ästhetik und den Ausdruck, den Bachata Sensual und Salsa verkörpern.</p>
        </div>
        <div class="group">
          <div class="w-20 h-20 bg-brand-glow/20 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform shadow-glow-amber">
             <span class="text-3xl">🤝</span>
          </div>
          <h3 class="text-2xl font-bold mb-4">Respekt</h3>
          <p class="opacity-70 leading-relaxed">Ein sicherer Raum für alle Tänzer, in dem gegenseitige Wertschätzung an erster Stelle steht.</p>
        </div>
        <div class="group">
          <div class="w-20 h-20 bg-brand-rose/20 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform shadow-glow-rose">
             <span class="text-3xl">🔥</span>
          </div>
          <h3 class="text-2xl font-bold mb-4">Leidenschaft</h3>
          <p class="opacity-70 leading-relaxed">Jeder Kurstag ist ein Event. Wir leben und lieben die lateinamerikanischen Rhythmen.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FULL TEAM SHOWCASE -->
  <section id="team" class="py-24 bg-brand-light dark:bg-brand-dark relative overflow-hidden">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="font-display text-4xl md:text-5xl font-bold text-brand-dark dark:text-brand-light mb-4">Die Gesichter hinter <span class="text-brand-rose">Idioma</span></h2>
        <div class="w-24 h-1 bg-brand-glow mx-auto rounded-full mb-6"></div>
        <p class="max-w-2xl mx-auto opacity-80 text-lg dark:text-brand-light">Ein Team aus {allTeam.length + allTeam.filter(t => t.id.includes('_und_')).length} leidenschaftlichen Trainern, die darauf brennen, ihr Wissen mit dir zu teilen.</p>
      </div>

        <!-- Unified Team Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8 max-w-7xl mx-auto mb-12">
          {[...founders, ...trainers].map((member) => (
            <div class="group bg-brand-dark/80 backdrop-blur-md border border-white/10 rounded-2xl overflow-hidden hover:border-brand-rose transition-all duration-500 hover:-translate-y-2 flex flex-col shadow-glass">
              <div class="aspect-[4/5] overflow-hidden relative">
                <Image 
                  src={member.data.image} 
                  alt={member.data.name} 
                  class={`w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700 ${member.data.imagePosition || 'object-center'}`} 
                />
                <div class="absolute inset-0 bg-gradient-to-t from-brand-dark via-brand-dark/20 to-transparent opacity-90"></div>
                
                <div class="absolute bottom-4 left-6 right-6">
                  <h3 class="text-2xl font-display font-bold text-white mb-1 drop-shadow-md">{member.data.name}</h3>
                  <p class="text-brand-rose font-bold text-xs uppercase tracking-widest drop-shadow-md">{member.data.role}</p>
                </div>
              </div>

              <div class="p-6 flex-grow flex flex-col justify-between bg-brand-dark/95">
                <div class="space-y-4">
                  {member.data.bio && member.data.bio.map((item) => (
                    <div class="flex items-start gap-3 text-xs text-brand-light/80">
                      <span class="text-brand-glow text-sm leading-none pt-0.5">{item.icon}</span>
                      <span class="leading-relaxed">{item.text}</span>
                    </div>
                  ))}
                </div>
                
                {member.data.instagram && (
                  <a href={member.data.instagram} target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex items-center gap-2 text-[11px] font-bold uppercase tracking-widest text-brand-light/40 hover:text-brand-rose transition-colors">
                    Instagram <span class="text-xs">↗</span>
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      
      <div class="mt-24 p-12 bg-white/10 backdrop-blur-md rounded-idioma border border-white/20 text-center max-w-4xl mx-auto dark:text-white relative overflow-hidden shadow-glow-rose">
        <div class="absolute top-0 right-0 p-4 opacity-10">
          <span class="text-9xl font-display italic">"</span>
        </div>
        <h3 class="text-3xl font-display font-bold mb-6 italic relative z-10">"Wir unterrichten nicht nur Tanzschritte – wir vermitteln Lebensfreude."</h3>
        <p class="text-lg opacity-80 relative z-10">- Stephan & Patricia, Gründer von Idiomadanza e.V.</p>
      </div>
    </div>
  </section>
</Layout>
