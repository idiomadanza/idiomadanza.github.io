---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

import heroBg from '../assets/images/testimonials/bg.png';

const blogEntries = await getCollection('blog');
---

<Layout
  title="Blog & Tanz-Guide | Idiomadanza e.V."
  description="Neuigkeiten, Ratgeber, Kurstermine und Community-News rund um Bachata & Salsa in Regensburg – der Blog von Idiomadanza e.V."
>
  <!-- HERO SECTION -->
  <section class="relative py-24 md:py-32 overflow-hidden bg-brand-dark">
    <div class="absolute inset-0 z-0">
      <Image src={heroBg} alt="Blog Background" width={1920} height={1080} loading="lazy" decoding="async" class="w-full h-full object-cover opacity-50 blur-[2px]" />
      <div class="absolute inset-0 bg-gradient-to-b from-brand-dark/80 via-brand-dark/60 to-brand-dark"></div>
    </div>

    <div class="container mx-auto px-4 relative z-10 text-center">
      <span class="inline-block py-1 px-4 rounded-full bg-brand-rose/20 text-brand-rose text-sm font-bold tracking-widest uppercase mb-4 backdrop-blur-sm border border-brand-rose/30">News & Guides</span>
      <h1 class="font-display text-5xl md:text-7xl font-bold text-white mb-6">Blog</h1>
      <p class="max-w-2xl mx-auto text-xl text-white/80 leading-relaxed font-light">
        Tanzwissen, Community-News und aktuelle Termine für Bachata & Salsa in Regensburg.
      </p>
    </div>
  </section>

  <!-- BLOG LIST -->
  <section class="py-24 bg-brand-light dark:bg-brand-dark relative z-10 -mt-10 md:-mt-20">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12 max-w-7xl mx-auto">
        {blogEntries.map((post) => (
          <a href={`/blog/${post.id}`} class="group relative flex flex-col h-full bg-white/70 dark:bg-brand-dark/50 backdrop-blur-xl rounded-idioma border border-white/20 dark:border-white/10 overflow-hidden shadow-glass transition-all duration-500 hover:-translate-y-4">
            <div class="p-8 flex flex-col flex-grow">
              <span class="text-brand-rose font-bold text-sm uppercase tracking-widest block mb-2">{post.data.date}</span>
              <h2 class="text-2xl font-display font-bold text-brand-dark dark:text-white leading-tight group-hover:text-brand-rose transition-colors mb-4">{post.data.title}</h2>
              <p class="text-base opacity-70 dark:text-brand-light/70 leading-relaxed flex-grow">{post.data.excerpt}</p>
              <div class="pt-6 mt-6 border-t border-brand-dark/5 dark:border-white/10 text-brand-rose font-bold text-sm group-hover:translate-x-2 transition-transform">Weiterlesen →</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
