---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const blogEntries = await getCollection('blog');
---

<Layout
  title="Blog & Tanz-Guide | Idiomadanza e.V."
  description="Neuigkeiten, Ratgeber, Kurstermine und Community-News rund um Bachata & Salsa in Regensburg – der Blog von Idiomadanza e.V."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Blog",
    "name": "Idiomadanza Blog",
    "description": "Neuigkeiten, Ratgeber, Kurstermine und Community-News rund um Bachata & Salsa in Regensburg",
    "url": "https://idiomadanza.de/blog",
    "publisher": {
      "@type": "Organization",
      "name": "Idiomadanza e.V.",
      "url": "https://idiomadanza.de"
    },
    "blogPost": blogEntries.map(post => ({
      "@type": "BlogPosting",
      "headline": post.data.title,
      "description": post.data.excerpt,
      "datePublished": post.data.date,
      "author": { "@type": "Person", "name": post.data.author || "Idiomadanza Vorstand" },
      "url": `https://idiomadanza.de/blog/${post.id}/`
    }))
  })} />
  {/* HERO */}
  <section class="bg-brand-ink px-[clamp(20px,5vw,80px)] pb-[clamp(32px,4vw,56px)] pt-[clamp(40px,6vw,88px)]">
    <div class="mx-auto flex max-w-[1280px] flex-col gap-7">
      <p class="text-sm font-semibold uppercase tracking-[0.14em] text-brand-gold">News &amp; Guides</p>
      <h1 class="font-display text-[clamp(42px,6.8vw,96px)] font-extrabold leading-[0.94] tracking-[-0.03em] text-brand-paper">Blog</h1>
      <p class="max-w-[44ch] text-[clamp(18px,1.6vw,22px)] text-brand-paper/85">
        Tanzwissen, Community-News und aktuelle Termine für Bachata &amp; Salsa in Regensburg.
      </p>
    </div>
  </section>

  {/* BEITRÄGE */}
  <section class="bg-brand-ink px-[clamp(20px,5vw,80px)] pb-[clamp(56px,8vw,112px)]">
    <div class="mx-auto grid max-w-[1280px] gap-6 md:grid-cols-2 lg:grid-cols-3">
      {blogEntries.map((post) => (
        <a href={`/blog/${post.id}/`} class="flex flex-col gap-4 rounded-3xl bg-brand-surface p-7 transition-colors hover:bg-brand-surface/70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-gold">
          <span class="text-xs font-bold uppercase tracking-[0.14em] text-brand-gold">{post.data.date}</span>
          <h2 class="font-display text-2xl font-bold leading-[1.1] tracking-[-0.02em] text-brand-paper">{post.data.title}</h2>
          <p class="flex-grow text-[15px] text-brand-muted">{post.data.excerpt}</p>
          <span class="mt-2 inline-flex min-h-[44px] items-center gap-2 text-[15px] font-bold text-brand-gold">
            Weiterlesen <span aria-hidden="true">&rarr;</span>
          </span>
        </a>
      ))}
    </div>
  </section>
</Layout>
