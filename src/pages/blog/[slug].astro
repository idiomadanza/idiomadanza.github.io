---
import Layout from '../../layouts/Layout.astro';
import { type CollectionEntry, getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map((entry) => ({
    params: { slug: entry.id }, props: { entry },
  }));
}

type Props = {
  entry: CollectionEntry<'blog'>;
};

const { entry } = Astro.props;
const { Content } = await render(entry);

// Falls entry.data.image nur ein String ist, importieren wir es manuell
let finalImage = entry.data.image;

if (typeof finalImage === 'string') {
  const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*.{jpeg,jpg,png,gif,webp,avif}');
  const imagePath = finalImage.replace('../../assets/', '/src/assets/');
  
  if (images[imagePath]) {
    const mod = await images[imagePath]();
    finalImage = mod.default;
  }
}
---

<Layout title={`${entry.data.title} | Idiomadanza e.V.`} description={entry.data.excerpt}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": entry.data.title,
    "description": entry.data.excerpt,
    "datePublished": entry.data.date,
    "dateModified": entry.data.date,
    "author": {
      "@type": "Person",
      "name": entry.data.author || "Idiomadanza Vorstand"
    },
    "publisher": {
      "@type": "DanceSchool",
      "name": "Idiomadanza e.V.",
      "alternateName": "Idiomadanza Bachata & Salsa Regensburg"
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": `https://idiomadanza.de/blog/${entry.id}/`
    },
    "image": entry.data.image ? `https://idiomadanza.de${entry.data.image}` : undefined,
    "keywords": entry.data.tags ? entry.data.tags.join(", ") : "Bachata, Salsa, Tanz, Regensburg"
  })} />
  <article class="bg-brand-ink px-[clamp(20px,5vw,80px)] py-[clamp(40px,6vw,88px)]">
    <div class="mx-auto max-w-[860px]">

      {/* Zurück & Kategorie */}
      <div class="mb-8 flex flex-wrap items-center justify-between gap-4">
        <a href="/blog/" class="inline-flex min-h-[44px] items-center gap-2 text-xs font-bold uppercase tracking-[0.14em] text-brand-gold hover:text-brand-gold-soft">
          <span aria-hidden="true">&larr;</span> Zurück zur Blog-Übersicht
        </a>
        <span class="inline-block rounded-full border border-brand-gold px-3.5 py-1 text-xs font-bold uppercase tracking-[0.14em] text-brand-gold">
          {entry.data.category || 'Tanz-Guide'}
        </span>
      </div>

      {/* Artikelkopf */}
      <header class="mb-10 flex flex-col gap-6 md:mb-14">
        <h1 class="font-display text-[clamp(32px,4.6vw,64px)] font-extrabold leading-[1.05] tracking-[-0.03em] text-brand-paper">
          {entry.data.title}
        </h1>

        {entry.data.excerpt && (
          <p class="border-l-2 border-brand-gold pl-5 text-[clamp(17px,1.5vw,20px)] italic leading-relaxed text-brand-paper/85">
            {entry.data.excerpt}
          </p>
        )}

        {/* Meta */}
        <div class="flex flex-wrap items-center gap-x-6 gap-y-3 border-y border-brand-paper/15 py-4 text-sm text-brand-muted">
          <span class="inline-flex items-center gap-2">{entry.data.author || 'Idiomadanza Vorstand'}</span>
          <span aria-hidden="true" class="text-brand-paper/30">&middot;</span>
          <span class="inline-flex items-center gap-2">
            <Icon name="termin" size={18} strokeWidth={1.75} class="shrink-0 text-brand-gold" />
            {entry.data.date}
          </span>
          <span aria-hidden="true" class="text-brand-paper/30">&middot;</span>
          <span class="inline-flex items-center gap-2">ca. 5 Min. Lesezeit</span>
        </div>
      </header>

      {/* Beitragsbild */}
      {finalImage && (
        <div class="mb-12 overflow-hidden rounded-[28px]">
          <Image
            src={finalImage}
            alt={entry.data.title}
            width={1200}
            height={675}
            widths={[480, 768, 1200]}
            sizes="(min-width: 860px) 860px, 92vw"
            format="webp"
            loading="lazy"
            decoding="async"
            class="block aspect-video w-full object-cover"
          />
        </div>
      )}

      {/* Inhalt */}
      <div class="blog-prose leading-relaxed">
        <Content />
      </div>

      <footer class="mt-16 border-t border-brand-paper/15 pt-12">
        <div class="flex flex-col gap-6 rounded-[36px] bg-brand-surface p-[clamp(24px,4vw,48px)]">
          <div class="flex size-16 items-center justify-center rounded-full bg-brand-ink">
            <Icon name="paar" size={30} class="text-brand-gold" />
          </div>
          <h2 class="font-display text-[clamp(24px,3vw,36px)] font-extrabold leading-[1.05] tracking-[-0.02em] text-brand-paper">
            Lust bekommen, Bachata oder Salsa auszuprobieren?
          </h2>
          <p class="max-w-[52ch] text-[17px] text-brand-muted">
            Komm einfach zu einer kostenlosen Schnupperstunde vorbei – egal ob dienstags im Fortuna oder mittwochs am Bahnhof. Kein Tanzpartner nötig!
          </p>
          <div class="flex flex-wrap items-center gap-4">
            <a href="/kontakt/" class="inline-flex min-h-[56px] items-center gap-2.5 rounded-full bg-brand-rose px-7 text-lg font-bold text-white transition-colors hover:bg-brand-rose-bright">
              Kostenlose Probestunde anfragen <span aria-hidden="true">&rarr;</span>
            </a>
            <a href="https://wa.me/4915678659226?text=Hallo%20Idiomadanza,%20ich%20habe%20eine%20Frage%20zu%20den%20Kursen" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-[56px] items-center rounded-full border-[1.5px] border-brand-paper/35 px-7 text-lg font-semibold text-brand-paper transition-colors hover:border-brand-gold hover:text-brand-gold">
              WhatsApp Chat
            </a>
          </div>
        </div>

        <div class="mt-10">
          <a href="/blog/" class="inline-flex min-h-[44px] items-center gap-2 text-sm font-bold text-brand-gold underline underline-offset-4 hover:text-brand-gold-soft">
            &larr; Zurück zu allen Blog-Artikeln
          </a>
        </div>
      </footer>
    </div>
  </article>
</Layout>

<style is:global>
  .blog-prose {
    font-size: 1.125rem;
    color: var(--color-brand-paper);
  }

  .blog-prose h2 {
    font-family: var(--font-display, serif);
    font-size: 1.75rem;
    line-height: 1.25;
    font-weight: 700;
    color: var(--color-brand-paper);
    margin-top: 3.5rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-brand-paper) 15%, transparent);
    position: relative;
  }

  @media (min-width: 768px) {
    .blog-prose h2 {
      font-size: 2.25rem;
    }
  }

  .blog-prose h2::before {
    content: "";
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 60px;
    height: 2px;
    background: var(--color-brand-gold);
  }

  .blog-prose h3 {
    font-family: var(--font-display, serif);
    font-size: 1.35rem;
    line-height: 1.3;
    font-weight: 700;
    color: var(--color-brand-gold);
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
  }

  .blog-prose p {
    margin-bottom: 1.5rem;
    line-height: 1.8;
    color: color-mix(in srgb, var(--color-brand-paper) 88%, transparent);
  }

  .blog-prose ul {
    margin-top: 1rem;
    margin-bottom: 2rem;
    padding-left: 0;
    list-style-type: none;
  }

  .blog-prose ul li {
    position: relative;
    padding-left: 1.75rem;
    margin-bottom: 0.85rem;
    line-height: 1.7;
    color: color-mix(in srgb, var(--color-brand-paper) 88%, transparent);
  }

  .blog-prose ul li::before {
    content: "";
    position: absolute;
    left: 0.15rem;
    top: 0.65em;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 9999px;
    background: var(--color-brand-gold);
  }

  .blog-prose strong {
    color: var(--color-brand-paper);
    font-weight: 600;
  }

  .blog-prose hr {
    margin: 3.5rem 0;
    border: 0;
    height: 1px;
    background: color-mix(in srgb, var(--color-brand-paper) 18%, transparent);
  }

  .blog-prose a {
    color: var(--color-brand-gold);
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color 0.2s ease;
  }

  .blog-prose a:hover {
    color: var(--color-brand-gold-soft);
  }

  .blog-prose blockquote {
    background: var(--color-brand-surface);
    border-left: 4px solid var(--color-brand-gold);
    padding: 1.25rem 1.5rem;
    border-radius: 0 1rem 1rem 0;
    margin: 2.5rem 0;
    font-style: italic;
    color: var(--color-brand-paper);
  }
</style>
