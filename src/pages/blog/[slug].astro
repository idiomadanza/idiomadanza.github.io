---
import Layout from '../../layouts/Layout.astro';
import { type CollectionEntry, getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map((entry) => ({
    params: { slug: entry.id }, props: { entry },
  }));
}

type Props = {
  entry: CollectionEntry<'blog'>;
};

const { entry } = Astro.props;
const { Content } = await render(entry);

// Falls entry.data.image nur ein String ist, importieren wir es manuell
let finalImage = entry.data.image;

if (typeof finalImage === 'string') {
  const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*.{jpeg,jpg,png,gif,webp,avif}');
  const imagePath = finalImage.replace('../../assets/', '/src/assets/');
  
  if (images[imagePath]) {
    const mod = await images[imagePath]();
    finalImage = mod.default;
  }
}
---

<Layout title={`${entry.data.title} | Idiomadanza e.V.`} description={entry.data.excerpt}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": entry.data.title,
    "description": entry.data.excerpt,
    "datePublished": entry.data.date,
    "dateModified": entry.data.date,
    "author": {
      "@type": "Person",
      "name": entry.data.author || "Idiomadanza Vorstand"
    },
    "publisher": {
      "@type": "DanceSchool",
      "name": "Idiomadanza e.V.",
      "alternateName": "Idiomadanza Bachata & Salsa Regensburg"
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": `https://idiomadanza.de/blog/${entry.id}`
    },
    "image": entry.data.image ? `https://idiomadanza.de${entry.data.image}` : undefined,
    "keywords": entry.data.tags ? entry.data.tags.join(", ") : "Bachata, Salsa, Tanz, Regensburg"
  })} />
  <article class="py-12 md:py-20 bg-brand-light dark:bg-brand-dark min-h-screen">
    <div class="container mx-auto px-4 max-w-4xl">
      
      <!-- Back Link & Category -->
      <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
        <a href="/blog" class="inline-flex items-center gap-2 text-xs md:text-sm font-bold text-brand-rose hover:text-brand-glow transition-colors uppercase tracking-widest">
          <span>←</span> Zurück zur Blog-Übersicht
        </a>
        <span class="inline-block px-3.5 py-1 rounded-full bg-brand-rose/20 text-brand-rose text-xs font-bold uppercase tracking-widest border border-brand-rose/30">
          {entry.data.category || 'Tanz-Guide'}
        </span>
      </div>

      <!-- Article Header -->
      <header class="mb-10 md:mb-14">
        <h1 class="font-display text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-brand-dark dark:text-white leading-[1.15] mb-6 drop-shadow-sm">
          {entry.data.title}
        </h1>
        
        {entry.data.excerpt && (
          <p class="text-base sm:text-lg md:text-xl text-brand-dark/70 dark:text-white/70 leading-relaxed font-light mb-8 italic border-l-2 border-brand-glow pl-4">
            {entry.data.excerpt}
          </p>
        )}

        <!-- Meta Bar -->
        <div class="flex flex-wrap items-center gap-4 sm:gap-6 py-4 border-y border-brand-dark/10 dark:border-white/10 text-xs sm:text-sm text-brand-dark/60 dark:text-white/60">
          <div class="flex items-center gap-2">
            <span class="text-brand-rose">✍️</span>
            <span>{entry.data.author || 'Idiomadanza Vorstand'}</span>
          </div>
          <span class="opacity-30">•</span>
          <div class="flex items-center gap-2">
            <span class="text-brand-glow">📅</span>
            <span>{entry.data.date}</span>
          </div>
          <span class="opacity-30">•</span>
          <div class="flex items-center gap-2">
            <span>⏱️</span>
            <span>ca. 5 Min. Lesezeit</span>
          </div>
        </div>
      </header>

      <!-- Featured Image -->
      {finalImage && (
        <div class="relative h-[260px] sm:h-[380px] md:h-[480px] rounded-2xl md:rounded-3xl overflow-hidden shadow-glass border border-white/10 mb-14 group">
          <Image 
            src={finalImage} 
            alt={entry.data.title} 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" 
          />
          <div class="absolute inset-0 bg-gradient-to-t from-brand-dark/70 via-transparent to-transparent opacity-60"></div>
        </div>
      )}

      <!-- Main Editorial Content -->
      <div class="blog-prose leading-relaxed">
        <Content />
      </div>

      <!-- Bottom Author / CTA Box -->
      <footer class="mt-20 pt-12 border-t border-brand-dark/10 dark:border-white/10">
        <div class="p-8 md:p-12 rounded-3xl bg-white/70 dark:bg-white/5 backdrop-blur-xl border border-white/20 dark:border-white/10 shadow-glass text-center relative overflow-hidden">
          <div class="absolute -top-12 -right-12 w-48 h-48 bg-brand-rose/20 rounded-full blur-[80px]"></div>
          
          <div class="w-16 h-16 rounded-full bg-brand-rose/20 flex items-center justify-center text-3xl mx-auto mb-6 shadow-glow-rose">
            💃🕺
          </div>
          <h2 class="font-display text-2xl md:text-3xl font-bold dark:text-white mb-4">
            Lust bekommen, Bachata oder Salsa auszuprobieren?
          </h2>
          <p class="max-w-xl mx-auto text-sm md:text-base opacity-75 dark:text-white/70 mb-8 leading-relaxed">
            Komm einfach zu einer kostenlosen Schnupperstunde vorbei – egal ob dienstags im Fortuna oder mittwochs am Bahnhof. Kein Tanzpartner nötig!
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href="/kontakt" class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-brand-rose text-white font-bold shadow-glow-rose hover:-translate-y-0.5 hover:shadow-lg transition-all text-sm uppercase tracking-wider">
              Kostenlose Probestunde anfragen →
            </a>
            <a href="https://wa.me/+4915678659226?text=Hallo%20Idiomadanza,%20ich%20habe%20eine%20Frage%20zu%20den%20Kursen" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-white/10 dark:bg-white/10 hover:bg-white/20 border border-white/20 text-brand-dark dark:text-white font-bold transition-all text-sm uppercase tracking-wider flex items-center justify-center gap-2">
              <span>💬</span> WhatsApp Chat
            </a>
          </div>
        </div>

        <!-- Back Link -->
        <div class="mt-12 text-center">
          <a href="/blog" class="inline-flex items-center gap-2 text-sm font-bold text-brand-rose hover:text-brand-glow transition-colors">
            ← Zurück zu allen Blog-Artikeln
          </a>
        </div>
      </footer>

    </div>
  </article>
</Layout>

<style is:global>
  .blog-prose {
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.85);
  }
  
  .blog-prose h2 {
    font-family: var(--font-display, serif);
    font-size: 1.75rem;
    line-height: 1.25;
    font-weight: 700;
    color: #ffffff;
    margin-top: 3.5rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    position: relative;
  }
  
  @media (min-width: 768px) {
    .blog-prose h2 {
      font-size: 2.25rem;
    }
  }

  .blog-prose h2::before {
    content: "";
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 60px;
    height: 2px;
    background: var(--color-brand-rose, #8b5cf6);
  }
  
  .blog-prose h3 {
    font-family: var(--font-display, serif);
    font-size: 1.35rem;
    line-height: 1.3;
    font-weight: 700;
    color: var(--color-brand-rose, #8b5cf6);
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
  }
  
  .blog-prose p {
    margin-bottom: 1.5rem;
    line-height: 1.8;
  }
  
  .blog-prose ul {
    margin-top: 1rem;
    margin-bottom: 2rem;
    padding-left: 0;
    list-style-type: none;
  }
  
  .blog-prose ul li {
    position: relative;
    padding-left: 2rem;
    margin-bottom: 0.85rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.85);
  }
  
  .blog-prose ul li::before {
    content: "✓";
    position: absolute;
    left: 0.25rem;
    top: 0;
    color: var(--color-brand-glow, #fcd34d);
    font-weight: bold;
    font-size: 0.95rem;
  }
  
  .blog-prose strong {
    color: #ffffff;
    font-weight: 600;
  }
  
  .blog-prose hr {
    margin: 3.5rem 0;
    border: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  }
  
  .blog-prose a {
    color: var(--color-brand-rose, #8b5cf6);
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color 0.2s ease;
  }
  
  .blog-prose a:hover {
    color: var(--color-brand-glow, #fcd34d);
  }
  
  .blog-prose blockquote {
    background: rgba(255, 255, 255, 0.05);
    border-left: 4px solid var(--color-brand-glow, #fcd34d);
    padding: 1.25rem 1.5rem;
    border-radius: 0 1rem 1rem 0;
    margin: 2.5rem 0;
    font-style: italic;
    color: rgba(255, 255, 255, 0.95);
  }
</style>
