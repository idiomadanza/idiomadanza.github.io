---
import Layout from '../layouts/Layout.astro';
import trainersData from '../data/trainers.json';
import scheduleData from '../data/schedule.json';

// Trainer-Map für schnellen Lookup
const trainerMap: Record<string, { hourlyRate: number; active: boolean }> = {};
for (const t of trainersData) {
  trainerMap[t.id] = { hourlyRate: t.hourlyRate, active: t.active };
}

// Schedule nach Datum sortieren (kommende zuerst)
const today = new Date().toISOString().split('T')[0];
const sortedSchedule = [...scheduleData].sort((a, b) => 
  new Date(a.date).getTime() - new Date(b.date).getTime()
);

// Helper: formatiere Datum auf Deutsch
function formatDate(dateStr: string): string {
  const date = new Date(dateStr);
  return date.toLocaleDateString('de-DE', { 
    weekday: 'short', 
    day: '2-digit', 
    month: 'short', 
    year: 'numeric' 
  });
}

// Helper: Status-Badge Konfiguration
const statusConfig = {
  scheduled: { label: 'Geplant', color: 'text-sky-400', bg: 'bg-sky-500/20', border: 'border-sky-500/30' },
  performed: { label: 'Gehalten', color: 'text-emerald-400', bg: 'bg-emerald-500/20', border: 'border-emerald-500/30' },
  complete: { label: 'Abgerechnet', color: 'text-violet-400', bg: 'bg-violet-500/20', border: 'border-violet-500/30' },
};
---

<Layout
  title="Trainer-Plan | Idiomadanza e.V."
  description="Übersicht aller geplanten Tanzstunden – Bachata & Salsa in Regensburg."
>
  <section class="py-24 bg-brand-dark min-h-screen">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <h1 class="font-display text-4xl md:text-6xl font-bold text-white mb-4">
          Trainer-<span class="text-brand-rose">Plan</span>
        </h1>
        <p class="text-white/60 max-w-2xl mx-auto text-lg">
          Übersicht aller kommenden und vergangenen Tanzstunden.
          Trainer erscheinen aus Datenschutzgründen anonymisiert.
        </p>
      </div>

      <!-- Status-Legende -->
      <div class="flex flex-wrap justify-center gap-4 mb-12">
        {Object.entries(statusConfig).map(([key, cfg]) => (
          <div class={`inline-flex items-center gap-2 px-3 py-1.5 rounded-full ${cfg.bg} ${cfg.color} text-xs font-bold uppercase tracking-widest border ${cfg.border}`}>
            <span class="w-2 h-2 rounded-full bg-current"></span>
            {cfg.label}
          </div>
        ))}
      </div>

      <!-- Schedule Liste -->
      <div class="max-w-5xl mx-auto space-y-4">
        {sortedSchedule.map(entry => {
          const cfg = statusConfig[entry.status as keyof typeof statusConfig];
          const isPast = entry.date < today;
          return (
            <div class={`bg-white/5 backdrop-blur-xl border ${cfg.border} rounded-2xl p-6 shadow-glass hover:-translate-y-1 transition-all duration-300`}>
              <div class="grid grid-cols-1 md:grid-cols-[1fr_auto] gap-4 items-center">
                <!-- Datum + Kurs -->
                <div>
                  <div class="flex flex-wrap items-center gap-3 mb-2">
                    <span class={`inline-block px-2 py-0.5 rounded-full ${cfg.bg} ${cfg.color} text-[10px] font-bold uppercase tracking-widest border ${cfg.border}`}>
                      {cfg.label}
                    </span>
                    {isPast && entry.status === 'scheduled' && (
                      <span class="inline-block px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-400 text-[10px] font-bold uppercase tracking-widest border border-amber-500/30">
                        Überfällig
                      </span>
                    )}
                  </div>
                  <h3 class="text-xl font-display font-bold text-white mb-1">
                    {entry.course}
                  </h3>
                  <div class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-white/60">
                    <span>📅 {formatDate(entry.date)}</span>
                    <span>🕐 {entry.time} Uhr ({entry.duration}h)</span>
                    <span>📍 {entry.location}</span>
                    {entry.level && <span>📊 {entry.level}</span>}
                  </div>
                  {entry.notes && (
                    <p class="text-xs text-white/40 mt-2 italic">{entry.notes}</p>
                  )}
                </div>

                <!-- Trainer -->
                <div class="flex flex-wrap gap-2 md:justify-end">
                  {entry.trainerIds.map((tid: string) => {
                    const trainer = trainerMap[tid];
                    return (
                      <div class="bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-center min-w-[80px]">
                        <div class="text-xs text-white/40 uppercase tracking-widest mb-1">Trainer</div>
                        <div class="text-lg font-display font-bold text-brand-rose">{tid}</div>
                      </div>
                    );
                  })}
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <div class="mt-16 max-w-2xl mx-auto bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-6 text-center">
        <p class="text-white/60 text-sm">
          <strong class="text-brand-glow">Hinweis:</strong> Trainer werden aus Datenschutzgründen
          anonymisiert angezeigt. Die Zuordnung zu Klarnamen ist nur dem Vorstand bekannt und wird
          nicht veröffentlicht.
        </p>
      </div>
    </div>
  </section>
</Layout>