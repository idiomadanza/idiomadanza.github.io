---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---

<Layout 
  title="404 - Seite nicht gefunden | Idiomadanza e.V."
  description="Ups! Diese Seite scheint beim Tanzen verloren gegangen zu sein. Keine Sorge, wir führen dich zurück zur Tanzfläche."
>
  <section class="flex min-h-[80vh] items-center justify-center bg-brand-ink px-[clamp(20px,5vw,80px)] py-[clamp(48px,8vw,112px)]">
    <div class="mx-auto flex max-w-[900px] flex-col items-center gap-10 text-center">
      <div class="relative inline-flex items-center justify-center">
        <span aria-hidden="true" class="select-none font-display text-[clamp(120px,28vw,300px)] font-black leading-none text-brand-paper/5">404</span>
        <h1 class="absolute font-display text-[clamp(32px,5vw,64px)] font-extrabold leading-[1.05] tracking-[-0.03em] text-brand-paper">
          Oje! <span class="text-brand-gold">Takt</span> verloren?
        </h1>
      </div>

      <div class="flex flex-col gap-8 rounded-[36px] bg-brand-surface px-[clamp(24px,4vw,48px)] py-[clamp(24px,4vw,48px)]">
        <h2 class="text-[clamp(18px,1.7vw,22px)] font-normal leading-relaxed text-brand-paper/85">
          Es sieht so aus, als ob diese Seite im Getümmel der Tanzfläche verschwunden ist. <br class="hidden md:block" />
          Keine Panik – bei uns bleibt niemand allein am Rand stehen!
        </h2>

        <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a href="/" class="inline-flex min-h-[56px] items-center gap-2.5 rounded-full bg-brand-gold px-8 text-lg font-bold text-brand-ink transition-colors hover:bg-brand-gold-soft">
            Zurück zur Startseite
            <span aria-hidden="true">&rarr;</span>
          </a>
          <a href="/kurse/" class="inline-flex min-h-[56px] items-center rounded-full border-[1.5px] border-brand-paper/35 px-8 text-lg font-semibold text-brand-paper transition-colors hover:border-brand-gold hover:text-brand-gold">
            Kursplan ansehen
          </a>
        </div>

        <div class="flex justify-center pt-2">
          <Icon name="musik" size={40} strokeWidth={1.5} class="text-brand-gold" />
        </div>
      </div>
    </div>
  </section>
</Layout>
