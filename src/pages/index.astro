---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import HeroSection from '../components/blocks/HeroSection.astro';

// 1. Daten holen
const blogEntries = await getCollection('blog') || [];
const latestPost = blogEntries.length > 0 ? blogEntries[0] : null;

// 2. Workshops holen
const workshops = await getCollection('workshops') || [];
const latestWorkshops = workshops.slice(0, 2); // Die ersten zwei Workshops anzeigen

// 3. Testimonials laden
const testimonials = await getCollection('testimonials') || [];

// 4. Statische Bilder
import blogFallbackImg from '../assets/images/testimonials/bg.png';
import testimonialsBg from '../assets/images/testimonials/bg.png';
import carousel0 from '../assets/carousel-0.jpg';
import carousel1 from '../assets/carousel-1.jpg';
import carousel2 from '../assets/carousel-2.jpg';
import carousel3 from '../assets/carousel-3.jpg';

import ImageCarousel from '../components/ui/ImageCarousel.astro';

const carouselImages = [
  { src: carousel0, position: 'object-left md:object-[25%_center]' },
  { src: carousel1, position: 'object-center' },
  { src: carousel2, position: 'object-center' },
  { src: carousel3, position: 'object-center' }
];

// 5. JSON-LD Event-Schemas (Agentic SEO)
const siteUrl = 'https://idiomadanza.de';
const eventSchemas = latestWorkshops.map((w) => {
  const startDate = w.data.startDate;
  // endDate: 1 Tag Puffer (für mehrtägige Events)
  const start = new Date(startDate);
  const end = new Date(start);
  end.setDate(end.getDate() + 1);
  return {
    "@context": "https://schema.org",
    "@type": "Event",
    "name": w.data.title,
    "description": w.data.description || w.data.title,
    "startDate": start.toISOString(),
    "endDate": end.toISOString(),
    "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
    "eventStatus": "https://schema.org/EventScheduled",
    "location": {
      "@type": "Place",
      "name": w.data.location || "Idiomadanza e.V., Isarstr. 85, 93057 Regensburg",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Isarstr. 85",
        "addressLocality": "Regensburg",
        "postalCode": "93057",
        "addressCountry": "DE"
      }
    },
    "image": `${siteUrl}/images/og-default.png`,
    "organizer": {
      "@type": "Organization",
      "name": "Idiomadanza e.V.",
      "url": siteUrl
    },
    "offers": {
      "@type": "Offer",
      "price": w.data.price?.replace(/[^0-9.,]/g, '').replace(',', '.') || "0",
      "priceCurrency": "EUR",
      "url": w.data.ticketUrl || `${siteUrl}/workshops`,
      "availability": w.data.isSoldOut ? "https://schema.org/SoldOut" : "https://schema.org/InStock"
    }
  };
});
---

<Layout 
  title="Bachata & Salsa Regensburg | Idiomadanza e.V."
  description="Bachata und Salsa Tanzkurse in Regensburg. Idiomadanza e.V. – High-End Dance-Education meets Community Spirit. Jetzt Probestunde sichern!"
>
  {/* JSON-LD Event Schemas (Agentic SEO) */}
  {eventSchemas.map((schema) => (
    <Fragment slot="head">
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    </Fragment>
  ))}

  <HeroSection 
    title="Deine Sprache. Dein Rhythmus. Dein Verein."
    subtitle="Erlebe Bachata & Salsa in Regensburg. Höchste tänzerische Qualität trifft auf echte Gemeinschaft."
    ctaText="Kostenlose Probestunde"
    ctaHref="/kontakt"
  />

  {/* Quick-Info Banner */}
  <div class="relative z-20 -mt-10 px-4">
    <div class="max-w-4xl mx-auto bg-white/10 dark:bg-brand-dark/80 backdrop-blur-2xl p-6 rounded-2xl border border-white/20 shadow-glow-rose flex flex-col md:flex-row items-center gap-6 group text-white">
      <p class="font-medium flex items-center gap-2">
        <span class="text-brand-glow">🔥</span> <strong>NÄCHSTER START:</strong> 08. September 2026
      </p>
      <a href="/kurse" aria-label="Details zum nächsten Kursstart ansehen" class="text-white hover:text-brand-rose transition-colors text-xs font-bold uppercase tracking-widest flex items-center gap-2 whitespace-nowrap">
        Details ansehen →
      </a>
    </div>
  </div>

  {/* Aktuelles / Workshops */}
  <section class="py-24 bg-brand-light dark:bg-brand-dark/95">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
        {latestPost && (
          <a href={`/blog/${latestPost.id}`} class="group bg-white/70 dark:bg-brand-dark/50 border border-brand-dark/10 rounded-2xl overflow-hidden shadow-glass hover:shadow-glow-rose transition-all hover:-translate-y-2 flex flex-col h-full">
            <div class="aspect-video overflow-hidden relative">
              <Image src={blogFallbackImg} alt={latestPost.data.title} width={600} height={338} loading="lazy" decoding="async" class="w-full h-full object-cover" />
            </div>
            <div class="p-6 flex-grow">
              <h3 class="text-xl font-display font-bold text-brand-dark dark:text-white">{latestPost.data.title}</h3>
              <p class="text-sm opacity-70 mt-2 line-clamp-3">{latestPost.data.excerpt}</p>
            </div>
          </a>
        )}

        {latestWorkshops.map((workshop) => (
          <div class="group bg-white/70 dark:bg-brand-dark/50 border border-brand-dark/10 rounded-2xl overflow-hidden shadow-glass hover:shadow-glow-rose transition-all hover:-translate-y-2 flex flex-col h-full">
            
            {/* Bild mit Kategorie-Badge */}
            <div class="aspect-video overflow-hidden relative">
              <Image 
                src={workshop.data.image} 
                alt={workshop.data.title} 
                width={600}
                height={338}
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
              />
              <div class="absolute top-4 left-4 bg-brand-rose text-white text-[10px] font-bold uppercase px-3 py-1 rounded-full shadow-lg">
                Workshop
              </div>
            </div>

            {/* Content Bereich */}
            <div class="p-6 flex flex-col flex-grow">
              <h3 class="text-xl font-display font-bold text-brand-dark dark:text-white leading-tight mb-2">
                {workshop.data.title}
              </h3>
              
              <p class="text-sm opacity-70 mb-6 line-clamp-2 dark:text-white/70">
                {workshop.data.description}
              </p>

              {/* Info-Leiste (Datum & Preis) */}
              <div class="mt-auto pt-4 border-t border-brand-dark/5 dark:border-white/5 flex justify-between items-center">
                <div class="flex flex-col">
                  <span class="text-[9px] uppercase text-brand-rose font-bold tracking-widest">Datum</span>
                  <span class="text-xs font-medium dark:text-white">{workshop.data.date}</span>
                </div>
                <div class="text-right flex flex-col">
                  <span class="text-[9px] uppercase text-brand-rose font-bold tracking-widest">Preis</span>
                  <span class="text-sm font-display font-bold text-brand-dark dark:text-white">
                    {workshop.data.price}
                  </span>
                </div>
              </div>

              <a href="/workshops" class="mt-5 w-full text-center bg-brand-dark dark:bg-white/10 hover:bg-brand-rose dark:hover:bg-brand-rose text-white py-2.5 rounded-xl text-xs font-bold transition-all duration-300">
                Details & Anmeldung
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Team Collage Section */}
  <section class="py-24 bg-brand-dark/95 relative overflow-hidden">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-[1.2fr_0.8fr] gap-12 lg:gap-20 items-center max-w-7xl mx-auto">
        <div class="relative order-2 lg:order-1 group">
          <div class="absolute -top-10 -left-10 w-64 h-64 bg-brand-rose/10 rounded-full blur-[80px] -z-10"></div>
          <ImageCarousel 
            images={carouselImages} 
            alt="Idiomadanza Impressionen"
            class="rounded-2xl shadow-glow-rose transform hover:rotate-1 hover:scale-[1.01] transition-all duration-700 bg-white/5 border border-white/20 relative z-10 aspect-[16/10]"
          />
        </div>
        
        <div class="space-y-8 order-1 lg:order-2 text-white">
          <h2 class="font-display text-4xl md:text-5xl font-bold">Die <span class="text-brand-rose">Community</span> brennt</h2>
          <p class="text-lg opacity-80 leading-relaxed font-light">
            Hinter Idiomadanza steht ein Team aus leidenschaftlichen Tänzern, die Bachata und Salsa nicht nur unterrichten, sondern leben. Wir bringen die Energie direkt nach Regensburg.
          </p>
          <a href="/ueber-uns" class="group/btn inline-flex items-center gap-3 px-10 py-4 bg-brand-rose text-white rounded-full font-bold shadow-glow-rose hover:-translate-y-1 transition-all duration-300">
            Lerne das ganze Team kennen
            <span class="group-hover/btn:translate-x-1 transition-transform">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* Testimonials */}
  <section id="testimonials" class="relative py-32 overflow-hidden bg-brand-dark">
    <div class="absolute inset-0 z-0 opacity-20">
      <Image src={testimonialsBg} alt="Atmosphere" width={1920} height={1080} loading="lazy" decoding="async" class="w-full h-full object-cover" />
    </div>
    
    <div class="container mx-auto px-4 relative z-10">
      <div class="text-center mb-16">
        <h2 class="font-display text-4xl md:text-5xl font-bold text-white mb-4">Das sagen unsere <span class="text-brand-glow">Tänzer</span></h2>
        <div class="w-24 h-1 bg-brand-rose mx-auto rounded-full"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-7xl mx-auto">
        {testimonials.map((t) => (
          <div class="group bg-white/5 backdrop-blur-xl p-8 rounded-2xl border border-white/10 flex flex-col items-center text-center shadow-glass hover:border-brand-rose/50 transition-all duration-500 hover:-translate-y-2">
            <div class="w-20 h-20 mb-6 rounded-full border-4 border-brand-rose/30 group-hover:border-brand-rose overflow-hidden transition-colors shadow-glow-rose">
              <Image src={t.data.image} alt={t.data.name} width={80} height={80} loading="lazy" decoding="async" class="w-full h-full object-cover" />
            </div>
            
            <div class="flex gap-1 mb-4">
              {[...Array(t.data.rating)].map(() => (
                <span class="text-brand-glow text-xs">★</span>
              ))}
            </div>

            <p class="text-white/80 text-sm italic leading-relaxed mb-6 flex-grow">
              "{t.data.text}"
            </p>

            <div class="mt-auto">
              <p class="text-brand-rose font-bold uppercase tracking-widest text-[10px] mb-1">{t.data.name}</p>
              <p class="text-white/50 text-[9px] uppercase tracking-wider">{t.data.role}</p>
              
              {t.data.videoUrl && (
                <a href={t.data.videoUrl} target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex items-center gap-2 text-[10px] font-bold text-brand-glow hover:text-white transition-colors uppercase tracking-widest">
                  Video Message <span class="text-xs">▶</span>
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Kontakt */}
  <section id="fast-contact" class="py-24 bg-brand-dark relative overflow-hidden text-white">
    <div class="container mx-auto px-4 max-w-2xl relative z-10 text-center">
      <h2 class="font-display text-4xl font-bold mb-8">Gratis <span class="text-brand-glow">Probestunde</span></h2>
      <form 
        name="home-probestunde" 
        method="POST" 
        data-netlify="true" 
        netlify-honeypot="bot-field"
        class="space-y-4"
      >
        <p class="hidden">
          <label>Don’t fill this out if you’re human: <input name="bot-field" /></label>
        </p>
        <input type="hidden" name="form-name" value="home-probestunde" />
        
        <label for="home-name" class="block text-xs uppercase tracking-widest text-brand-glow mb-1 text-left">Dein Name</label>
        <input id="home-name" type="text" name="name" required placeholder="Max Mustermann" class="w-full bg-white/10 border border-white/20 rounded-xl px-6 py-4 outline-none focus:ring-2 focus:ring-brand-rose focus:border-transparent transition-colors">
        <label for="home-email" class="block text-xs uppercase tracking-widest text-brand-glow mb-1 mt-2 text-left">E-Mail Adresse</label>
        <input id="home-email" type="email" name="email" required placeholder="max@beispiel.de" class="w-full bg-white/10 border border-white/20 rounded-xl px-6 py-4 outline-none focus:ring-2 focus:ring-brand-rose focus:border-transparent transition-colors">
        <button type="submit" class="w-full bg-brand-rose py-4 rounded-xl font-bold shadow-glow-rose hover:-translate-y-1 focus:outline-none focus:ring-2 focus:ring-brand-rose focus:ring-offset-2 focus:ring-offset-brand-dark transition-all">Anfrage senden</button>
      </form>
    </div>
  </section>
</Layout>