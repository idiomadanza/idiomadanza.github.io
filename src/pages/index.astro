---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const blogEntries = await getCollection('blog');
const latestPost = blogEntries.length > 0 ? blogEntries[0] : null; // Simulating simple latest post sorting for now

const siteUrl = "https://idiomadanza.de";

const reviewSchema = {
  "@context": "https://schema.org",
  "@type": "DanceSchool",
  "name": "Idiomadanza e.V.",
  "url": siteUrl,
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5",
    "bestRating": "5",
    "ratingCount": "4",
    "reviewCount": "4"
  },
  "review": [
    {
      "@type": "Review",
      "author": { "@type": "Person", "name": "Melanie K." },
      "reviewRating": { "@type": "Rating", "ratingValue": "5" },
      "reviewBody": "Vielen lieben Dank für die tollen Unterrichtsstunden und die super Social Tänze! Macht immer viel Spaß, weiter so!"
    },
    {
      "@type": "Review",
      "author": { "@type": "Person", "name": "Sarah M." },
      "reviewRating": { "@type": "Rating", "ratingValue": "5" },
      "reviewBody": "Ich liebe die Energie beim Training. Man lernt nicht nur Schritte, sondern fühlt die Musik. Ein toller Verein mit Herz!"
    },
    {
      "@type": "Review",
      "author": { "@type": "Person", "name": "Lukas S." },
      "reviewRating": { "@type": "Rating", "ratingValue": "5" },
      "reviewBody": "Die Atmosphäre im Verein ist einfach einzigartig. Man fühlt sich sofort willkommen und lernt unglaublich schnell. Beste Entscheidung!"
    },
    {
      "@type": "Review",
      "author": { "@type": "Person", "name": "Daniel R." },
      "reviewRating": { "@type": "Rating", "ratingValue": "5" },
      "reviewBody": "Hervorragende Trainer, die auf Details achten. Mein Tanzen hat sich in kürzester Zeit massiv verbessert. Danke Idiomadanza!"
    }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Brauche ich einen Tanzpartner in Regensburg?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nein! In unseren Kursen wird regelmäßig durchgewechselt (Rotation). So kommt jeder zum Tanzen und du lernst schnell die Salsa- und Bachata-Community in Regensburg kennen."
      }
    },
    {
      "@type": "Question",
      "name": "Wann finden Socials und Partys in Regensburg statt?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Wir veranstalten regelmäßig eigene Idiomadanza Socials (Tanzabende). Zudem besuchen wir als Community oft die bekannten Events in Regensburg (z.B. mittwochs ins SCALA). Aktuelle Termine findest du in unseren Kursen."
      }
    },
    {
      "@type": "Question",
      "name": "Welches Level bin ich?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Wenn du komplett neu bist, starte in unseren Bachata oder Salsa 'Foundations' Kursen. Wenn du bereits Figuren sicher tanzen kannst und Taktgefühl besitzt, sprechen unsere Trainer gerne eine ehrliche Einschätzung mit dir vor Ort ab."
      }
    },
    {
      "@type": "Question",
      "name": "Wann findet der nächste Anfängerkurs statt?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Unsere speziellen Foundations-Kurse für absolute Anfänger in Regensburg starten zyklisch. Einen Überblick über unsere nächsten Starttermine findest du immer topaktuell auf unserer News- und Kursseite."
      }
    },
    {
      "@type": "Question",
      "name": "Kann ich jederzeit einsteigen?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "In laufende Anfängerkurse ist ein späterer Einstieg oft schwierig, da die Basis-Elemente aufeinander aufbauen. In unseren offenen Mittelstufe-/Fortgeschrittenen-Kursen ist ein Einstieg nach Absprache jedoch jederzeit möglich."
      }
    },
    {
      "@type": "Question",
      "name": "Wie melde ich mich zu einer Schnupperstunde an?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sehr simpel über unser Kontaktformular! Schreibe uns einfach, für welchen Kurs du dich interessierst. Für neue Gesichter in der Regensburger Bachata- und Salsaszene ist die erste Schnupperstunde bei uns kostenlos."
      }
    }
  ]
};
---

<Layout 
  title="Idiomadanza e.V. | Bachata & Salsa Tanzkurse in Regensburg"
  description="Bachata und Salsa lernen in Regensburg: Idiomadanza e.V. bietet wöchentliche Kurse für Anfänger bis Fortgeschrittene, Workshops und Socials. Jetzt kostenlose Probestunde sichern!"
>
  <!-- Review Schema for Agentic SEO -->
  <script type="application/ld+json" set:html={JSON.stringify(reviewSchema)} />
  <!-- FAQ Schema for Answer Engine Optimization -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- HERO SECTION -->
  <section id="hero" class="relative min-h-screen flex items-center justify-center overflow-hidden bg-brand-dark text-white">
    <!-- Background Gradient Glows -->
    <div class="absolute top-1/4 left-1/4 w-[500px] h-[500px] bg-brand-rose/30 rounded-full blur-[120px] -z-10"></div>
    <div class="absolute bottom-1/4 right-1/4 w-[500px] h-[500px] bg-brand-glow/20 rounded-full blur-[120px] -z-10"></div>
    
    <div class="container mx-auto px-4 text-center z-10 mt-16">
      <div class="inline-block py-2 px-6 rounded-full bg-brand-rose/20 text-brand-rose text-sm font-bold tracking-widest uppercase mb-8 backdrop-blur-md border border-brand-rose/30 animate-pulse">
        Nächster Anfängerkurs: 05. Mai 2026
      </div>
      <h1 class="font-display text-5xl md:text-7xl font-bold mb-4 animate-fade-in-up">
        Willkommen bei <span class="text-brand-rose">Idioma</span>danza
      </h1>
      <p class="text-lg md:text-xl font-medium text-brand-rose mb-8 animate-fade-in-up tracking-wide" style="animation-delay: 0.1s;">
        Deine Sprache, dein Rhythmus, dein Verein.
      </p>
      <p class="text-xl md:text-2xl mb-10 max-w-2xl mx-auto opacity-90 animate-fade-in-up" style="animation-delay: 0.2s;">
        Die Sprache des Körpers – Ein Ausdruck deiner Persönlichkeit. Bachata & Salsa in Regensburg.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center animate-fade-in-up" style="animation-delay: 0.4s;">
        <a href="#about" class="px-8 py-4 bg-brand-rose text-white font-medium rounded-idioma shadow-glow-rose hover:scale-105 transition-transform duration-300">
          Entdecke unseren Verein
        </a>
        <a href="/kurse" class="px-8 py-4 bg-white/10 backdrop-blur-xs border border-white/20 font-medium rounded-idioma hover:bg-white/20 transition-all duration-300">
          Unser Kursangebot
        </a>
      </div>
    </div>
  </section>

  <!-- NEWS BANNER -->
  <div class="relative z-20 -mt-10 px-4">
    <div class="max-w-4xl mx-auto bg-white/10 dark:bg-brand-dark/80 backdrop-blur-2xl p-6 rounded-2xl border border-white/20 shadow-glow-rose flex flex-col md:flex-row items-center gap-6 group">
      <div class="flex items-center gap-3">
        <span class="relative flex h-3 w-3">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-rose opacity-75"></span>
          <span class="relative inline-flex rounded-full h-3 w-3 bg-brand-rose"></span>
        </span>
        <span class="text-brand-rose font-bold uppercase tracking-widest text-xs">Aktuelles:</span>
      </div>
      <div class="flex-grow space-y-2">
        <p class="text-white font-medium text-center md:text-left flex items-center gap-2">
          <span class="text-brand-glow">🔥</span> <strong>Nächster Bachata-Anfängerkurs:</strong> Di, 05.05.2026 um 20:00 Uhr
        </p>
        <p class="text-white/60 text-sm text-center md:text-left flex items-center gap-2">
          <span>ℹ️</span> MI 01.04.2026 18:15 Uhr Raum für Engagement Bachata Ladystyling mit Patricia
        </p>
      </div>
      <div class="h-px md:h-12 w-full md:w-px bg-white/10"></div>
      <a href="/kurse" class="text-white hover:text-brand-rose transition-colors text-xs font-bold uppercase tracking-widest flex items-center gap-2 whitespace-nowrap">
        Details ansehen
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" x2="19" y1="12" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </div>

  <!-- AKTUELLES / BLOG PUSH SECTION -->
  <section id="aktuelles" class="py-24 bg-brand-light dark:bg-brand-dark/95 relative border-b border-brand-dark/5 dark:border-white/5">
    <!-- Glow -->
    <div class="absolute -right-20 top-0 w-80 h-80 bg-brand-rose/5 rounded-full blur-[100px] -z-10 animate-float"></div>

    <div class="container mx-auto px-4">
      <div class="flex flex-col md:flex-row justify-between items-end mb-12">
        <div>
          <h2 class="font-display text-4xl font-bold text-brand-dark dark:text-brand-light mb-2">Aktuelle <span class="text-brand-rose">News & Events</span></h2>
          <p class="opacity-80 dark:text-brand-light">Das Neueste aus der Regensburger Tanzszene und unserem Verein.</p>
        </div>
        <a href="/blog" class="hidden md:inline-flex mt-4 md:mt-0 px-6 py-2 bg-white/10 dark:bg-brand-dark/50 backdrop-blur-md rounded-full border border-brand-dark/10 dark:border-white/20 text-xs font-bold uppercase tracking-widest hover:text-brand-rose transition-colors duration-300">
          Alle Beiträge →
        </a>
      </div>

      <div class="grid grid-cols-1 max-w-sm mx-auto gap-8">
        {latestPost && (
          <!-- Post 1 (Dynamic) -->
          <a href={`/blog/${latestPost.id}`} class="group bg-white/70 dark:bg-brand-dark/50 backdrop-blur-md border border-brand-dark/10 dark:border-white/10 rounded-idioma overflow-hidden shadow-glass hover:shadow-glow-rose transition-all hover:-translate-y-2 duration-300 flex flex-col h-full">
            <div class="h-48 overflow-hidden relative">
              <img src={latestPost.data.image} alt={latestPost.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
              <div class="absolute top-4 left-4">
                <span class="px-3 py-1 bg-brand-rose text-white text-[10px] font-bold uppercase tracking-widest rounded-full shadow-lg">{latestPost.data.category}</span>
              </div>
            </div>
            <div class="p-6 flex-grow flex flex-col">
              <p class="text-xs text-brand-rose font-bold mb-2">{latestPost.data.date}</p>
              <h4 class="text-xl font-display font-bold text-brand-dark dark:text-brand-light mb-3 group-hover:text-brand-rose transition-colors">{latestPost.data.title}</h4>
              <p class="text-sm opacity-70 flex-grow mb-4">{latestPost.data.excerpt}</p>
              <span class="text-xs font-bold uppercase tracking-widest mt-auto opacity-50 group-hover:opacity-100 transition-opacity">Lesen →</span>
            </div>
          </a>
        )}
      </div>
      <div class="mt-8 text-center md:hidden">
        <a href="/blog" class="inline-flex px-8 py-3 bg-white/10 dark:bg-brand-dark/50 backdrop-blur-md rounded-full border border-brand-dark/10 dark:border-white/20 text-xs font-bold uppercase tracking-widest hover:text-brand-rose transition-colors duration-300">
          Alle Beiträge ansehen
        </a>
      </div>
    </div>
  </section>

  <!-- ABOUT SECTION -->
  <section id="about" class="py-20 bg-brand-light dark:bg-brand-dark">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="font-display text-4xl md:text-5xl font-bold text-brand-dark dark:text-brand-light mb-4">Über <span class="text-brand-rose">Idiomadanza</span></h2>
        <div class="w-24 h-1 bg-brand-glow mx-auto rounded-full"></div>
      </div>
      
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="rounded-idioma overflow-hidden shadow-glass relative group aspect-square">
          <img src="/images/about/about-bg.png" alt="Bachata Community" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-700">
          <div class="absolute inset-0 bg-brand-dark/40 group-hover:bg-brand-dark/20 transition-colors duration-500 z-10 flex items-center justify-center p-12">
            <p class="text-2xl md:text-3xl font-display text-white text-center italic z-20 drop-shadow-2xl">
              "Tanzen ist mehr als nur Bewegung. Es ist deine Sprache."
            </p>
          </div>
        </div>
        <div class="space-y-6 text-brand-dark dark:text-brand-light">
          <h3 class="text-3xl font-display font-bold">Mehr als nur Schritte</h3>
          <p>"Idioma" bedeutet Sprache, und "Danza" bedeutet Tanz. Zusammen bilden sie IdiomaDanza, eine Hommage an die kraftvolle Verbindung zwischen Ausdruck und Bewegung.</p>
          <p>Jeder Mensch hat eine einzigartige Art, sich zu bewegen und auszudrücken. Ob Anfänger oder erfahrener Tänzer, bei uns findest du einen Ort, an dem du deine persönliche Note im Tanz entdecken kannst.</p>
          <ul class="space-y-3 mt-6">
            <li class="flex items-center gap-3"><span class="text-brand-rose font-bold text-xl">✓</span> Smoothes Leading & Following</li>
            <li class="flex items-center gap-3"><span class="text-brand-rose font-bold text-xl">✓</span> Musikalische Struktur und Theorie</li>
            <li class="flex items-center gap-3"><span class="text-brand-rose font-bold text-xl">✓</span> Styling und Ausdruck</li>
            <li class="flex items-center gap-3"><span class="text-brand-rose font-bold text-xl">✓</span> Spaß auf der Tanzfläche (Social Dance)</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- TEAM SECTION -->
  <section id="team" class="py-24 bg-brand-light dark:bg-brand-dark/95 relative overflow-hidden">
    <!-- Background Accents -->
    <div class="absolute -left-20 top-20 w-96 h-96 bg-brand-rose/10 rounded-full blur-[120px] -z-10 animate-float"></div>
    <div class="absolute -right-20 bottom-20 w-96 h-96 bg-brand-glow/10 rounded-full blur-[120px] -z-10 animate-pulse-glow"></div>

    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="font-display text-4xl md:text-5xl font-bold text-brand-dark dark:text-brand-light mb-4">Unser <span class="text-brand-rose">Team</span></h2>
        <div class="w-24 h-1 bg-brand-glow mx-auto rounded-full"></div>
      </div>

      <div class="max-w-5xl mx-auto">
        <div class="relative group rounded-idioma overflow-hidden shadow-glow-rose border border-white/20">
          <div class="aspect-[16/9] md:aspect-[21/9] bg-brand-dark overflow-hidden relative">
            <!-- Team Collage Grid -->
            <div class="absolute inset-0 w-full h-full grid grid-cols-2 md:grid-cols-3 gap-1 bg-brand-dark group-hover:scale-105 transition-transform duration-[1500ms]">
              <div class="overflow-hidden relative"><img src="/images/team/patricia.png" alt="Patricia" class="w-full h-full object-cover grayscale group-hover:grayscale-0 opacity-60 group-hover:opacity-100 transition-all duration-700 object-top"></div>
              <div class="overflow-hidden relative"><img src="/images/team/stephan.png" alt="Stephan" class="w-full h-full object-cover grayscale group-hover:grayscale-0 opacity-60 group-hover:opacity-100 transition-all duration-700 object-top"></div>
              <div class="overflow-hidden relative"><img src="/images/team/chris_und_nalini.png" alt="Chris & Nalini" class="w-full h-full object-cover grayscale group-hover:grayscale-0 opacity-60 group-hover:opacity-100 transition-all duration-700 object-[center_10%]"></div>
              <div class="overflow-hidden relative"><img src="/images/team/pancho_und_anna.png" alt="Pancho & Anna" class="w-full h-full object-cover grayscale group-hover:grayscale-0 opacity-60 group-hover:opacity-100 transition-all duration-700 object-[center_30%]"></div>
              <div class="overflow-hidden relative"><img src="/images/team/sebastian.png" alt="Sebastian" class="w-full h-full object-cover grayscale group-hover:grayscale-0 opacity-60 group-hover:opacity-100 transition-all duration-700 object-top"></div>
              <div class="overflow-hidden relative"><img src="/images/team/silke.png" alt="Silke" class="w-full h-full object-cover grayscale group-hover:grayscale-0 opacity-60 group-hover:opacity-100 transition-all duration-700 object-top"></div>
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-brand-dark/95 via-brand-dark/40 to-transparent"></div>
            
            <!-- Overlay Content -->
            <div class="absolute bottom-0 left-0 p-8 md:p-12 space-y-4">
              <h3 class="text-3xl md:text-5xl font-display font-bold text-white">Das <span class="text-brand-rose">Team</span></h3>
              <p class="max-w-2xl text-white/80 text-lg leading-relaxed">
                Unsere 13 zertifizierten Trainer brennen darauf, ihre Leidenschaft für Bachata & Salsa mit dir zu teilen. Gemeinsam schaffen wir einen Ort, an dem du dich tänzerisch entfalten kannst.
              </p>
              <div class="pt-4 flex flex-wrap gap-4">
                <a href="/ueber-uns" class="px-8 py-3 bg-brand-rose text-white font-bold rounded-full shadow-glow-rose hover:-translate-y-1 transition-all">Lerne uns kennen</a>
                <a href="https://instagram.com/idiomadanza" target="_blank" rel="noopener noreferrer" class="px-8 py-3 bg-white/10 backdrop-blur-md text-white font-bold rounded-full border border-white/20 hover:bg-white/20 transition-all flex items-center gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
                  Instagram
                </a>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Minor Note -->
        <p class="text-center mt-8 text-sm opacity-40 dark:text-white italic">
          Geführt von Patricia, Stephan, Chris & Nalini
        </p>
      </div>
    </div>
  </section>

  <!-- COURSES PREVIEW SECTION -->
  <section id="portfolio" class="py-20 bg-brand-light dark:bg-brand-dark relative z-10">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="font-display text-4xl md:text-5xl font-bold text-brand-dark dark:text-white mb-4">Unser <span class="text-brand-rose">Kursangebot</span></h2>
        <div class="w-24 h-1 bg-brand-glow mx-auto rounded-full"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Bachata Foundations -->
        <div class="group block bg-white/70 dark:bg-brand-dark/50 backdrop-blur-md border border-white/20 dark:border-white/10 rounded-idioma overflow-hidden shadow-glass hover:shadow-glow-rose transition-all">
          <div class="h-48 bg-brand-dark relative overflow-hidden flex items-center justify-center">
             <div class="absolute inset-0 bg-brand-rose/20 group-hover:bg-brand-rose/40 transition-colors z-10"></div>
             <span class="text-white/30 font-display text-4xl font-bold z-0">Bachata</span>
          </div>
          <div class="p-6">
            <h4 class="text-2xl font-bold font-display mb-2 text-brand-dark dark:text-brand-light">Bachata Foundations</h4>
            <p class="opacity-80">Lerne alle Sensual Elemente von Grund auf neu.</p>
          </div>
        </div>
        
        <!-- Bachata Combinations -->
        <div class="group block bg-white/70 dark:bg-brand-dark/50 backdrop-blur-md border border-white/20 dark:border-white/10 rounded-idioma overflow-hidden shadow-glass hover:shadow-glow-rose transition-all">
          <div class="h-48 bg-brand-dark relative overflow-hidden flex items-center justify-center">
             <div class="absolute inset-0 bg-brand-rose/20 group-hover:bg-brand-rose/40 transition-colors z-10"></div>
             <span class="text-white/30 font-display text-4xl font-bold z-0">Bachata</span>
          </div>
          <div class="p-6">
            <h4 class="text-2xl font-bold font-display mb-2 text-brand-dark dark:text-brand-light">Bachata Combinations</h4>
            <p class="opacity-80">Meister alle Figuren & Roots Dominican-Bachata für den Social Dance Floor.</p>
          </div>
        </div>

        <!-- Bachata Pro -->
        <div class="group block bg-white/70 dark:bg-brand-dark/50 backdrop-blur-md border border-white/20 dark:border-white/10 rounded-idioma overflow-hidden shadow-glass hover:shadow-glow-rose transition-all">
          <div class="h-48 bg-brand-dark relative overflow-hidden flex items-center justify-center">
             <div class="absolute inset-0 bg-brand-rose/30 group-hover:bg-brand-rose/50 transition-colors z-10"></div>
             <span class="text-white/30 font-display text-4xl font-bold z-0 font-bold italic">PRO</span>
          </div>
          <div class="p-6">
            <h4 class="text-2xl font-bold font-display mb-2 text-brand-dark dark:text-brand-light">Bachata Pro</h4>
            <p class="opacity-80">Fortgeschrittene Technik, BachaZouk & Social Competition (Jack and Jill) Coaching.</p>
          </div>
        </div>

        <!-- Bachata Influence -->
        <div class="group block bg-white/70 dark:bg-brand-dark/50 backdrop-blur-md border border-white/20 dark:border-white/10 rounded-idioma overflow-hidden shadow-glass hover:shadow-glow-rose transition-all">
          <div class="h-48 bg-brand-dark relative overflow-hidden flex items-center justify-center">
             <div class="absolute inset-0 bg-brand-rose/20 group-hover:bg-brand-rose/40 transition-colors z-10"></div>
             <span class="text-white/30 font-display text-4xl font-bold z-0">Style</span>
          </div>
          <div class="p-6">
            <h4 class="text-2xl font-bold font-display mb-2 text-brand-dark dark:text-brand-light">Bachata Influence</h4>
            <p class="opacity-80">Musicality, Styling & dein eigener Ausdruck.</p>
          </div>
        </div>

        <!-- Salsa All Styles -->
        <div class="group block bg-white/70 dark:bg-brand-dark/50 backdrop-blur-md border border-white/20 dark:border-white/10 rounded-idioma overflow-hidden shadow-glass hover:shadow-glow-amber transition-all">
          <div class="h-48 bg-brand-dark relative overflow-hidden flex items-center justify-center">
             <div class="absolute inset-0 bg-brand-glow/20 group-hover:bg-brand-glow/40 transition-colors z-10"></div>
             <span class="text-white/30 font-display text-4xl font-bold z-0">Salsa</span>
          </div>
          <div class="p-6">
            <h4 class="text-2xl font-bold font-display mb-2 text-brand-dark dark:text-brand-light">Salsa All Styles</h4>
            <p class="opacity-80">L.A. Style, Mambo, Cuban & Afro Elemente.</p>
          </div>
        </div>

      </div>
  </section>

  <!-- TESTIMONIALS SECTION -->
  <section id="testimonials" class="relative py-32 overflow-hidden">
    <!-- Background Image with Overlay -->
    <div class="absolute inset-0 z-0">
      <img src="/images/testimonials/bg.png" alt="Club Atmosphere" class="w-full h-full object-cover">
      <div class="absolute inset-0 bg-brand-dark/80 backdrop-blur-[2px]"></div>
    </div>

    <div class="container mx-auto px-4 relative z-10">
      <div class="text-center mb-16">
