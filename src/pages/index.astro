---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const blogEntries = await getCollection('blog');
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*.{jpeg,jpg,png,gif,webp}');

const latestPost = blogEntries[0];
let heroImg = null;

if (latestPost && typeof latestPost.data.image === 'string') {
  const path = latestPost.data.image.replace('../../assets/', '/src/assets/');
  if (images[path]) {
    const mod = await images[path]();
    heroImg = mod.default;
  }
}
---

<Layout title="Home | Idiomadanza">
  <section class="py-20 text-center">
    <h1 class="text-6xl font-bold mb-4">Idiomadanza</h1>
    <p class="text-xl opacity-60">Salsa & Bachata in Regensburg</p>
  </section>

  {latestPost && heroImg && (
    <section class="max-w-xl mx-auto p-4">
      <Image src={heroImg} alt="News" class="rounded-2xl" />
      <h2 class="text-2xl font-bold mt-4">{latestPost.data.title}</h2>
      <a href={`/blog/${latestPost.id}`} class="text-brand-rose mt-2 inline-block">Lesen →</a>
    </section>
  )}
</Layout>