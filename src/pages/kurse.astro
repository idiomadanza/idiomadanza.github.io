---
import Layout from '../layouts/Layout.astro';

const siteUrl = "https://idiomadanza.de";

const courseSchema = [
  {
    "@type": "Course",
    "name": "Bachata Pro",
    "description": "Fortgeschrittene Bachata-Technik, BachaZouk & Social Competition Coaching in Regensburg.",
    "provider": { "@type": "Organization", "name": "Idiomadanza e.V.", "url": siteUrl },
    "hasCourseInstance": {
      "@type": "CourseInstance",
      "courseSchedule": { "@type": "Schedule", "byDay": "Tuesday", "startTime": "18:00", "endTime": "19:00", "repeatFrequency": "P1W" },
      "location": { "@type": "Place", "name": "Fortuna", "address": { "@type": "PostalAddress", "addressLocality": "Regensburg", "addressCountry": "DE" } }
    },
    "audience": { "@type": "Audience", "audienceType": "Fortgeschrittene" }
  },
  {
    "@type": "Course",
    "name": "Bachata Combinations",
    "description": "Bachata Figuren-Kombinationen & Roots Dominican-Bachata für den Social Dance Floor in Regensburg.",
    "provider": { "@type": "Organization", "name": "Idiomadanza e.V.", "url": siteUrl },
    "hasCourseInstance": {
      "@type": "CourseInstance",
      "courseSchedule": { "@type": "Schedule", "byDay": "Tuesday", "startTime": "19:00", "endTime": "20:00", "repeatFrequency": "P1W" },
      "location": { "@type": "Place", "name": "Fortuna", "address": { "@type": "PostalAddress", "addressLocality": "Regensburg", "addressCountry": "DE" } }
    },
    "audience": { "@type": "Audience", "audienceType": "Mittelstufe" }
  },
  {
    "@type": "Course",
    "name": "Bachata Foundations",
    "description": "Bachata Sensual Grundlagen für Anfänger in Regensburg. Nächster Kursstart: 05. Mai 2026.",
    "provider": { "@type": "Organization", "name": "Idiomadanza e.V.", "url": siteUrl },
    "hasCourseInstance": {
      "@type": "CourseInstance",
      "courseSchedule": { "@type": "Schedule", "byDay": "Tuesday", "startTime": "20:00", "endTime": "21:00", "repeatFrequency": "P1W" },
      "location": { "@type": "Place", "name": "Fortuna", "address": { "@type": "PostalAddress", "addressLocality": "Regensburg", "addressCountry": "DE" } },
      "startDate": "2026-05-05"
    },
    "audience": { "@type": "Audience", "audienceType": "Anfänger" }
  },
  {
    "@type": "Course",
    "name": "Bachata Influence",
    "description": "Musicality, Styling & persönlicher Ausdruck für Bachata-Tänzer in Regensburg.",
    "provider": { "@type": "Organization", "name": "Idiomadanza e.V.", "url": siteUrl },
    "hasCourseInstance": {
      "@type": "CourseInstance",
      "courseSchedule": { "@type": "Schedule", "byDay": "Wednesday", "startTime": "18:00", "endTime": "19:30", "repeatFrequency": "P1W" },
      "location": { "@type": "Place", "name": "Raum für Engagement – Bahnhof", "address": { "@type": "PostalAddress", "addressLocality": "Regensburg", "addressCountry": "DE" } }
    }
  },
  {
    "@type": "Course",
    "name": "Salsa",
    "description": "Salsa Tanzkurs in Regensburg: L.A. Style, Mambo, Cuban & Afro Elemente für alle Level.",
    "provider": { "@type": "Organization", "name": "Idiomadanza e.V.", "url": siteUrl },
    "hasCourseInstance": {
      "@type": "CourseInstance",
      "courseSchedule": { "@type": "Schedule", "byDay": "Wednesday", "startTime": "19:30", "endTime": "21:00", "repeatFrequency": "P1W" },
      "location": { "@type": "Place", "name": "Raum für Engagement – Bahnhof", "address": { "@type": "PostalAddress", "addressLocality": "Regensburg", "addressCountry": "DE" } }
    },
    "audience": { "@type": "Audience", "audienceType": "Alle Level" }
  }
];
---

<Layout 
  title="Bachata & Salsa Kurse in Regensburg | Idiomadanza e.V."
  description="Wöchentliche Bachata und Salsa Tanzkurse in Regensburg: Dienstag und Mittwoch für alle Level – von Foundations bis Pro. Jetzt Kursplan ansehen!"
>
  <!-- Course Schema for Agentic SEO -->
  <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": courseSchema })} />

  <!-- HERO SECTION -->
  <section class="relative py-20 overflow-hidden bg-brand-dark">
    <div class="absolute inset-0 z-0">
      <img src="/images/testimonials/bg.png" alt="Courses Background" class="w-full h-full object-cover opacity-30 blur-sm">
      <div class="absolute inset-0 bg-gradient-to-b from-brand-dark/80 via-brand-dark/60 to-brand-dark"></div>
    </div>
    
    <div class="container mx-auto px-4 relative z-10 text-center">
      <h1 class="font-display text-5xl md:text-7xl font-bold text-white mb-6 drop-shadow-2xl">
        Reguläre <span class="text-brand-rose">Kurse</span>
      </h1>
      <p class="max-w-2xl mx-auto text-xl text-white/80 leading-relaxed font-light">
        Finde deinen Rhythmus. Entdecke unsere wöchentlichen Bachata und Salsa Kurse in Regensburg.
      </p>
    </div>
  </section>

  <!-- CONCEPT SECTION -->
  <section class="py-24 bg-brand-dark text-white relative overflow-hidden border-b border-white/5">
    <div class="container mx-auto px-4 relative z-10">
      <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
        <div class="space-y-8">
          <span class="text-brand-rose font-bold uppercase tracking-[0.3em] text-sm">Das Idioma Konzept</span>
          <h2 class="text-4xl md:text-6xl font-display font-bold leading-tight">Foundations & <br/><span class="text-brand-glow">Combinations</span></h2>
          <div class="space-y-6 text-lg opacity-80 leading-relaxed font-light">
            <p>
              Wir möchten mit unserem neuen Kurskonzept „Foundations & Combinations“ einen neuen Weg gehen, der jeden Tänzer anspricht – egal ob mit oder ohne Erfahrung.
            </p>
            <p class="italic text-brand-rose font-display text-2xl py-4 border-l-2 border-brand-rose/30 pl-8">
              „Build a strong foundation and you can reach even the most unthinkable heights“
            </p>
            <p>
              Dieses Motto beschreibt unseren Ansatz perfekt: Nur mit einer stabilen Grundlage können anspruchsvollere Kombinationen kreiert und sicher geführt werden. Selbst Profis arbeiten ständig an den Fundamentals. Dank der bewährten Methode von <strong>Korke & Judith</strong> (Creators von Bachata Sensual) vermitteln wir dir alle Elemente, um diesen Stil sicher zu meistern.
            </p>
          </div>
        </div>

        <div class="bg-white/5 backdrop-blur-2xl rounded-idioma p-10 border border-white/10 shadow-glow-rose">
          <h3 class="text-2xl font-bold mb-8 text-brand-glow">Inhalte im Fokus:</h3>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {[
              "Smoothes Leading & Following",
              "Weiche Transitions",
              "Musikalische Struktur",
              "Bachata Timing & Rhythmus",
              "Hits, Breaks & Akzente",
              "Styling & Ausdruck",
              "Bachata Footwork",
              "Improvisation (Social Dance)"
            ].map((item) => (
              <li class="flex items-center gap-4 text-sm font-medium">
                <span class="w-6 h-px bg-brand-rose"></span>
                {item}
              </li>
            ))}
          </ul>
          <div class="mt-12 pt-8 border-t border-white/10 text-center">
            <p class="text-brand-rose font-bold text-xl mb-2">Spaß auf der Tanzfläche</p>
            <p class="text-xs opacity-50 uppercase tracking-widest">Das ist unser oberstes Ziel für jeden Social Dance.</p>
          </div>
        </div>
      </div>
    </div>
    <!-- Decor -->
    <div class="absolute -top-24 -left-24 w-96 h-96 bg-brand-glow/5 rounded-full blur-[120px]"></div>
  </section>

  <!-- SCHEDULE SECTION -->
  <section class="py-24 bg-brand-light dark:bg-brand-dark relative overflow-hidden">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 max-w-6xl mx-auto">
        
        <!-- Tuesday -->
        <div class="space-y-8 animate-fade-in">
          <div class="flex items-center gap-4 mb-8">
            <div class="w-16 h-16 rounded-full bg-brand-rose/20 flex items-center justify-center text-brand-rose text-3xl shadow-glow-rose">
              📅
            </div>
            <div>
              <h2 class="text-3xl font-display font-bold dark:text-white">Dienstag</h2>
              <p class="text-brand-rose font-semibold tracking-widest uppercase text-xs">Location: Fortuna</p>
            </div>
          </div>

          <div class="space-y-4">
            <!-- 18:00: Bachata Pro -->
            <div class="group p-6 bg-white/70 dark:bg-white/5 backdrop-blur-md rounded-idioma border border-white/20 dark:border-white/10 shadow-glass hover:shadow-glow-rose transition-all duration-300">
              <div class="flex justify-between items-center">
                <div>
                  <span class="text-brand-rose font-bold text-xl block mb-1">18:00 Uhr</span>
                  <h3 class="text-2xl font-bold dark:text-white">Bachata Pro</h3>
                </div>
                <div class="hidden sm:block">
                   <span class="px-4 py-1 rounded-full bg-brand-glow/20 text-brand-glow text-xs font-bold uppercase tracking-widest">Fortgeschritten</span>
                </div>
              </div>
            </div>

            <!-- 19:00: Bachata Combinations -->
            <div class="group p-6 bg-white/70 dark:bg-white/5 backdrop-blur-md rounded-idioma border border-white/20 dark:border-white/10 shadow-glass hover:shadow-glow-rose transition-all duration-300">
              <div class="flex justify-between items-center">
                <div>
                  <span class="text-brand-rose font-bold text-xl block mb-1">19:00 Uhr</span>
                  <h3 class="text-2xl font-bold dark:text-white">Bachata Combinations</h3>
                </div>
                <div class="hidden sm:block">
                   <span class="px-4 py-1 rounded-full bg-brand-rose/20 text-brand-rose text-xs font-bold uppercase tracking-widest">Mittelstufe</span>
                </div>
              </div>
            </div>

            <!-- 20:00: Bachata Foundations -->
            <div class="group p-6 bg-white/70 dark:bg-white/5 backdrop-blur-md rounded-idioma border border-white/20 dark:border-white/10 shadow-glass hover:shadow-glow-rose transition-all duration-300 relative overflow-hidden">
              <!-- HIGHLIGHT RIBBON -->
              <div class="absolute top-0 right-0 bg-brand-rose text-white text-[10px] font-bold px-4 py-1.5 rounded-bl-lg tracking-widest uppercase animate-pulse">Nächster Start: 05. Mai 2026</div>
              
              <div class="flex justify-between items-center">
                <div>
                  <span class="text-brand-rose font-bold text-xl block mb-1">20:00 Uhr</span>
                  <h3 class="text-2xl font-bold dark:text-white">Bachata Foundations</h3>
                  <p class="text-sm opacity-60 mt-2 dark:text-white/60">Unser Anfängerkurs – perfekt für den Einstieg ohne Vorkenntnisse.</p>
                </div>
                <div class="hidden sm:block">
                   <span class="px-4 py-1 rounded-full bg-blue-500/20 text-blue-400 text-xs font-bold uppercase tracking-widest">Anfänger</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Wednesday -->
        <div class="space-y-8 animate-fade-in" style="animation-delay: 0.2s;">
          <div class="flex items-center gap-4 mb-8">
            <div class="w-16 h-16 rounded-full bg-brand-glow/20 flex items-center justify-center text-brand-glow text-3xl shadow-glow-amber">
              📅
            </div>
            <div>
              <h2 class="text-3xl font-display font-bold dark:text-white">Mittwoch</h2>
              <p class="text-brand-glow font-semibold tracking-widest uppercase text-xs">Location: Raum für Engagement – Bahnhof</p>
            </div>
          </div>

          <div class="space-y-4">
            <!-- 18:00: Bachata Influence -->
            <div class="group p-6 bg-white/70 dark:bg-white/5 backdrop-blur-md rounded-idioma border border-white/20 dark:border-white/10 shadow-glass hover:shadow-glow-amber transition-all duration-300">
              <div class="flex justify-between items-center">
                <div>
                  <span class="text-brand-glow font-bold text-xl block mb-1">18:00 Uhr</span>
                  <h3 class="text-2xl font-bold dark:text-white">Bachata Influence</h3>
                </div>
                <div class="hidden sm:block">
                   <span class="px-4 py-1 rounded-full bg-brand-rose/20 text-brand-rose text-xs font-bold uppercase tracking-widest">Specials</span>
                </div>
              </div>
            </div>

            <!-- 19:30: Salsa -->
            <div class="group p-6 bg-white/70 dark:bg-white/5 backdrop-blur-md rounded-idioma border border-white/20 dark:border-white/10 shadow-glass hover:shadow-glow-amber transition-all duration-300">
              <div class="flex justify-between items-center">
                <div>
                  <span class="text-brand-glow font-bold text-xl block mb-1">19:30 Uhr</span>
                  <h3 class="text-2xl font-bold dark:text-white">Salsa</h3>
                </div>
                <div class="hidden sm:block">
                   <span class="px-4 py-1 rounded-full bg-brand-glow/20 text-brand-glow text-xs font-bold uppercase tracking-widest">All Levels</span>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- CTA -->
      <div class="mt-24 text-center">
        <div class="p-12 bg-white/10 backdrop-blur-lg rounded-idioma border border-white/20 max-w-4xl mx-auto shadow-glow-rose">
          <h2 class="text-3xl font-display font-bold text-brand-rose mb-6">Lust auf eine Probestunde?</h2>
          <p class="text-lg opacity-80 mb-10 dark:text-white">Melde dich jetzt für deinen ersten Kurs an und werde Teil unserer Community.</p>
          <a href="/kontakt" class="inline-block py-4 px-10 bg-brand-rose text-white font-bold rounded-full shadow-glow-rose hover:scale-105 transition-all">Jetzt Platz sichern</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
