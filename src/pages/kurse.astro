---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

const workshopsDocs = await getCollection('workshops');
const workshops = workshopsDocs.map(doc => doc.data);

const siteUrl = "https://idiomadanza.de";

const courseSchema = [
  {
    "@type": "Course",
    "name": "Bachata Pro",
    "description": "Fortgeschrittene Bachata-Technik, BachaZouk & Social Competition Coaching in Regensburg.",
    "provider": { "@type": "Organization", "name": "Idiomadanza e.V.", "url": siteUrl },
    "hasCourseInstance": {
      "@type": "CourseInstance",
      "courseSchedule": { "@type": "Schedule", "byDay": "Tuesday", "startTime": "18:00", "endTime": "19:00", "repeatFrequency": "P1W" },
      "location": { "@type": "Place", "name": "Fortuna", "address": { "@type": "PostalAddress", "addressLocality": "Regensburg", "addressCountry": "DE" } }
    },
    "audience": { "@type": "Audience", "audienceType": "Fortgeschrittene" }
  },
  {
    "@type": "Course",
    "name": "Bachata Combinations",
    "description": "Bachata Figuren-Kombinationen & Roots Dominican-Bachata für den Social Dance Floor in Regensburg.",
    "provider": { "@type": "Organization", "name": "Idiomadanza e.V.", "url": siteUrl },
    "hasCourseInstance": {
      "@type": "CourseInstance",
      "courseSchedule": { "@type": "Schedule", "byDay": "Tuesday", "startTime": "19:00", "endTime": "20:00", "repeatFrequency": "P1W" },
      "location": { "@type": "Place", "name": "Fortuna", "address": { "@type": "PostalAddress", "addressLocality": "Regensburg", "addressCountry": "DE" } }
    },
    "audience": { "@type": "Audience", "audienceType": "Mittelstufe" }
  },
  {
    "@type": "Course",
    "name": "Bachata Foundations",
    "description": "Bachata Sensual Grundlagen für Anfänger in Regensburg. Wöchentlicher Kurs – Einstieg jederzeit möglich.",
    "provider": { "@type": "Organization", "name": "Idiomadanza e.V.", "url": siteUrl },
    "hasCourseInstance": {
      "@type": "CourseInstance",
      "courseSchedule": { "@type": "Schedule", "byDay": "Tuesday", "startTime": "20:00", "endTime": "21:00", "repeatFrequency": "P1W" },
      "location": { "@type": "Place", "name": "Fortuna", "address": { "@type": "PostalAddress", "addressLocality": "Regensburg", "addressCountry": "DE" } }
    },
    "audience": { "@type": "Audience", "audienceType": "Anfänger" }
  },
  {
    "@type": "Course",
    "name": "Bachata Influence 1",
    "description": "Bachata Influence 1 am Mittwoch von 18:00 bis 19:00 Uhr in Regensburg.",
    "provider": { "@type": "Organization", "name": "Idiomadanza e.V.", "url": siteUrl },
    "hasCourseInstance": {
      "@type": "CourseInstance",
      "courseSchedule": { "@type": "Schedule", "byDay": "Wednesday", "startTime": "18:00", "endTime": "19:00", "repeatFrequency": "P1W" },
      "location": { "@type": "Place", "name": "Raum für Engagement – Bahnhof", "address": { "@type": "PostalAddress", "addressLocality": "Regensburg", "addressCountry": "DE" } }
    }
  },
  {
    "@type": "Course",
    "name": "Bachata Influence 2",
    "description": "Bachata Influence 2 am Mittwoch von 19:00 bis 20:00 Uhr in Regensburg.",
    "provider": { "@type": "Organization", "name": "Idiomadanza e.V.", "url": siteUrl },
    "hasCourseInstance": {
      "@type": "CourseInstance",
      "courseSchedule": { "@type": "Schedule", "byDay": "Wednesday", "startTime": "19:00", "endTime": "20:00", "repeatFrequency": "P1W" },
      "location": { "@type": "Place", "name": "Raum für Engagement – Bahnhof", "address": { "@type": "PostalAddress", "addressLocality": "Regensburg", "addressCountry": "DE" } }
    }
  },
  {
    "@type": "Course",
    "name": "Salsa Combinations",
    "description": "Salsa Combinations am Mittwoch von 20:00 bis 21:00 Uhr in Regensburg.",
    "provider": { "@type": "Organization", "name": "Idiomadanza e.V.", "url": siteUrl },
    "hasCourseInstance": {
      "@type": "CourseInstance",
      "courseSchedule": { "@type": "Schedule", "byDay": "Wednesday", "startTime": "20:00", "endTime": "21:00", "repeatFrequency": "P1W" },
      "location": { "@type": "Place", "name": "Raum für Engagement – Bahnhof", "address": { "@type": "PostalAddress", "addressLocality": "Regensburg", "addressCountry": "DE" } }
    }
  },
  {
    "@type": "Course",
    "name": "Salsa Foundations",
    "description": "Salsa Foundations am Mittwoch von 21:00 bis 22:00 Uhr in Regensburg.",
    "provider": { "@type": "Organization", "name": "Idiomadanza e.V.", "url": siteUrl },
    "hasCourseInstance": {
      "@type": "CourseInstance",
      "courseSchedule": { "@type": "Schedule", "byDay": "Wednesday", "startTime": "21:00", "endTime": "22:00", "repeatFrequency": "P1W" },
      "location": { "@type": "Place", "name": "Raum für Engagement – Bahnhof", "address": { "@type": "PostalAddress", "addressLocality": "Regensburg", "addressCountry": "DE" } }
    }
  }
];

const workshopSchema = workshops.map(w => ({
  "@type": "DanceEvent",
  "name": w.title,
  "description": w.description || w.title,
  "startDate": w.startDate,
  "location": { "@type": "Place", "name": w.location, "address": { "@type": "PostalAddress", "addressLocality": "Regensburg", "addressCountry": "DE" } },
  "organizer": { "@type": "Organization", "name": "Idiomadanza e.V.", "url": siteUrl },
  "performer": { "@type": "Person", "name": w.instructor }
}));
---

<Layout 
  title="Bachata & Salsa Kurse in Regensburg | Idiomadanza e.V."
  description="Wöchentliche Bachata und Salsa Tanzkurse in Regensburg: Dienstag und Mittwoch für alle Level – von Foundations bis Pro. Jetzt Kursplan ansehen!"
>
  <!-- Course & Workshop Schema for Agentic SEO -->
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": [...courseSchema, ...workshopSchema] })} />

  {/* HERO */}
  <section class="bg-brand-ink px-[clamp(20px,5vw,80px)] pb-[clamp(32px,4vw,56px)] pt-[clamp(40px,6vw,88px)]">
    <div class="mx-auto flex max-w-[1280px] flex-col gap-7">
      <p class="text-sm font-semibold uppercase tracking-[0.14em] text-brand-gold">Wöchentlich &middot; Dienstag und Mittwoch</p>
      <h1 class="font-display text-[clamp(42px,6.8vw,96px)] font-extrabold leading-[0.94] tracking-[-0.03em] text-brand-paper">
        Reguläre <span class="text-brand-gold">Kurse</span>
      </h1>
      <p class="max-w-[42ch] text-[clamp(18px,1.6vw,22px)] text-brand-paper/85">
        Finde deinen Rhythmus. Entdecke unsere wöchentlichen Bachata und Salsa Kurse in Regensburg.
      </p>
    </div>
  </section>

  {/* KONZEPT */}
  <section class="bg-brand-surface px-[clamp(20px,5vw,80px)] py-[clamp(56px,8vw,112px)]">
    <div class="mx-auto grid max-w-[1280px] items-start gap-[clamp(32px,5vw,72px)] lg:grid-cols-[1.05fr_0.95fr]">
      <div class="flex flex-col gap-6">
        <p class="text-sm font-semibold uppercase tracking-[0.14em] text-brand-gold">Das Idioma Konzept</p>
        <h2 class="font-display text-[clamp(34px,4.4vw,60px)] font-extrabold leading-none tracking-[-0.025em] text-brand-paper">
          Foundations &amp;<br /><span class="text-brand-gold">Combinations</span>
        </h2>
        <div class="flex flex-col gap-6 text-[19px] text-brand-paper/85">
          <p>
            Wir möchten mit unserem neuen Kurskonzept „Foundations &amp; Combinations“ einen neuen Weg gehen, der jeden Tänzer anspricht – egal ob mit oder ohne Erfahrung.
          </p>
          <p class="border-l-2 border-brand-gold pl-6 font-display text-[clamp(20px,2.2vw,28px)] font-medium italic leading-[1.25] text-brand-paper">
            „Build a strong foundation and you can reach even the most unthinkable heights“
          </p>
          <p>
            Dieses Motto beschreibt unseren Ansatz perfekt: Nur mit einer stabilen Grundlage können anspruchsvollere Kombinationen kreiert und sicher geführt werden. Selbst Profis arbeiten ständig an den Fundamentals. Dank der bewährten Methode von <strong class="text-brand-paper">Korke &amp; Judith</strong> (Creators von Bachata Sensual) vermitteln wir dir alle Elemente, um diesen Stil sicher zu meistern.
          </p>
        </div>
      </div>

      <div class="flex flex-col gap-7 rounded-3xl bg-brand-ink px-[clamp(22px,3vw,36px)] py-[clamp(22px,3vw,36px)]">
        <h3 class="font-display text-2xl font-bold tracking-[-0.01em] text-brand-paper">Inhalte im Fokus:</h3>
        <ul class="grid list-none grid-cols-1 gap-x-6 gap-y-3.5 p-0 sm:grid-cols-2">
          {[
            "Smoothes Leading & Following",
            "Weiche Transitions",
            "Musikalische Struktur",
            "Bachata Timing & Rhythmus",
            "Hits, Breaks & Akzente",
            "Styling & Ausdruck",
            "Bachata Footwork",
            "Improvisation (Social Dance)"
          ].map((item) => (
            <li class="flex items-start gap-3 text-[15px] font-medium text-brand-paper">
              <span aria-hidden="true" class="mt-2 size-2.5 shrink-0 rounded-full bg-brand-gold"></span>
              {item}
            </li>
          ))}
        </ul>
        <div class="border-t border-brand-paper/15 pt-6">
          <p class="font-display text-xl font-bold text-brand-gold">Spaß auf der Tanzfläche</p>
          <p class="mt-1 text-sm text-brand-muted">Das ist unser oberstes Ziel für jeden Social Dance.</p>
        </div>
      </div>
    </div>
  </section>

  {/* KURSPLAN */}
  <section class="bg-brand-ink px-[clamp(20px,5vw,80px)] py-[clamp(56px,8vw,112px)]">
    <div class="mx-auto flex max-w-[1280px] flex-col gap-[clamp(32px,4vw,56px)]">
      <div class="flex flex-wrap items-end justify-between gap-5">
        <div class="flex max-w-[720px] flex-col gap-3.5">
          <p class="text-sm font-semibold uppercase tracking-[0.14em] text-brand-gold">Kursplan</p>
          <h2 class="font-display text-[clamp(34px,4.4vw,60px)] font-extrabold leading-none tracking-[-0.025em] text-brand-paper">Zwei Abende. Sieben Kurse.</h2>
        </div>
        <a href="/schedule/" class="inline-flex min-h-[44px] items-center gap-2 font-semibold text-brand-paper underline underline-offset-4 decoration-brand-paper/40 hover:text-brand-gold">
          Terminübersicht <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <div class="grid gap-6 lg:grid-cols-2">
        {/* Dienstag */}
        <div class="flex flex-col gap-2 rounded-3xl bg-brand-surface px-[clamp(22px,3vw,36px)] py-[clamp(22px,3vw,36px)]">
          <div class="flex flex-wrap items-baseline justify-between gap-2 pb-4">
            <h2 class="flex items-center gap-3 font-display text-[34px] font-extrabold tracking-[-0.02em] text-brand-paper">
              <Icon name="termin" size={26} strokeWidth={1.75} class="shrink-0 text-brand-gold" />
              Dienstag
            </h2>
            <p class="inline-flex items-center gap-1.5 text-[15px] text-brand-paper/80">
              <Icon name="ort" size={18} strokeWidth={1.75} class="shrink-0 text-brand-gold" />
              Location: Fortuna
            </p>
          </div>

          <div class="grid grid-cols-[74px_minmax(0,1fr)_auto] items-center gap-4 border-t border-brand-paper/15 py-[18px]">
            <span class="font-display text-2xl font-bold text-brand-gold">18:00</span>
            <div>
              <h3 class="text-[19px] font-bold text-brand-paper">Bachata Pro</h3>
              <div class="text-[15px] text-brand-muted">Fortgeschritten</div>
            </div>
          </div>
          <div class="grid grid-cols-[74px_minmax(0,1fr)_auto] items-center gap-4 border-t border-brand-paper/15 py-[18px]">
            <span class="font-display text-2xl font-bold text-brand-gold">19:00</span>
            <div>
              <h3 class="text-[19px] font-bold text-brand-paper">Bachata Combinations</h3>
              <div class="text-[15px] text-brand-muted">Mittelstufe</div>
            </div>
          </div>
          <div class="grid grid-cols-[74px_minmax(0,1fr)_auto] items-center gap-4 border-t border-brand-paper/15 py-[18px]">
            <span class="font-display text-2xl font-bold text-brand-gold">20:00</span>
            <div>
              <h3 class="text-[19px] font-bold text-brand-paper">Bachata Foundations</h3>
              <div class="text-[15px] text-brand-muted">Unser Anfängerkurs – perfekt für den Einstieg ohne Vorkenntnisse.</div>
            </div>
            <span class="hidden shrink-0 rounded-full bg-brand-gold px-3 py-1 text-xs font-bold uppercase tracking-[0.1em] text-brand-ink sm:inline-block">Einstieg jederzeit</span>
          </div>
        </div>

        {/* Mittwoch */}
        <div class="flex flex-col gap-2 rounded-3xl bg-brand-surface px-[clamp(22px,3vw,36px)] py-[clamp(22px,3vw,36px)]">
          <div class="flex flex-wrap items-baseline justify-between gap-2 pb-4">
            <h2 class="flex items-center gap-3 font-display text-[34px] font-extrabold tracking-[-0.02em] text-brand-paper">
              <Icon name="termin" size={26} strokeWidth={1.75} class="shrink-0 text-brand-gold" />
              Mittwoch
            </h2>
            <p class="inline-flex items-center gap-1.5 text-[15px] text-brand-paper/80">
              <Icon name="ort" size={18} strokeWidth={1.75} class="shrink-0 text-brand-gold" />
              Location: Raum für Engagement – Bahnhof
            </p>
          </div>

          <div class="grid grid-cols-[74px_minmax(0,1fr)_auto] items-center gap-4 border-t border-brand-paper/15 py-[18px]">
            <span class="font-display text-2xl font-bold text-brand-gold">18:00</span>
            <h3 class="text-[19px] font-bold text-brand-paper">Bachata Influence 1</h3>
          </div>
          <div class="grid grid-cols-[74px_minmax(0,1fr)_auto] items-center gap-4 border-t border-brand-paper/15 py-[18px]">
            <span class="font-display text-2xl font-bold text-brand-gold">19:00</span>
            <h3 class="text-[19px] font-bold text-brand-paper">Bachata Influence 2</h3>
          </div>
          <div class="grid grid-cols-[74px_minmax(0,1fr)_auto] items-center gap-4 border-t border-brand-paper/15 py-[18px]">
            <span class="font-display text-2xl font-bold text-brand-gold">20:00</span>
            <div>
              <h3 class="text-[19px] font-bold text-brand-paper">Salsa Combinations</h3>
              <div class="text-[15px] text-brand-muted">Salsa-Technik vertiefen – Kombinationen, Styling und Musicality.</div>
            </div>
            <span class="hidden shrink-0 rounded-full border border-brand-gold px-3 py-1 text-xs font-bold uppercase tracking-[0.1em] text-brand-gold sm:inline-block">Mittelstufe</span>
          </div>
          <div class="grid grid-cols-[74px_minmax(0,1fr)_auto] items-center gap-4 border-t border-brand-paper/15 py-[18px]">
            <span class="font-display text-2xl font-bold text-brand-gold">21:00</span>
            <div>
              <h3 class="text-[19px] font-bold text-brand-paper">Salsa Foundations</h3>
              <div class="text-[15px] text-brand-muted">Unser Anfängerkurs – Salsa-Grundlagen und Rhythmusgefühl ohne Vorkenntnisse.</div>
            </div>
            <span class="hidden shrink-0 rounded-full bg-brand-gold px-3 py-1 text-xs font-bold uppercase tracking-[0.1em] text-brand-ink sm:inline-block">Einstieg jederzeit</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* PREISE */}
  <section id="preise" class="bg-brand-surface px-[clamp(20px,5vw,80px)] py-[clamp(56px,8vw,112px)]">
    <div class="mx-auto flex max-w-[1280px] flex-col gap-[clamp(32px,4vw,56px)]">
      <div class="flex max-w-[820px] flex-col gap-3.5">
        <p class="text-sm font-semibold uppercase tracking-[0.14em] text-brand-gold">Mitgliedschaft</p>
        <h2 class="font-display text-[clamp(34px,4.4vw,60px)] font-extrabold leading-none tracking-[-0.025em] text-brand-paper">Mitgliedschaft &amp; Preise</h2>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        <article class="flex flex-col gap-6 rounded-3xl bg-brand-ink p-8">
          <div class="flex flex-col gap-2">
            <h3 class="font-display text-2xl font-bold tracking-[-0.01em] text-brand-paper">Ermäßigt</h3>
            <p class="text-xs font-bold uppercase tracking-[0.14em] text-brand-muted">Studierende / Azubis</p>
          </div>
          <p class="flex items-baseline gap-2">
            <span class="font-display text-[52px] font-extrabold leading-none tracking-[-0.02em] text-brand-gold">19€</span>
            <span class="text-[15px] text-brand-muted">/ Monat</span>
          </p>
          <ul class="flex list-none flex-col gap-3 p-0 text-[15px] text-brand-paper/90">
            <li class="flex items-start gap-3"><span aria-hidden="true" class="mt-2 size-2.5 shrink-0 rounded-full bg-brand-gold"></span>Alle Bachata &amp; Salsa Kurse</li>
            <li class="flex items-start gap-3"><span aria-hidden="true" class="mt-2 size-2.5 shrink-0 rounded-full bg-brand-gold"></span>Unlimitierter Kursbesuch</li>
            <li class="flex items-start gap-3"><span aria-hidden="true" class="mt-2 size-2.5 shrink-0 rounded-full bg-brand-gold"></span>Keine versteckten Kursgebühren</li>
          </ul>
          <a href="/mitglied-werden/" class="inline-flex min-h-[52px] w-full items-center justify-center rounded-full border-[1.5px] border-brand-paper/35 px-6 font-bold text-brand-paper transition-colors hover:border-brand-gold hover:text-brand-gold">Jetzt anmelden</a>
        </article>

        <article class="flex flex-col gap-6 rounded-3xl bg-brand-ink p-8 ring-[1.5px] ring-brand-gold">
          <div class="flex flex-col gap-2">
            <h3 class="font-display text-2xl font-bold tracking-[-0.01em] text-brand-paper">Regulär</h3>
            <p class="text-xs font-bold uppercase tracking-[0.14em] text-brand-muted">Erwachsene</p>
          </div>
          <p class="flex items-baseline gap-2">
            <span class="font-display text-[52px] font-extrabold leading-none tracking-[-0.02em] text-brand-gold">39€</span>
            <span class="text-[15px] text-brand-muted">/ Monat</span>
          </p>
          <ul class="flex list-none flex-col gap-3 p-0 text-[15px] text-brand-paper/90">
            <li class="flex items-start gap-3"><span aria-hidden="true" class="mt-2 size-2.5 shrink-0 rounded-full bg-brand-gold"></span>Alle Bachata &amp; Salsa Kurse</li>
            <li class="flex items-start gap-3"><span aria-hidden="true" class="mt-2 size-2.5 shrink-0 rounded-full bg-brand-gold"></span>Unlimitierter Kursbesuch</li>
            <li class="flex items-start gap-3"><span aria-hidden="true" class="mt-2 size-2.5 shrink-0 rounded-full bg-brand-gold"></span>Community-Events &amp; Socials</li>
          </ul>
          <a href="/mitglied-werden/" class="inline-flex min-h-[52px] w-full items-center justify-center rounded-full bg-brand-gold px-6 font-bold text-brand-ink transition-colors hover:bg-brand-gold-soft">Jetzt Mitglied werden</a>
        </article>
      </div>

      <p class="text-[15px] text-brand-muted">Aufnahmegebühr (einmalig): 11 € &middot; Mindestlaufzeit: 3 Monate, danach monatlich kündbar.</p>
    </div>
  </section>

  {/* CTA */}
  <section class="bg-brand-ink px-[clamp(20px,5vw,80px)] pb-[clamp(56px,8vw,112px)]">
    <div class="mx-auto flex max-w-[1280px] flex-col gap-[18px] rounded-[36px] bg-brand-gold px-[clamp(28px,5vw,72px)] py-[clamp(28px,5vw,72px)] text-brand-ink">
      <h2 class="font-display text-[clamp(32px,4.4vw,60px)] font-extrabold leading-[0.96] tracking-[-0.03em]">Noch Fragen offen?</h2>
      <p class="max-w-[44ch] text-[19px]">Wir beraten dich gerne persönlich. Schreib uns einfach!</p>
      <div class="flex flex-wrap items-center gap-5">
        <a href="/kontakt/" class="inline-flex min-h-[56px] items-center gap-2.5 rounded-full bg-brand-ink px-8 text-lg font-bold text-brand-paper transition-colors hover:bg-brand-surface">
          Kontakt aufnehmen
        </a>
      </div>
    </div>
  </section>
</Layout>
