---
import Layout from '../layouts/Layout.astro';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Muss ich einen Partner mitbringen?",
      "acceptedAnswer": { "@type": "Answer", "text": "Nein! In unseren Kursen wird regelmäßig gewechselt, sodass du auch solo voll auf deine Kosten kommst." }
    },
    {
      "@type": "Question",
      "name": "Brauche ich spezielle Tanzschuhe?",
      "acceptedAnswer": { "@type": "Answer", "text": "Für den Anfang genügen saubere Hallenschuhe oder Schuhe mit glatter Sohle. Später beraten wir dich gerne." }
    },
    {
      "@type": "Question",
      "name": "Was passiert in den Ferien?",
      "acceptedAnswer": { "@type": "Answer", "text": "In der Regel findet der Kursbetrieb durchgehend statt, außer an gesetzlichen Feiertagen." }
    },
    {
      "@type": "Question",
      "name": "Gibt es eine Kündigungsfrist?",
      "acceptedAnswer": { "@type": "Answer", "text": "Unsere Verträge haben faire Laufzeiten von 3 Monaten mit einer anschließenden monatlichen Kündbarkeit." }
    }
  ]
};
---

<Layout 
  title="Preise & Mitgliedschaft | Bachata & Salsa Verein Regensburg – Idiomadanza e.V."
  description="Faire Preise ab 19€/Monat für Bachata und Salsa Kurse in Regensburg. Studierende-Tarif, voller Zugang zu allen Kursen und kostenlose Probestunde."
>
  <!-- FAQ Schema for Agentic SEO -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- HERO SECTION -->
  <section class="relative py-24 md:py-32 overflow-hidden bg-brand-dark">
    <div class="absolute inset-0 z-0 text-white">
      <img src="/images/testimonials/bg.png" alt="Pricing Background" class="w-full h-full object-cover opacity-30">
      <div class="absolute inset-0 bg-gradient-to-b from-brand-dark/90 via-brand-dark/60 to-brand-dark"></div>
    </div>
    
    <div class="container mx-auto px-4 relative z-10 text-center">
      <span class="inline-block py-1 px-4 rounded-full bg-brand-rose/20 text-brand-rose text-sm font-bold tracking-widest uppercase mb-4 animate-fade-in backdrop-blur-sm border border-brand-rose/30">Transparent & Fair</span>
      <h1 class="font-display text-5xl md:text-7xl font-bold text-white mb-6 drop-shadow-2xl">Deine Investition in <span class="text-brand-rose">Dich</span></h1>
      <p class="max-w-2xl mx-auto text-xl text-white/80 leading-relaxed font-light">
        Tanzen ist eine Investition in deine Lebensfreude. Wähle das passende Modell für deine Bedürfnisse.
      </p>
    </div>
  </section>

  <!-- PRICING CARDS -->
  <section class="py-24 bg-brand-light dark:bg-brand-dark relative">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 max-w-5xl mx-auto">
        
        <!-- Student Membership -->
        <div class="group bg-white/70 dark:bg-brand-dark/50 backdrop-blur-xl p-12 rounded-idioma shadow-glass border border-white/20 dark:border-white/10 flex flex-col items-center hover:-translate-y-4 transition-all duration-500 relative overflow-hidden">
          <!-- Accent Glow -->
          <div class="absolute top-0 left-0 w-full h-2 bg-brand-glow"></div>
          
          <h2 class="text-3xl font-display font-bold mb-2 dark:text-white">Studierende</h2>
          <p class="text-sm opacity-50 mb-8 uppercase tracking-widest font-bold">Mit gültigem Nachweis</p>
          
          <div class="mb-10 text-center">
            <span class="text-6xl font-black text-brand-rose drop-shadow-glow-rose">19€</span>
            <span class="text-lg opacity-40 ml-2">/ Monat</span>
          </div>

          <ul class="space-y-4 mb-12 w-full max-w-xs">
            <li class="flex items-center gap-3 text-sm dark:text-brand-light">
              <span class="w-5 h-5 rounded-full bg-brand-glow/20 text-brand-glow flex items-center justify-center text-[10px]">✓</span>
              Alle Bachata & Salsa Kurse
            </li>
            <li class="flex items-center gap-3 text-sm dark:text-brand-light">
              <span class="w-5 h-5 rounded-full bg-brand-glow/20 text-brand-glow flex items-center justify-center text-[10px]">✓</span>
              Unlimitierter Kursbesuch
            </li>
            <li class="flex items-center gap-3 text-sm dark:text-brand-light">
              <span class="w-5 h-5 rounded-full bg-brand-glow/20 text-brand-glow flex items-center justify-center text-[10px]">✓</span>
              Vergünstigte Workshop-Tickets
            </li>
            <li class="flex items-center gap-3 text-sm dark:text-brand-light opacity-50 italic">
               <span class="w-5 h-5 rounded-full bg-brand-dark/10 dark:bg-white/10 flex items-center justify-center text-[10px]">!</span>
               Monatlich kündbar*
            </li>
          </ul>

          <a href="/kontakt" class="mt-auto w-full py-4 bg-brand-dark dark:bg-white text-white dark:text-brand-dark font-bold rounded-full hover:bg-brand-rose hover:text-white transition-all text-center shadow-lg">Starten</a>
        </div>

        <!-- Full Membership -->
        <div class="group bg-white/70 dark:bg-brand-dark/50 backdrop-blur-xl p-12 rounded-idioma shadow-glass border border-white/20 dark:border-white/10 flex flex-col items-center hover:-translate-y-4 transition-all duration-500 relative overflow-hidden">
          <!-- Accent Glow -->
          <div class="absolute top-0 left-0 w-full h-2 bg-brand-rose"></div>
          
          <h2 class="text-3xl font-display font-bold mb-2 dark:text-white">Erwachsene</h2>
          <p class="text-sm opacity-50 mb-8 uppercase tracking-widest font-bold">Mitgliedschaft</p>
          
          <div class="mb-10 text-center">
            <span class="text-6xl font-black text-brand-rose drop-shadow-glow-rose">39€</span>
            <span class="text-lg opacity-40 ml-2">/ Monat</span>
          </div>

          <ul class="space-y-4 mb-12 w-full max-w-xs">

            <li class="flex items-center gap-3 text-sm dark:text-brand-light">
              <span class="w-5 h-5 rounded-full bg-brand-rose/20 text-brand-rose flex items-center justify-center text-[10px]">✓</span>
              Alle Bachata & Salsa Kurse
            </li>
            <li class="flex items-center gap-3 text-sm dark:text-brand-light">
              <span class="w-5 h-5 rounded-full bg-brand-rose/20 text-brand-rose flex items-center justify-center text-[10px]">✓</span>
              Unlimitierter Kursbesuch
            </li>
            <li class="flex items-center gap-3 text-sm dark:text-brand-light">
              <span class="w-5 h-5 rounded-full bg-brand-rose/20 text-brand-rose flex items-center justify-center text-[10px]">✓</span>
              Vergünstigte Workshop-Tickets
            </li>
            <li class="flex items-center gap-3 text-sm dark:text-brand-light">
              <span class="w-5 h-5 rounded-full bg-brand-rose/20 text-brand-rose flex items-center justify-center text-[10px]">✓</span>
              Exklusive Member-Vorteile
            </li>
          </ul>

          <a href="/kontakt" class="mt-auto w-full py-4 bg-brand-rose text-white font-bold rounded-full shadow-glow-rose hover:bg-brand-dark transition-all text-center">Jetzt Mitglied werden</a>
        </div>

      </div>

      <!-- ADDITIONAL INFO -->
      <div class="mt-20 max-w-3xl mx-auto p-8 bg-brand-rose/5 border border-brand-rose/10 rounded-idioma text-center">
        <h4 class="font-bold mb-4 dark:text-white">Du bist dir noch unsicher?</h4>
        <p class="text-sm opacity-70 mb-6 dark:text-brand-light/70">Komm einfach vorbei und schnupper rein. Die erste Kursstunde ist für Neumitglieder immer kostenlos!</p>
        <div class="flex flex-wrap justify-center gap-8 text-xs font-bold uppercase tracking-widest opacity-50 dark:text-white">
          <span>Faire Kündigungsfristen</span>
          <span>Tanz-Community</span>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ PREVIEW -->
  <section class="py-24 bg-brand-dark text-white relative overflow-hidden">
    <div class="container mx-auto px-4 relative z-10">
      <h2 class="font-display text-4xl text-center mb-16">Häufige <span class="text-brand-glow">Fragen</span></h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 max-w-4xl mx-auto">
        <div>
          <h4 class="font-bold mb-3 text-brand-rose">Muss ich einen Partner mitbringen?</h4>
          <p class="opacity-60 text-sm leading-relaxed">Nein! In unseren Kursen wird regelmäßig gewechselt, sodass du auch solo voll auf deine Kosten kommst.</p>
        </div>
        <div>
          <h4 class="font-bold mb-3 text-brand-rose">Brauche ich spezielle Tanzschuhe?</h4>
          <p class="opacity-60 text-sm leading-relaxed">Für den Anfang genügen saubere Hallenschuhe oder Schuhe mit glatter Sohle. Später beraten wir dich gerne.</p>
        </div>
        <div>
          <h4 class="font-bold mb-3 text-brand-rose">Was passiert in den Ferien?</h4>
          <p class="opacity-60 text-sm leading-relaxed">In der Regel findet der Kursbetrieb durchgehend statt, außer an gesetzlichen Feiertagen.</p>
        </div>
        <div>
          <h4 class="font-bold mb-3 text-brand-rose">Gibt es eine Kündigungsfrist?</h4>
          <p class="opacity-60 text-sm leading-relaxed">Unsere Verträge haben faire Laufzeiten von 3 Monaten mit einer anschließenden monatlichen Kündbarkeit.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
