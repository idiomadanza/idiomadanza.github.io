---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import SafeMail from '../components/ui/SafeMail.astro';
import FAQAccordion from '../components/FAQAccordion.astro';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Kann ich eine kostenlose Probestunde machen?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ja! Bei Idiomadanza e.V. ist die erste Schnupperstunde (z. B. am Dienstag ab 20:00 Uhr) kostenlos. Eine kurze Anmeldung via WhatsApp oder Kontaktformular genügt." }
    },
    {
      "@type": "Question",
      "name": "Brauche ich einen Tanzpartner?",
      "acceptedAnswer": { "@type": "Answer", "text": "Nein. In unseren Kursen wird regelmäßig gewechselt. Du lernst so das Führen und Folgen viel effektiver. Du kannst allein, mit Freunden oder als Paar kommen." }
    },
    {
      "@type": "Question",
      "name": "Wie sind die Kündigungsfristen?",
      "acceptedAnswer": { "@type": "Answer", "text": "Unsere Mitgliedschaft hat eine Mindestlaufzeit von 3 Monaten. Danach ist sie flexibel monatlich kündbar." }
    }
  ]
};
---

<Layout 
  title="Kontakt & Anmeldung | Idiomadanza e.V. – Tanzverein Regensburg"
  description="Kontaktiere Idiomadanza e.V. in Regensburg: Probestunde anfragen, Mitglied werden oder Workshop-Infos erhalten. High-End Dance-Education meets Community Spirit."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  {/* HERO */}
  <section class="bg-brand-ink px-[clamp(20px,5vw,80px)] pb-[clamp(32px,4vw,56px)] pt-[clamp(40px,6vw,88px)]">
    <div class="mx-auto flex max-w-[1280px] flex-col gap-7">
      <p class="text-sm font-semibold uppercase tracking-[0.14em] text-brand-gold">Kontakt &amp; Anmeldung</p>
      <h1 class="font-display text-[clamp(42px,6.8vw,96px)] font-extrabold leading-[0.94] tracking-[-0.03em] text-brand-paper">
        Sag <span class="text-brand-gold">Hola!</span>
      </h1>
      <p class="max-w-[44ch] text-[clamp(18px,1.6vw,22px)] text-brand-paper/85">
        Wir freuen uns darauf, von dir zu hören. Egal ob Fragen zu Kursen, Probestunden oder Mitgliedschaft.
      </p>
    </div>
  </section>

  {/* FORMULAR + KONTAKTWEGE */}
  <section class="bg-brand-paper px-[clamp(20px,5vw,80px)] py-[clamp(56px,8vw,112px)] text-brand-ink">
    <div class="mx-auto flex max-w-[1280px] flex-col gap-[clamp(32px,4vw,56px)]">
      <div class="rounded-[36px] bg-white p-[clamp(24px,4vw,48px)]">
        <h2 class="mb-8 font-display text-[clamp(28px,3.2vw,40px)] font-extrabold tracking-[-0.025em]">Schreib uns eine Nachricht</h2>

        <form
          name="contact"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          action="/success"
          class="flex flex-col gap-6"
        >
          <p class="hidden">
            <label>Don’t fill this out if you’re human: <input name="bot-field" /></label>
          </p>
          <input type="hidden" name="form-name" value="contact" />

          <div class="grid gap-6 md:grid-cols-2">
            <div class="flex flex-col gap-2">
              <label for="name" class="text-xs font-bold uppercase tracking-[0.14em] text-brand-line">Name</label>
              <input type="text" id="name" name="name" required minlength="2" pattern=".{2,}" placeholder="Dein Name" class="min-h-[48px] w-full rounded-2xl border border-brand-line/40 bg-brand-paper px-4 py-3 text-brand-ink outline-none transition-colors focus:border-brand-rose focus:ring-2 focus:ring-brand-rose/40">
            </div>
            <div class="flex flex-col gap-2">
              <label for="email" class="text-xs font-bold uppercase tracking-[0.14em] text-brand-line">E-Mail</label>
              <input type="email" id="email" name="email" required placeholder="mail@example.com" pattern="^[^\s@]+@[^\s@]+\.[^\s@]+$" class="min-h-[48px] w-full rounded-2xl border border-brand-line/40 bg-brand-paper px-4 py-3 text-brand-ink outline-none transition-colors focus:border-brand-rose focus:ring-2 focus:ring-brand-rose/40">
            </div>
          </div>

          <div class="flex flex-col gap-2">
            <label for="interest" class="text-xs font-bold uppercase tracking-[0.14em] text-brand-line">Interesse</label>
            <select id="interest" name="interest" class="min-h-[48px] w-full appearance-none rounded-2xl border border-brand-line/40 bg-brand-paper px-4 py-3 text-brand-ink outline-none transition-colors focus:border-brand-rose focus:ring-2 focus:ring-brand-rose/40">
              <option value="probestunde">Probestunde anfragen</option>
              <option value="awareness">Security Awareness</option>
              <option value="frage">Allgemeine Frage</option>
              <option value="workshops">Workshop Infos</option>
            </select>
          </div>

          <div class="flex flex-col gap-2">
            <label for="message" class="text-xs font-bold uppercase tracking-[0.14em] text-brand-line">Nachricht</label>
            <textarea id="message" name="message" rows="4" required minlength="2" pattern=".{2,}" placeholder="Wie können wir dir helfen?" class="w-full rounded-2xl border border-brand-line/40 bg-brand-paper px-4 py-3 text-brand-ink outline-none transition-colors focus:border-brand-rose focus:ring-2 focus:ring-brand-rose/40"></textarea>
          </div>

          <div class="flex items-start gap-4">
            <input type="checkbox" id="privacy-consent" name="privacy-consent" required class="mt-1 size-5 shrink-0 cursor-pointer rounded border-brand-line/60 text-brand-rose focus:ring-2 focus:ring-brand-rose/40">
            <label for="privacy-consent" class="cursor-pointer select-none text-[15px] leading-relaxed text-brand-line">
              Ich habe die <a href="/datenschutz/" class="font-bold underline underline-offset-4 hover:text-brand-rose">Datenschutzerklärung</a> gelesen und bin damit einverstanden, dass meine eingegebenen Daten zum Zweck der Kontaktaufnahme gespeichert und verarbeitet werden. *
            </label>
          </div>

          <button type="submit" class="inline-flex min-h-[56px] w-full items-center justify-center rounded-full bg-brand-rose px-8 text-lg font-bold text-white transition-colors hover:bg-brand-rose-bright">Nachricht absenden</button>
        </form>
      </div>

      {/* Kontaktwege */}
      <div class="grid gap-6 border-t border-brand-line/25 pt-[clamp(32px,4vw,56px)] md:grid-cols-3">
        <div class="flex items-start gap-4">
          <div class="flex size-12 shrink-0 items-center justify-center rounded-full bg-brand-ink">
            <Icon name="ort" size={24} strokeWidth={1.75} class="text-brand-gold" />
          </div>
          <div>
            <h3 class="font-display text-xl font-bold tracking-[-0.01em]">Locations</h3>
            <p class="mt-1 text-[15px] text-brand-line">
              Dienstag: Fortuna, Regensburg<br />
              Mittwoch: Raum für Engagement, Regensburg
            </p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="flex size-12 shrink-0 items-center justify-center rounded-full bg-brand-ink">
            <Icon name="probestunde" size={24} strokeWidth={1.75} class="text-brand-gold" />
          </div>
          <div>
            <h3 class="font-display text-xl font-bold tracking-[-0.01em]">WhatsApp</h3>
            <a href="https://wa.me/+4915678659226?text=Hallo%20Idiomadanza,%20ich%20habe%20weitere%20Fragen%20zu%20..." class="mt-1 inline-flex min-h-[44px] items-center text-[15px] font-bold text-brand-rose underline underline-offset-4 hover:text-brand-rose-bright">
              Chat on WhatsApp
            </a>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="flex size-12 shrink-0 items-center justify-center rounded-full bg-brand-ink">
            <Icon name="aushang" size={24} strokeWidth={1.75} class="text-brand-gold" />
          </div>
          <div>
            <h3 class="font-display text-xl font-bold tracking-[-0.01em]">Email</h3>
            <SafeMail email="mail@idiomadanza.de" class="mt-1 inline-flex min-h-[44px] items-center text-[15px] font-bold text-brand-rose" />
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* STANDORTE */}
  <section class="bg-brand-surface px-[clamp(20px,5vw,80px)] py-[clamp(56px,8vw,112px)]">
    <div class="mx-auto flex max-w-[1280px] flex-col gap-[clamp(24px,3vw,40px)]">
      <div class="flex flex-wrap items-end justify-between gap-5">
        <div class="flex max-w-[720px] flex-col gap-3.5">
          <p class="text-sm font-semibold uppercase tracking-[0.14em] text-brand-gold">Anfahrt</p>
          <h2 class="font-display text-[clamp(34px,4.4vw,60px)] font-extrabold leading-none tracking-[-0.025em] text-brand-paper">Unsere Standorte</h2>
          <p class="text-[19px] text-brand-muted">Wir tanzen an zwei zentralen Orten in Regensburg.</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="https://www.google.com/maps/search/Isarstra%C3%9Fe+85+Regensburg" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-[44px] items-center rounded-full border-[1.5px] border-brand-paper/35 px-5 text-sm font-bold text-brand-paper transition-colors hover:border-brand-gold hover:text-brand-gold">Fortuna (Di)</a>
          <a href="https://www.google.com/maps/search/D.-Martin-Luther-Str.+19+Regensburg" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-[44px] items-center rounded-full border-[1.5px] border-brand-paper/35 px-5 text-sm font-bold text-brand-paper transition-colors hover:border-brand-gold hover:text-brand-gold">Raum für Engagement (Mi)</a>
        </div>
      </div>

      <div id="maps-placeholder" class="relative hidden h-[420px] items-center justify-center rounded-[36px] bg-brand-ink p-8 text-center">
        <div class="flex max-w-md flex-col items-center gap-4">
          <Icon name="ort" size={40} strokeWidth={1.75} class="text-brand-gold" />
          <h3 class="font-display text-2xl font-bold italic tracking-[-0.01em] text-brand-paper">Interaktive Karte deaktiviert</h3>
          <p class="text-[15px] text-brand-muted">
            Um unsere Standorte auf der Karte zu sehen, musst die Nutzung von **externen Medien** erlauben. Deine Privatsphäre ist uns wichtig!
          </p>
          <button id="map-enable" class="inline-flex min-h-[48px] items-center rounded-full bg-brand-gold px-6 font-bold text-brand-ink transition-colors hover:bg-brand-gold-soft">Karte laden &amp; Cookies akzeptieren</button>
        </div>
      </div>

      <div id="maps-iframe-container" class="relative hidden h-[420px] overflow-hidden rounded-[36px] bg-brand-ink">
        <iframe
          src="https://www.openstreetmap.org/export/embed.html?bbox=12.096%2C49.016%2C12.104%2C49.021&amp;layer=mapnik&amp;marker=loc_49.0187%2C12.1000"
          class="absolute inset-0 h-full w-full border-0"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer"
          title="Idiomadanza e.V. – Isarstraße 85, Regensburg"
        ></iframe>

        <div class="absolute bottom-6 left-6 hidden max-w-sm rounded-3xl bg-brand-ink/90 p-6 backdrop-blur-md md:block">
          <div class="mb-3 flex items-center gap-3">
            <Icon name="ort" size={22} strokeWidth={1.75} class="text-brand-gold" />
            <h3 class="font-display text-xl font-bold tracking-[-0.01em] text-brand-paper">Hauptstandort</h3>
          </div>
          <p class="text-sm font-bold text-brand-muted">Idiomadanza e.V.</p>
          <p class="mt-1 text-sm text-brand-muted">Isarstraße 85, 93057 Regensburg</p>
          <a href="https://www.google.com/maps/search/Isarstra%C3%9Fe+85+Regensburg" target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex min-h-[44px] items-center text-xs font-bold uppercase tracking-[0.14em] text-brand-gold underline underline-offset-4">Route berechnen &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  {/* FAQ */}
  <section class="bg-brand-ink px-[clamp(20px,5vw,80px)] pb-[clamp(56px,8vw,112px)]">
    <div class="mx-auto flex max-w-[900px] flex-col gap-[clamp(24px,3vw,40px)]">
      <div class="flex max-w-[720px] flex-col gap-3.5">
        <p class="text-sm font-semibold uppercase tracking-[0.14em] text-brand-gold">FAQ</p>
        <h2 class="font-display text-[clamp(34px,4.4vw,60px)] font-extrabold leading-none tracking-[-0.025em] text-brand-paper">Häufige Fragen</h2>
        <p class="text-[19px] text-brand-muted">Alles was du über den Einstieg bei Idiomadanza e.V. wissen musst.</p>
      </div>

      <div>
        <FAQAccordion
          question="Kann ich eine kostenlose Probestunde machen?"
          answer="Ja! Bei Idiomadanza e.V. ist die erste Schnupperstunde (z. B. am Dienstag ab 20:00 Uhr) kostenlos. Eine kurze Anmeldung via WhatsApp oder Kontaktformular genügt."
        />
        <FAQAccordion
          question="Brauche ich einen Tanzpartner?"
          answer="Nein. In unseren Kursen wird regelmäßig gewechselt. Du lernst so das Führen und Folgen viel effektiver. Du kannst allein, mit Freunden oder als Paar kommen."
        />
        <FAQAccordion
          question="Wie sind die Kündigungsfristen?"
          answer="Unsere Mitgliedschaft hat eine Mindestlaufzeit von 3 Monaten. Danach ist sie flexibel monatlich kündbar."
        />
        <FAQAccordion
          question="Welche Schuhe und Kleidung brauche ich?"
          answer="Bequeme Alltagskleidung ist ideal. Saubere Sneaker, Hallenschuhe oder Socken genügen. Wichtig: Keine Straßenschuhe auf der Tanzfläche!"
        />
        <FAQAccordion
          question="Muss ich Salsa können, um Bachata zu lernen?"
          answer="Nein. Bachata und Salsa sind eigenständige Tänze. Unsere Anfängerkurs erfordern keinerlei Vorkenntnisse."
        />
      </div>
    </div>
  </section>
  <script>
    function updateMap() {
      const placeholder = document.getElementById('maps-placeholder');
      const container = document.getElementById('maps-iframe-container');
      const banner = document.getElementById('cookie-banner');
      
      const saved = localStorage.getItem('idioma-cookie-consent');
      const settings = saved ? JSON.parse(saved) : null;

      if (settings && settings.maps) {
        placeholder?.classList.add('hidden');
        container?.classList.remove('hidden');
      } else {
        placeholder?.classList.remove('hidden');
        container?.classList.add('hidden');
      }
    }

    // Initial check
    updateMap();

    // Listen for enable button
    document.getElementById('map-enable')?.addEventListener('click', () => {
      const settings = {
        essential: true,
        maps: true,
        timestamp: new Date().getTime()
      };
      localStorage.setItem('idioma-cookie-consent', JSON.stringify(settings));
      window.location.reload(); // Reload to apply everywhere
    });

    // Re-check periodically or on storage changes
    window.addEventListener('storage', updateMap);
  </script>
</Layout>
