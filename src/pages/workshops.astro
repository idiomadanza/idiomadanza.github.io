---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Icon from '../components/Icon.astro';

import actionImg from '../assets/images/about/action.png';

const workshopsDocs = await getCollection('workshops');
const workshops = workshopsDocs.map(doc => doc.data);

const siteUrl = "https://idiomadanza.de";

const eventSchema = workshops.map(w => ({
  "@type": "Event",
  "name": w.title,
  "description": w.description,
  "startDate": w.date,
  "location": { "@type": "Place", "name": w.location, "address": { "@type": "PostalAddress", "addressLocality": "Regensburg", "addressCountry": "DE" } },
  "organizer": { "@type": "Organization", "name": "Idiomadanza e.V.", "url": siteUrl },
  "performer": { "@type": "Person", "name": w.instructor },
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "eventStatus": "https://schema.org/EventScheduled",
  "offers": { "@type": "Offer", "url": `${siteUrl}/kontakt`, "priceCurrency": "EUR", "availability": "https://schema.org/InStock" }
}));
---

<Layout 
  title="Workshops & Intensives | Bachata & Salsa in Regensburg – Idiomadanza e.V."
  description="Bachata & Salsa Workshops in Regensburg: Intensive Trainingseinheiten, Boot Camps und Privatstunden bei Idiomadanza e.V. Jetzt Ticket sichern!"
>
  <!-- Event Schema for Agentic SEO -->
  <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": eventSchema })} />
  {/* HERO */}
  <section class="bg-brand-ink px-[clamp(20px,5vw,80px)] pb-[clamp(32px,4vw,56px)] pt-[clamp(40px,6vw,88px)]">
    <div class="mx-auto flex max-w-[1280px] flex-col gap-7">
      <p class="inline-flex items-center gap-2.5 text-sm font-semibold uppercase tracking-[0.14em] text-brand-gold">
        <Icon name="workshop" size={22} strokeWidth={1.75} />
        Next Level Tanz
      </p>
      <h1 class="font-display text-[clamp(42px,6.8vw,96px)] font-extrabold leading-[0.94] tracking-[-0.03em] text-brand-paper">
        Meistere den <span class="text-brand-gold">Vibe</span>
      </h1>
      <p class="max-w-[44ch] text-[clamp(18px,1.6vw,22px)] text-brand-paper/85">
        Unsere Workshops sind intensive Einheiten, um Technik, Ausdruck und Gefühl in Rekordzeit zu verbessern.
      </p>
    </div>
  </section>

  {/* WORKSHOPS */}
  <section class="bg-brand-ink px-[clamp(20px,5vw,80px)] pb-[clamp(56px,8vw,112px)]">
    <div class="mx-auto flex max-w-[1280px] flex-col gap-[clamp(32px,4vw,56px)]">
      <div class="grid gap-6 md:grid-cols-2">
        {workshops.map((workshop) => (
          <article class={`flex flex-col overflow-hidden rounded-3xl bg-brand-surface ${workshop.featured ? 'ring-[1.5px] ring-brand-gold' : ''}`}>
            {workshop.image && (
              <div class="relative overflow-hidden">
                <Image
                  src={workshop.image}
                  alt={`Plakat zum Workshop ${workshop.title}`}
                  width={600}
                  height={338}
                  widths={[360, 480, 600]}
                  sizes="(min-width: 768px) 46vw, 92vw"
                  format="webp"
                  loading="lazy"
                  decoding="async"
                  class="block h-auto w-full object-contain"
                />
                {workshop.featured && (
                  <span class="absolute right-4 top-4 rounded-full bg-brand-gold px-3 py-1 text-xs font-bold uppercase tracking-[0.1em] text-brand-ink">Highlight</span>
                )}
              </div>
            )}

            <div class="flex flex-grow flex-col gap-5 p-[clamp(22px,3vw,32px)]">
              <div class="flex flex-col gap-2">
                <span class="text-xs font-bold uppercase tracking-[0.14em] text-brand-gold">{workshop.date}</span>
                <h2 class="font-display text-[clamp(26px,2.6vw,34px)] font-extrabold leading-[1.05] tracking-[-0.02em] text-brand-paper">{workshop.title}</h2>
              </div>

              <ul class="flex list-none flex-col gap-3 p-0 text-[15px] text-brand-muted">
                <li class="flex items-center gap-2.5">
                  <Icon name="termin" size={18} strokeWidth={1.75} class="shrink-0 text-brand-gold" />
                  <span>{workshop.time}</span>
                </li>
                <li class="flex items-center gap-2.5">
                  <Icon name="ort" size={18} strokeWidth={1.75} class="shrink-0 text-brand-gold" />
                  <span>{workshop.location}</span>
                </li>
                <li class="flex items-center gap-2.5">
                  <span>mit <strong class="text-brand-paper">{workshop.instructor}</strong></span>
                </li>
              </ul>

              <p class="border-l-2 border-brand-gold pl-5 text-[15px] italic leading-relaxed text-brand-paper/85">
                „{workshop.description}“
              </p>

              <div class="mt-auto flex flex-wrap items-center gap-4 border-t border-brand-paper/15 pt-5">
                <span class="inline-flex items-center gap-2">
                  <span class="text-xs font-bold uppercase tracking-[0.14em] text-brand-muted">Level:</span>
                  <span class="rounded-full border border-brand-gold px-3 py-1 text-xs font-bold uppercase tracking-[0.1em] text-brand-gold">{workshop.level}</span>
                </span>
                <span class="font-display text-2xl font-extrabold tracking-[-0.02em] text-brand-paper">{workshop.price}</span>
              </div>

              <a
                href={workshop.ticketUrl || "/kontakt"}
                target={workshop.ticketUrl ? "_blank" : "_self"}
                rel={workshop.ticketUrl ? "noopener noreferrer" : ""}
                class="inline-flex min-h-[52px] w-full items-center justify-center rounded-full bg-brand-gold px-6 font-bold text-brand-ink transition-colors hover:bg-brand-gold-soft"
              >
                {workshop.buttonText || "Ticket anfragen"}
              </a>
            </div>
          </article>
        ))}
      </div>

      {/* PRIVATSTUNDEN */}
      <div class="grid items-center gap-[clamp(32px,5vw,72px)] rounded-[36px] bg-brand-surface px-[clamp(24px,4vw,56px)] py-[clamp(24px,4vw,56px)] lg:grid-cols-[0.9fr_1.1fr]">
        <Image
          src={actionImg}
          alt="Tanzpaar bei einer intensiven Trainingseinheit"
          width={1200}
          height={900}
          widths={[480, 768, 1200]}
          sizes="(min-width: 1024px) 38vw, 92vw"
          format="webp"
          loading="lazy"
          decoding="async"
          class="block aspect-[4/3] w-full rounded-[28px] object-cover"
        />
        <div class="flex flex-col gap-5">
          <h2 class="font-display text-[clamp(30px,3.6vw,48px)] font-extrabold leading-none tracking-[-0.025em] text-brand-paper">Privatstunden</h2>
          <p class="text-[19px] italic text-brand-paper/85">
            „Perfektioniere deinen Tanz in deinem eigenen Tempo. Erhalte individuelles Feedback und lerne gezielt, was dich voranbringt.“
          </p>
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-brand-gold">Einzelperson oder Paare</p>
          <a href="/kontakt/" class="inline-flex min-h-[48px] items-center gap-2.5 text-lg font-bold text-brand-gold underline underline-offset-4 decoration-brand-gold/40 hover:decoration-brand-gold">
            Preise &amp; Termine anfragen <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
