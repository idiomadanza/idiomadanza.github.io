---
interface Props {
  title: string;
  subtitle?: string;
  ctaText?: string;
  ctaHref?: string;
}

const { 
  title, 
  subtitle = "Bachata & Salsa in Regensburg", 
  ctaText = "Jetzt Schnuppern", 
  ctaHref = "/kontakt" 
} = Astro.props;
---

<section class="relative py-24 md:py-32 overflow-hidden bg-brand-dark">
  {/* Background Glow - Absolut statisch, keine Loops! */}
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full bg-brand-rose/10 blur-[120px] rounded-full"></div>

  <div class="container mx-auto px-4 relative z-10 text-center">
    <h1 class="font-display text-5xl md:text-8xl font-bold text-white mb-6 leading-tight">
      {title}
    </h1>
    <p class="max-w-2xl mx-auto text-xl text-white/80 mb-10 font-light">
      {subtitle}
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <a href={ctaHref} class="px-8 py-4 bg-brand-rose text-white font-bold rounded-full shadow-glow-rose hover:-translate-y-1 transition-all">
        {ctaText}
      </a>
    </div>
  </div>
</section>