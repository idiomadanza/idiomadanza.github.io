---
/**
 * Eigene Idiomadanza-Icons — Inline-SVG, keine Icon-Bibliothek.
 * Quelle: Design-Set von Fable (16 Icons, 24×24, stroke 1.6, runde Enden).
 *
 * Verwendung:
 *   <Icon name="termin" />
 *   <Icon name="probestunde" size={28} class="text-brand-gold" />
 *   <Icon name="ort" title="Standort" />
 *
 * Ohne `title` ist das Icon dekorativ (aria-hidden) — dann muss die
 * Bedeutung daneben im Text stehen.
 */
interface Props {
  name: string;
  size?: number;
  class?: string;
  title?: string;
  strokeWidth?: number;
}

const { name, size = 24, class: className = "", title, strokeWidth = 1.6 } = Astro.props;

const icons = {
  "schritt": `<path d="M7.500 4c1.500 0 2.500 1.400 2.500 3.500 0 1.700-.5 2.800-.8 4H6.100c-.4-1.200-1.100-2.300-1.100-4C5 5.400 6 4 7.500 4z"></path><path d="M6.200 13.500h2.900c.2 1.700-.4 3-1.500 3s-1.600-1.300-1.400-3z"></path><path d="M16.500 7.500c1.500 0 2.500 1.400 2.500 3.500 0 1.700-.7 2.800-1.100 4h-3.100c-.3-1.200-.8-2.300-.8-4 0-2.100 1-3.500 2.500-3.500z"></path><path d="M14.900 17h2.900c.2 1.700-.3 3-1.400 3s-1.700-1.300-1.500-3z"></path>`,
  "drehung": `<path d="M19.500 12a7.500 7.500 0 1 1-3-6"></path><path d="M16.800 2.600v3.700h-3.700"></path>`,
  "role-rotation": `<circle cx="6" cy="12" r="2.200"></circle><circle cx="18" cy="12" r="2.200"></circle><path d="M7.500 7.200a6.500 6.500 0 0 1 9.200 0.200"></path><path d="M16.700 4.600v2.800h-2.800"></path><path d="M16.500 16.800a6.500 6.500 0 0 1-9.200-0.200"></path><path d="M7.300 19.400v-2.800h2.800"></path>`,
  "paar": `<circle cx="8.500" cy="6.500" r="2.500"></circle><circle cx="16" cy="8" r="2.200"></circle><path d="M4 20c0-4 2-6.500 4.500-6.500 2 0 3 1.200 4 2.300 1-1.400 2.100-2.300 3.500-2.300 2.400 0 4 2.300 4 6"></path>`,
  "takt": `<circle cx="4" cy="12" r="1.700" fill="currentColor"></circle><circle cx="9.500" cy="12" r="1.700" fill="currentColor"></circle><circle cx="15" cy="12" r="1.700" fill="currentColor"></circle><circle cx="20.500" cy="12" r="2"></circle><path d="M3 18.500h18" stroke-dasharray="0.100 3.400"></path>`,
  "musik": `<path d="M9.500 17.500V6l9-2v11.500"></path><circle cx="7" cy="17.500" r="2.500"></circle><circle cx="16" cy="15.500" r="2.500"></circle>`,
  "workshop": `<path d="M12 3l1.900 5.600 5.600 1.900-5.600 1.900L12 18l-1.900-5.600-5.600-1.900 5.600-1.900z"></path><path d="M18.500 16.500v4M16.500 18.500h4"></path>`,
  "probestunde": `<path d="M4 8.500a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v1.700a1.800 1.800 0 0 0 0 3.600v1.700a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-1.700a1.800 1.800 0 0 0 0-3.600z"></path><path d="M14.500 6.500v11" stroke-dasharray="1.500 2.500"></path>`,
  "flatrate": `<path d="M12 12c-1.700-2.300-3.200-3.500-5-3.500a3.500 3.500 0 0 0 0 7c1.800 0 3.300-1.200 5-3.500zm0 0c1.700 2.300 3.200 3.500 5 3.500a3.500 3.500 0 0 0 0-7c-1.800 0-3.300 1.200-5 3.500z"></path>`,
  "gemeinnuetzig": `<path d="M12 20s-7-4.300-7-9.500A4 4 0 0 1 12 8a4 4 0 0 1 7 2.500c0 5.200-7 9.500-7 9.500z"></path>`,
  "sicher-tanzen": `<path d="M12 3l7 2.500v5.500c0 4.500-3 8-7 9.500-4-1.500-7-5-7-9.500V5.500z"></path><path d="M9 12l2.200 2.200L15.200 10"></path>`,
  "zertifikat": `<circle cx="12" cy="9.500" r="5.500"></circle><path d="M8.800 14.200L7.500 21l4.500-2.500L16.500 21l-1.300-6.800"></path><path d="M10 9.500l1.500 1.500 2.700-2.800"></path>`,
  "ort": `<path d="M12 21s6.500-5.800 6.500-11a6.500 6.500 0 0 0-13 0c0 5.200 6.500 11 6.500 11z"></path><circle cx="12" cy="10" r="2.300"></circle>`,
  "termin": `<rect x="4" y="5.500" width="16" height="14.500" rx="3"></rect><path d="M4 10h16M8.500 3.500v4M15.500 3.500v4"></path><circle cx="12" cy="14.800" r="1.300" fill="currentColor"></circle>`,
  "pass": `<path d="M4 8V6a2 2 0 0 1 2-2h2M16 4h2a2 2 0 0 1 2 2v2M20 16v2a2 2 0 0 1-2 2h-2M8 20H6a2 2 0 0 1-2-2v-2"></path><rect x="9" y="9" width="6" height="6" rx="1.200"></rect>`,
  "aushang": `<path d="M6 4.500h12A1.500 1.500 0 0 1 19.500 6v9L15 19.500H6A1.500 1.500 0 0 1 4.500 18V6A1.500 1.500 0 0 1 6 4.500z"></path><path d="M15 19.500v-3a1.500 1.500 0 0 1 1.500-1.500h3"></path><path d="M8.500 9.500h7M8.500 13h4"></path>`,
};

const inner = icons[name];
if (!inner) {
  throw new Error(`Unbekanntes Icon: ${name}`);
}
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  role={title ? "img" : undefined}
  aria-hidden={title ? undefined : "true"}
  aria-label={title}
  set:html={inner}
/>
