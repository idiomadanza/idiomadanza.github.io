---
import QRCode from 'qrcode';

interface Props {
  id: string;
  name: string;
  hash: string;
  status: 'active' | 'warning' | 'inactive';
  verifyUrl: string;
}

const { id, name, hash, status, verifyUrl } = Astro.props;

// QR-Code als Data-URL (SVG) generieren
const qrCodeSvg = await QRCode.toString(verifyUrl, {
  type: 'svg',
  errorCorrectionLevel: 'M',
  margin: 1,
  width: 140,
  color: {
    dark: '#020617', // brand-dark
    light: '#ffffff',
  },
});

// Status-spezifische Farben
const statusConfig = {
  active: { label: 'Aktiv', color: 'text-emerald-400', bg: 'bg-emerald-500/20', border: 'border-emerald-500/30' },
  warning: { label: 'Warnung', color: 'text-amber-400', bg: 'bg-amber-500/20', border: 'border-amber-500/30' },
  inactive: { label: 'Inaktiv', color: 'text-rose-400', bg: 'bg-rose-500/20', border: 'border-rose-500/30' },
};
const cfg = statusConfig[status];
---

<div class={`bg-white/5 backdrop-blur-xl p-6 rounded-2xl border ${cfg.border} shadow-glass flex flex-col items-center text-center hover:-translate-y-1 transition-all duration-300`}>
  <div class={`inline-block px-3 py-1 rounded-full ${cfg.bg} ${cfg.color} text-[10px] font-bold uppercase tracking-widest mb-4`}>
    {cfg.label}
  </div>
  <h3 class="text-lg font-display font-bold text-white mb-1">{name}</h3>
  <p class="text-xs text-white/40 font-mono mb-4 tracking-wider">{hash}</p>
  <div class="bg-white p-3 rounded-xl shadow-lg" set:html={qrCodeSvg} />
  <p class="text-[10px] text-white/30 mt-3 uppercase tracking-widest">Trainer-Scan</p>
</div>