---
/**
 * Stufe eines Kurses als Punkteskala (1–3).
 * Die Bedeutung steht im aria-label, damit die Punkte nicht selbst erklärt werden müssen.
 */
interface Props {
  level: 'Anfänger' | 'Mittelstufe' | 'Fortgeschritten';
  class?: string;
}

const { level, class: className = '' } = Astro.props;
const gefuellt = { 'Anfänger': 1, 'Mittelstufe': 2, 'Fortgeschritten': 3 }[level];
---

<svg width="34" height="12" viewBox="0 0 34 12" role="img" aria-label={level} class={`shrink-0 ${className}`}>
  <circle cx="6" cy="6" r="4.5" fill="#e6b866"></circle>
  <circle cx="17" cy="6" r="4.5" fill={gefuellt >= 2 ? '#e6b866' : 'none'} stroke={gefuellt >= 2 ? 'none' : '#e6b866'} stroke-width="1.5"></circle>
  <circle cx="28" cy="6" r="4.5" fill={gefuellt >= 3 ? '#e6b866' : 'none'} stroke={gefuellt >= 3 ? 'none' : '#e6b866'} stroke-width="1.5"></circle>
</svg>
