# Blockiert Supply-Chain Malware via Scripts
ignore-scripts=true
# Sicherheits-Audits erzwingen
audit=true
# Fund-Spam deaktivieren
fund=false
# Registry festnageln
registry=https://registry.npmjs.org/
# Exakte Versionen erzwingen, keine ^ oder ~
save-exact=true
# Nur bei High/Critical abbrechen
audit-level=high
# engines-Feld in package.json strikt durchsetzen
engine-strict=true
