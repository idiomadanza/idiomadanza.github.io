{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "time": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "instructor": {
      "type": "string"
    },
    "price": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "level": {
      "type": "string"
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "buttonText": {
      "default": "Details",
      "type": "string"
    },
    "isSoldOut": {
      "default": false,
      "type": "boolean"
    },
    "ticketUrl": {
      "type": "string",
      "format": "uri"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "date",
    "time",
    "location",
    "instructor",
    "price",
    "image"
  ]
}